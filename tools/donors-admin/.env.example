# 复制为 .env（本地开发）或在 Vercel 控制台配置（生产）
# ────────────────────────────────────────────
# 必填：访问管理页所需的 Token（前端登录用）
ADMIN_TOKEN=replace-with-a-long-random-string

# ────────────────────────────────────────────
# 以下为「GitHub 同步」配置，缺失则退回本地文件模式
# GITHUB_TOKEN：Fine-grained PAT，至少需要目标仓库的 Contents: Read & Write 权限
GITHUB_TOKEN=ghp_xxx_or_github_pat_xxx
# 目标仓库，格式 owner/repo
GITHUB_REPO=your-name/blueos-calculator
# 可选：分支（默认 main）
GITHUB_BRANCH=main
# 可选：donors.json 在仓库内的路径
GITHUB_FILE_PATH=src/assets/data/donors.json
# 可选：每次保存时的 commit 信息
COMMIT_MESSAGE=chore(donors): update donors list [skip ci]

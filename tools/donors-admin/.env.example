# 复制为 .env.local（本地开发用 vercel dev）或在 Vercel 控制台配置（生产）
# ────────────────────────────────────────────
# 必填：访问管理页所需的 Token（前端登录用）
ADMIN_TOKEN=replace-with-a-long-random-string

# ────────────────────────────────────────────
# Upstash Redis（Vercel Marketplace 集成自动注入）
#   集成地址：https://vercel.com/marketplace?category=storage&search=redis
#   集成安装后会自动注入下面 2 个环境变量
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

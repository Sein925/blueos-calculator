<template>
  <div class="number-input-wrapper">
    <div class="input-display" style="width: {{ width }}" onclick="focusInput">
      <div class="input-value">
        <marquee
          class="input-text {{ (value === '0' || value === '' || !value) && placeholder ? 'placeholder' : '' }}"
          double-ended-shadow-color="#262626">
          {{ displayValue }}
        </marquee>
      </div>
    </div>
    <div if="{{ showKeypad }}" class="keypad-overlay" onclick="closeKeypad">
      <div class="keypad-panel" onclick="stopPropagation">
        <div class="keypad-header">
          <text class="keypad-title">{{ label }}</text>
        </div>
        <div class="keypad-display">
          <marquee class="keypad-value" double-ended-shadow-color="#121212">
            {{ inputValue }}
          </marquee>
        </div>
        <div class="keypad-grid">
          <div class="keypad-btn" onclick="inputDigit('7')">
            <text>7</text>
          </div>
          <div class="keypad-btn" onclick="inputDigit('8')">
            <text>8</text>
          </div>
          <div class="keypad-btn" onclick="inputDigit('9')">
            <text>9</text>
          </div>
          <div class="keypad-btn keypad-btn-fn" onclick="toggleSign">
            <text class="iconfont" style="font-size: 34px">&#xe622;</text>
          </div>
          <div class="keypad-btn" onclick="inputDigit('4')">
            <text>4</text>
          </div>
          <div class="keypad-btn" onclick="inputDigit('5')">
            <text>5</text>
          </div>
          <div class="keypad-btn" onclick="inputDigit('6')">
            <text>6</text>
          </div>
          <div class="keypad-btn keypad-btn-fn" onclick="backspace">
            <text class="iconfont" style="font-size: 46px">&#xe62b;</text>
          </div>
          <div class="keypad-btn" onclick="inputDigit('1')">
            <text>1</text>
          </div>
          <div class="keypad-btn" onclick="inputDigit('2')">
            <text>2</text>
          </div>
          <div class="keypad-btn" onclick="inputDigit('3')">
            <text>3</text>
          </div>
          <div class="keypad-btn keypad-btn-fn" onclick="clearAll">
            <text>C</text>
          </div>
          <div class="keypad-btn" onclick="inputDigit('0')">
            <text>0</text>
          </div>
          <div class="keypad-btn {{ integerOnly === 'true' ? 'keypad-btn-disabled' : '' }}" onclick="inputDecimal">
            <text>.</text>
          </div>
          <div class="keypad-btn keypad-btn-fn {{ integerOnly === 'true' ? 'keypad-btn-disabled' : '' }}" onclick="inputFraction">
            <text>1/x</text>
          </div>
          <div class="keypad-btn keypad-btn-confirm" onclick="confirmInput">
            <text>确定</text>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
  export default {
    props: {
      value: '0',
      label: '',
      placeholder: '',
      allowFraction: true,
      integerOnly: 'false',
      width: '94%',
    },

    data: {
      showKeypad: false,
      inputValue: '0',
      hasDecimal: false,
      isNegative: false,
      hasFraction: false,
      displayValue: '0',
      lastRaw: '',
      hideDecimalFraction: false,
    },


    onInit() {
      this.hideDecimalFraction =
        this.integerOnly === true || this.integerOnly === 'true'
      this.inputValue = this.value || '0'
      this.hasDecimal = this.inputValue.indexOf('.') !== -1
      this.isNegative = this.inputValue.indexOf('-') !== -1
      this.hasFraction = this.inputValue.indexOf('/') !== -1
      this.updateDisplayValue()
    },

    updateDisplayValue() {
      if (
        (this.value === '0' || this.value === '' || !this.value) &&
        this.placeholder
      ) {
        this.displayValue = this.placeholder
      } else {
        this.displayValue = this.lastRaw || this.value
      }
    },

    focusInput() {
      global.triggerHaptic()
      this.inputValue = this.lastRaw || this.value || '0'
      this.hasDecimal = this.inputValue.indexOf('.') !== -1
      this.isNegative = this.inputValue.indexOf('-') !== -1
      this.hasFraction = this.inputValue.indexOf('/') !== -1
      this.displayValue = this.inputValue
      this.showKeypad = true
    },

    stopPropagation() {},

    inputDigit(digit) {
      global.triggerHaptic()
      if (this.inputValue === '0') {
        this.inputValue = digit
      } else {
        this.inputValue += digit
      }
    },

    inputDecimal() {
      global.triggerHaptic()
      if (this.hideDecimalFraction) return
      if (!this.hasDecimal && !this.hasFraction) {
        this.inputValue += '.'
        this.hasDecimal = true
      }
    },

    inputFraction() {
      global.triggerHaptic()
      if (this.hideDecimalFraction) return
      if (!this.hasDecimal && !this.hasFraction) {
        this.inputValue = this.inputValue === '0' ? '1/' : this.inputValue + '/'
        this.hasFraction = true
      }
    },

    toggleSign() {
      global.triggerHaptic()
      if (this.inputValue === '0') return
      if (this.isNegative) {
        this.inputValue = this.inputValue.substring(1)
        this.isNegative = false
      } else {
        this.inputValue = '-' + this.inputValue
        this.isNegative = true
      }
    },

    backspace() {
      global.triggerHaptic()
      if (this.inputValue.length === 1) {
        this.inputValue = '0'
        this.hasDecimal = false
        this.isNegative = false
        this.hasFraction = false
        return
      }
      if (this.inputValue.length === 2 && this.isNegative) {
        this.inputValue = '0'
        this.hasDecimal = false
        this.isNegative = false
        this.hasFraction = false
        return
      }
      const lastChar = this.inputValue.charAt(this.inputValue.length - 1)
      if (lastChar === '.') {
        this.hasDecimal = false
      }
      if (lastChar === '/') {
        this.hasFraction = false
      }
      this.inputValue = this.inputValue.slice(0, -1)
    },

    clearAll() {
      global.triggerHaptic()
      this.inputValue = '0'
      this.hasDecimal = false
      this.isNegative = false
      this.hasFraction = false
    },

    confirmInput() {
      global.triggerHaptic()
      var raw = this.inputValue
      while (raw.endsWith('/') || raw.endsWith('.')) {
        raw = raw.slice(0, -1)
      }
      if (raw === '') raw = '0'
      var result = { value: raw, raw: raw, isFraction: false }
      if (raw.indexOf('/') !== -1) {
        var parts = raw.split('/')
        if (parts.length === 2) {
          var n = parseFloat(parts[0])
          var d = parseFloat(parts[1])
          if (!isNaN(n) && !isNaN(d) && d !== 0) {
            result.isFraction = true
            result.num = n
            result.den = d
            result.value = String(n / d)
          }
        }
      }
      this.$emit('change', result)
      this.lastRaw = result.raw
      this.displayValue = result.raw
      this.showKeypad = false
    },
  }
</script>

<style lang="scss">
  @import './../assets/styles/style.scss';

  .number-input-wrapper {
    width: 100%;
    flex: 1;
  }

  .input-display {
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 8 * $size-factor;
    padding: 2 * $size-factor;
    display: flex;
    flex-direction: column;

    &:active {
      opacity: 0.4;
    }
  }

  .input-label {
    width: 100%;
    margin-bottom: 1 * $size-factor;
  }

  .input-label text {
    font-size: 6 * $size-factor;
    color: rgba(255, 255, 255, 0.6);
  }

  .input-value {
    width: 100%;
    display: flex;
    justify-content: flex-end;
  }

  .input-text {
    font-size: 8 * $size-factor;
    color: white;
  }

  .input-text.placeholder {
    color: rgba(255, 255, 255, 0.4);
    margin-right: 8px;
  }

  .keypad-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 1000;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .keypad-panel {
    width: 100%;
    background-color: #1a1a1a;
    border-radius: 12 * $size-factor 12 * $size-factor 0 0;
    padding: 4 * $size-factor;
    flex-direction: column;
  }

  .keypad-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 4 * $size-factor;
    margin-bottom: 2 * $size-factor;
  }

  .keypad-title {
    font-size: 8 * $size-factor;
    color: $light-gray;
  }

  .keypad-display {
    width: 100%;
    height: 72px;
    padding: 0 4 * $size-factor;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 8 * $size-factor;
    margin-bottom: 3 * $size-factor;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .keypad-value {
    font-size: 8 * $size-factor;
    color: white;
  }

  .keypad-grid {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }

  .keypad-btn {
    width: 25%;
    height: 62px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 6 * $size-factor;
    display: flex;
    align-items: center;
    justify-content: center;

    &:active {
      opacity: 0.4;
    }
  }

  .keypad-btn text {
    font-size: 8 * $size-factor;
    color: white;
  }

  .keypad-btn-fn {
    background-color: rgba(9, 186, 7, 0.2);
  }

  .keypad-btn-fn text {
    color: $brand;
  }

  .keypad-btn-confirm {
    background-color: $brand;
  }

  .keypad-btn-confirm text {
    font-size: 8 * $size-factor;
    font-weight: 600;
  }

  .keypad-btn-disabled {
    opacity: 0.3;
    pointer-events: none;
  }
</style>

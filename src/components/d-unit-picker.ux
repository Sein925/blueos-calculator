<template>
  <div if="{{ show }}" class="picker-overlay" onclick="closePicker">
    <div class="picker-panel" onclick="stopPropagation">
      <div class="picker-header">
        <text class="picker-title">{{ title }}</text>
        <text class="picker-close" onclick="closePicker">&#xe62c;</text>
      </div>
      <div class="picker-list">
        <div
          class="picker-item {{ currentUnit === item.key ? 'active' : '' }}"
          for="item in unitList"
          onclick="selectUnit({{ item.key }})">
          <text class="picker-item-text">{{ item.label }}</text>
          <text if="{{ currentUnit === item.key }}" class="picker-check">&#xe630;</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
  export default {
    props: {
      show: false,
      title: '',
      currentUnit: '',
      unitList: [],
    },

    closePicker() {
      this.$emit('close', {})
    },

    stopPropagation() {},

    selectUnit(key) {
      global.triggerHaptic()
      this.$emit('select', { key: key })
    },
  }
</script>

<style lang="scss">
  @import './../assets/styles/style.scss';

  .picker-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 1000;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .picker-panel {
    width: 100%;
    background-color: #1a1a1a;
    border-radius: 12 * $size-factor 12 * $size-factor 0 0;
    padding: 3 * $size-factor 4 * $size-factor 6 * $size-factor 4 * $size-factor;
    flex-direction: column;
  }

  .picker-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3 * $size-factor;
  }

  .picker-title {
    font-size: 8 * $size-factor;
    color: $light-gray;
  }

  .picker-close {
    font-size: 7 * $size-factor;
    color: rgba(255, 255, 255, 0.6);
    font-family: 'iconfont';
  }

  .picker-list {
    width: 100%;
    flex-direction: column;
  }

  .picker-item {
    width: 100%;
    padding: 2 * $size-factor;
    border-radius: 6 * $size-factor;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1 * $size-factor;

    &:active {
      background-color: rgba(255, 255, 255, 0.1);
    }

    &.active {
      background-color: rgba(0, 255, 153, 0.2);

      .picker-item-text {
        color: #00ff99;
      }
    }
  }

  .picker-item-text {
    font-size: 7 * $size-factor;
    color: $white;
  }

  .picker-check {
    font-size: 7 * $size-factor;
    color: #00ff99;
    font-family: 'iconfont';
  }
</style>

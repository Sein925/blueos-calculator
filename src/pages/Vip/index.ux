      margin-top: 2 * $size-factor;
    }

    .vip-card {
      width: 100%;
      background-color: rgba(255, 255, 255, 0.1);
      border-radius: 8 * $size-factor;
      padding: 4 * $size-factor 5 * $size-factor;
      margin: 2 * $size-factor 0;
      @include flex-box-mixins(column, flex-start, flex-start);
    }

    .card-header {
      width: 100%;
      @include flex-box-mixins(row, space-between, center);
      margin-bottom: 2 * $size-factor;

      .card-right {
        @include flex-box-mixins(row, flex-end, center);

        .check-mark {
          margin-left: 2 * $size-factor;

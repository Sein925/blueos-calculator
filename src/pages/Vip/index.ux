        font-size: 7 * $size-factor;
        font-weight: 600;
        color: $white;
      }

      .card-price {
        font-size: 8 * $size-factor;
        font-weight: bold;
        color: $brand;
      }

      .card-desc {
        font-size: 5 * $size-factor;
        color: $gray;
      }
    }

    .pay-btn-wrapper {
      width: 100%;
      @include flex-box-mixins(row, center, center);
      margin-top: 4 * $size-factor;
      margin-bottom: 4 * $size-factor;
    }

    .pay-btn {
      width: 100%;
      padding: 4 * $size-factor 0;

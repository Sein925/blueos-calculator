<import name="d-back" src="./../../components/d-back"></import>

<template>
  <list class="wrapper" title="true">
    <list-item>
      <d-back value="开通VIP"></d-back>
    </list-item>
    <list-item class="content">
      <div class="vip-intro">
        <text class="intro-title">解锁高级功能</text>
        <text class="intro-desc">开通VIP即可使用所有高级功能</text>
        <text if="{{ isVip }}" class="vip-expire">
          VIP到期时间：{{ expireDateText }}
        </text>
      </div>

      <div class="vip-card" onclick="selectVip(1)">
        <div class="card-header">
          <text class="card-title">月卡</text>
          <div class="card-right">
            <text class="card-price">¥1</text>
            <text if="{{ selectedVip === 1 }}" class="check-mark">✔</text>
          </div>
        </div>
        <text class="card-desc">1元/月</text>
      </div>

      <div class="vip-card" onclick="selectVip(2)">
        <div class="card-header">
          <text class="card-title">季卡</text>
          <div class="card-right">
            <text class="card-price">¥2</text>
            <text if="{{ selectedVip === 2 }}" class="check-mark">✔</text>
          </div>
        </div>
        <text class="card-desc">2元/季</text>
      </div>

      <div class="vip-card" onclick="selectVip(3)">
        <div class="card-header">
          <text class="card-title">年卡</text>
          <div class="card-right">
            <text class="card-price">¥6</text>
            <text if="{{ selectedVip === 3 }}" class="check-mark">✔</text>
          </div>
        </div>
        <text class="card-desc">6元/年</text>
      </div>

      <div class="vip-card" onclick="selectVip(4)">
        <div class="card-header">
          <text class="card-title">永久</text>
          <div class="card-right">
            <text class="card-price">¥9</text>
            <text if="{{ selectedVip === 4 }}" class="check-mark">✔</text>
          </div>
        </div>
        <text class="card-desc">9元/永久</text>
      </div>

      <div class="pay-method-wrapper">
        <text class="pay-method-title">选择支付方式</text>
        <div class="pay-method-options">
          <div
            class="pay-method-item"
            style="background-color: {{ selectedPayMethod === 'alipay' ? '#1677FF' : 'rgba(255, 255, 255, 0.1)' }}; margin-right: 16px"
            onclick="selectPayMethod('alipay')">
            <text class="pay-method-name">支付宝</text>
          </div>
          <div
            class="pay-method-item"
            style="background-color: {{ selectedPayMethod === 'wechat' ? '#07C160' : 'rgba(255, 255, 255, 0.1)' }}"
            onclick="selectPayMethod('wechat')">
            <text class="pay-method-name">微信</text>
          </div>
        </div>
      </div>

      <div class="pay-btn-wrapper">
        <div class="pay-btn" onclick="createOrder">
          <text class="pay-btn-text">
            {{ loading ? '创建订单中...' : '创建订单' }}
          </text>
        </div>
      </div>

      <div if="{{ payUrl }}" class="qrcode-wrapper">
        <text class="qrcode-title">扫描二维码支付</text>
        <div class="qrcode-container">
          <qrcode value="{{ payUrl }}" class="qrcode"></qrcode>
        </div>
        <text class="qrcode-hint">支付成功后会自动开通</text>
      </div>

      <div class="device-info">
        <text>设备ID: {{ deviceId }}</text>
      </div>
    </list-item>
  </list>
</template>

<script>
  export default {
    data: {
      selectedVip: 1,
      selectedPayMethod: 'alipay',
      deviceId: '获取中...',
      loading: false,
      payUrl: '',
      serverUrl: 'https://cal.666-114514.eu.org/',
      isVip: false,
      expireDateText: '',
    },

    onInit() {
      // 获取设备ID
      global.device.getId({
        type: ['device'],
        success: (ret) => {
          this.deviceId = ret.device || '获取失败'

          // 从KV存储加载VIP状态，没有数据时请求网络
          global.storage.get({
            key: 'vip_status',
            success: (data) => {
              if (data) {
                // KV里有数据，直接使用
                const vipData = JSON.parse(data)
                this.isVip = vipData.isVip
                this.expireDateText = vipData.expireDateText || ''
              } else if (this.deviceId !== '获取失败') {
                // KV里没有数据，从网络获取
                this.fetchFromServer()
              }
            },
            fail: () => {
              // KV加载失败，从网络获取
              if (this.deviceId !== '获取失败') {
                this.fetchFromServer()
              }
            },
          })
        },
        fail: () => {
          this.deviceId = '获取失败'
        },
      })
    },

    fetchFromServer() {
      global.fetch.fetch({
        url: this.serverUrl + 'api/vip/status/' + this.deviceId,
        method: 'GET',
        responseType: 'json',
        header: {
          'Content-Type': 'application/json',
        },
        success: (response) => {
          const ret = response.data || response
          if (ret && ret.success) {
            this.isVip = ret.is_vip
            this.expireDateText =
              ret.is_vip && ret.expire_date
                ? this.formatDate(ret.expire_date)
                : ''
            // 保存到KV存储
            global.storage.set({
              key: 'vip_status',
              value: JSON.stringify({
                isVip: this.isVip,
                expireDateText: this.expireDateText,
                updatedAt: Date.now(),
              }),
            })
          }
        },
      })
    },

    formatDate(dateStr) {
      const date = new Date(dateStr)
      const year = date.getFullYear()
      const month = String(date.getMonth() + 1).padStart(2, '0')
      const day = String(date.getDate()).padStart(2, '0')
      const hours = String(date.getHours()).padStart(2, '0')
      const minutes = String(date.getMinutes()).padStart(2, '0')
      return `${year}-${month}-${day} ${hours}:${minutes}`
    },

    selectVip(type) {
      this.selectedVip = type
      this.payUrl = ''
    },

    selectPayMethod(method) {
      this.selectedPayMethod = method
      this.payUrl = ''
    },

    getPackageType() {
      const types = {
        1: 'month',
        2: 'quarter',
        3: 'year',
        4: 'permanent',
      }
      return types[this.selectedVip]
    },

    createOrder() {
      if (this.loading) return

      this.loading = true
      this.payUrl = ''

      const packageType = this.getPackageType()

      const postData = JSON.stringify({
        device_id: this.deviceId,
        package_type: packageType,
        pay_method: this.selectedPayMethod,
      })

      global.fetch.fetch({
        url: this.serverUrl + 'api/vip/order',
        method: 'POST',
        responseType: 'json',
        header: {
          'Content-Type': 'application/json',
        },
        data: postData,
        success: (response) => {
          this.loading = false

          const ret = response.data || response

          if (ret && ret.success && ret.pay_url) {
            console.log('支付链接:', ret.pay_url)
            this.payUrl = ret.pay_url
          } else {
            console.log('订单创建失败:', ret)
          }
        },
        fail: (data, code) => {
          this.loading = false
          console.log('请求失败:', code, data)
        },
      })
    },
  }
</script>

<style lang="scss">

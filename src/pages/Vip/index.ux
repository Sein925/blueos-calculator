<import name="d-back" src="./../../components/d-back"></import>

<template>
  <list class="wrapper" title="true">
    <list-item>
      <d-back value="开通VIP"></d-back>
    </list-item>
    <list-item class="content">
      <div class="vip-intro">
        <text class="intro-title">解锁高级功能</text>
        <text class="intro-desc">开通VIP即可使用所有高级功能</text>
        <text if="{{ isVip }}" class="vip-expire">
          VIP到期时间：{{ expireDateText }}
        </text>
      </div>

      <div class="vip-card" onclick="selectVip(1)">
        <div class="card-header">
          <text class="card-title">月卡</text>
          <div class="card-right">
            <text class="card-price">¥1</text>
            <text if="{{ selectedVip === 1 }}" class="check-mark">✔</text>
          </div>
        </div>
        <text class="card-desc">30天会员</text>
      </div>

      <div class="vip-card" onclick="selectVip(2)">
        <div class="card-header">
          <text class="card-title">季卡</text>
          <div class="card-right">
            <text class="card-price">¥2</text>
            <text if="{{ selectedVip === 2 }}" class="check-mark">✔</text>
          </div>
        </div>
        <text class="card-desc">90天会员</text>
      </div>

      <div class="vip-card" onclick="selectVip(3)">
        <div class="card-header">
          <text class="card-title">年卡</text>
          <div class="card-right">
            <text class="card-price">¥6</text>
            <text if="{{ selectedVip === 3 }}" class="check-mark">✔</text>
          </div>
        </div>
        <text class="card-desc">365天会员</text>
      </div>

      <div class="vip-card" onclick="selectVip(4)">
        <div class="card-header">
          <text class="card-title">永久</text>
          <div class="card-right">
            <text class="card-price">¥9</text>
            <text if="{{ selectedVip === 4 }}" class="check-mark">✔</text>
          </div>
        </div>
        <text class="card-desc">永久会员</text>
      </div>

      <div class="pay-btn-wrapper">
        <div class="pay-btn" onclick="createQrCode">
          <text class="pay-btn-text">
            生成支付二维码
          </text>
        </div>
      </div>

      <div if="{{ payUrl }}" class="qrcode-wrapper">
        <text class="qrcode-title">使用手机扫码支付</text>
        <div class="qrcode-container">
          <qrcode value="{{ payUrl }}" class="qrcode"></qrcode>
        </div>
        <text class="qrcode-hint">支付成功后点击下方刷新</text>
      </div>

      <div class="refresh-btn-wrapper" if="{{ payUrl }}">
        <div class="refresh-btn" onclick="fetchFromServer">
          <text class="refresh-btn-text">刷新VIP状态</text>
        </div>
      </div>

      <div class="device-info">
        <text>设备ID：{{ deviceId }}</text>
      </div>
    </list-item>
  </list>
</template>

<script>
  export default {
    data: {
      selectedVip: 1,
      deviceId: '获取中',
      payUrl: '',
      serverUrl: 'https://cal.666-114514.eu.org',
      isVip: false,
      expireDateText: '',
      // 爱发电的商品链接（需要配置）
      // 示例：https://afdian.net/item/xxxxxx
      planLinks: {
        1: 'https://ifdian.net/item/71c57764449711f1b8db5254001e7c00', // 月卡链接
        2: 'https://ifdian.net/item/87d5beba449c11f1931852540025c377', // 季卡链接
        3: 'https://ifdian.net/item/a997babc449c11f1984452540025c377', // 年卡链接
        4: 'https://ifdian.net/item/d0bd3360449c11f1928c52540025c377'  // 永久链接
      },
      // 套餐配置
      planTypes: {
        1: 'month',
        2: 'quarter',
        3: 'year',
        4: 'permanent'
      }
    },

    onInit() {
      this.getDeviceId();
      this.loadVipStatus();
    },

    getDeviceId() {
      global.device.getId({
        type: ['device'],
        success: (ret) => {
          this.deviceId = ret.device || '未知设备';
          console.log('设备ID:', this.deviceId);
          this.loadVipStatus();
        },
        fail: () => {
          this.deviceId = '获取失败';
        }
      });
    },

    loadVipStatus() {
      if (!this.deviceId || this.deviceId === '获取中' || this.deviceId === '获取失败') {
        return;
      }

      global.storage.get({
        key: 'vip_status',
        success: (data) => {
          if (data) {
            const vipData = JSON.parse(data);
            this.isVip = vipData.isVip;
            this.expireDateText = vipData.expireDateText || '';
            console.log('从存储加载VIP状态:', this.isVip);
          } else {
            this.fetchFromServer();
          }
        },
        fail: () => {
          this.fetchFromServer();
        }
      });
    },

    fetchFromServer() {
      if (!this.deviceId || this.deviceId === '获取中' || this.deviceId === '获取失败') {
        console.log('没有设备ID，无法请求');
        return;
      }

      console.log('从服务器获取VIP状态');

      global.fetch.fetch({
        url: this.serverUrl + '/api/vip/status/' + this.deviceId,
        method: 'GET',
        responseType: 'json',
        header: {
          'Content-Type': 'application/json'
        },
        success: (response) => {
          const ret = response.data || response;
          console.log('服务器响应:', ret);

          if (ret && ret.success) {
            this.isVip = ret.is_vip;
            this.expireDateText = ret.is_vip && ret.expire_date ? this.formatDate(ret.expire_date) : '';

            // 保存到本地存储
            global.storage.set({
              key: 'vip_status',
              value: JSON.stringify({
                isVip: this.isVip,
                expireDateText: this.expireDateText,
                updatedAt: Date.now()
              })
            });

            console.log('VIP状态更新:', this.isVip);
          }
        },
        fail: (data, code) => {
          console.log('请求失败:', code, data);
        }
      });
    },

    formatDate(dateStr) {
      const date = new Date(dateStr);
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      const hours = String(date.getHours()).padStart(2, '0');
      const minutes = String(date.getMinutes()).padStart(2, '0');
      return `${year}-${month}-${day} ${hours}:${minutes}`;
    },

    selectVip(type) {
      this.selectedVip = type;
      this.payUrl = '';
    },

    createQrCode() {
      const baseLink = this.planLinks[this.selectedVip];

      if (baseLink) {
        // 有配置爱发电链接，使用爱发电
        const finalLink = baseLink +
          (baseLink.includes('?') ? '&' : '?') +
          'remark=device_id=' + this.deviceId +
          '&custom_order_id=' + this.deviceId;

        console.log('生成爱发电链接:', finalLink);
        this.payUrl = finalLink;
      } else {
        // 没有配置链接，使用测试方式
        console.log('使用测试方式，直接调用后端');
        this.simulatePayment();
      }
    },

    simulatePayment() {
      const postData = JSON.stringify({
        device_id: this.deviceId,
        package_type: this.planTypes[this.selectedVip]
      });

      global.fetch.fetch({
        url: this.serverUrl + '/api/vip/order',
        method: 'POST',
        responseType: 'json',
        header: {
          'Content-Type': 'application/json'
        },
        data: postData,
        success: (response) => {
          const ret = response.data || response;
          console.log('测试支付响应:', ret);

          if (ret && ret.success) {
            this.fetchFromServer();
          }
        },
        fail: (data, code) => {
          console.log('测试支付失败:', code, data);
        }
      });
    }
  };
</script>

<style lang="scss">
  @import './../../assets/styles/style.scss';

  .wrapper {
    width: 100%;
    height: 100%;
    @include flex-box-mixins(column, center, flex-start);

    .content {
      width: 100%;
      padding: 0 2 * $size-factor;
      @include flex-box-mixins(column, center, flex-start);
    }

    .vip-intro {
      width: 100%;
      @include flex-box-mixins(column, flex-start, flex-start);
      margin: 10px 0 18px 14px;
    }

    .intro-title {
      font-size: 8 * $size-factor;
      font-weight: 600;
      color: $white;
      margin-bottom: 2 * $size-factor;
    }

    .intro-desc {
      font-size: 5 * $size-factor;
      color: $gray;
    }

    .vip-expire {
      font-size: 5 * $size-factor;
      color: $brand;
      margin-top: 2 * $size-factor;
    }

    .vip-card {
      width: 100%;
      background-color: rgba(255, 255, 255, 0.1);
      border-radius: 8 * $size-factor;
      padding: 4 * $size-factor 5 * $size-factor;
      margin: 2 * $size-factor 0;
      @include flex-box-mixins(column, flex-start, flex-start);
    }

    .card-header {
      width: 100%;
      @include flex-box-mixins(row, space-between, center);
      margin-bottom: 2 * $size-factor;

      .card-right {
        @include flex-box-mixins(row, flex-end, center);

        .check-mark {
          margin-left: 2 * $size-factor;
          width: 8 * $size-factor;
          height: 8 * $size-factor;
          background-color: $brand;
          border-radius: 10px;
          text-align: center;
          font-size: 5 * $size-factor;
          font-weight: bold;
        }
      }
    }

    .card-title {
      font-size: 7 * $size-factor;
      font-weight: 600;
      color: $white;
    }

    .card-price {
      font-size: 8 * $size-factor;
      font-weight: bold;
      color: $brand;
    }

    .card-desc {
      font-size: 5 * $size-factor;
      color: $gray;
    }
  }

  .pay-btn-wrapper {
    width: 100%;
    @include flex-box-mixins(row, center, center);
    margin-top: 4 * $size-factor;
    margin-bottom: 2 * $size-factor;
  }

  .pay-btn {
    width: 100%;
    padding: 4 * $size-factor 0;
    background-color: $brand;
    border-radius: 8 * $size-factor;
    @include flex-box-mixins(row, center, center);
  }

  .pay-btn-text {
    font-size: 7 * $size-factor;
    font-weight: 600;
    color: $white;
  }

  .qrcode-wrapper {
    width: 100%;
    @include flex-box-mixins(column, center, center);
    margin-top: 2 * $size-factor;
    padding: 4 * $size-factor;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 8 * $size-factor;

    .qrcode-title {
      font-size: 6 * $size-factor;
      font-weight: 600;
      color: $white;
      margin-bottom: 4 * $size-factor;
    }

    .qrcode-container {
      width: 310px;
      height: 310px;
      background-color: $white;
      border-radius: 6 * $size-factor;
      @include flex-box-mixins(row, center, center);

      .qrcode {
        width: 290px;
        height: 290px;
      }
    }

    .qrcode-hint {
      font-size: 5 * $size-factor;
      color: $gray;
      margin-top: 4 * $size-factor;
      text-align: center;
    }
  }

  .refresh-btn-wrapper {
    width: 100%;
    @include flex-box-mixins(row, center, center);
    margin-top: 3 * $size-factor;
    margin-bottom: 4 * $size-factor;
  }

  .refresh-btn {
    width: 100%;
    padding: 4 * $size-factor 0;
    background-color: rgba(7, 193, 96, 0.8);
    border-radius: 8 * $size-factor;
    @include flex-box-mixins(row, center, center);
  }

  .refresh-btn-text {
    font-size: 7 * $size-factor;
    font-weight: 600;
    color: $white;
  }

  .device-info {
    width: 100%;
    @include flex-box-mixins(column, center, center);
    padding: 3 * $size-factor 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);

    text {
      font-size: 5 * $size-factor;

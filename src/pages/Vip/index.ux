<import name="d-back" src="./../../components/d-back"></import>

<template>
  <list class="wrapper" title="true">
    <list-item>
      <d-back value="开通VIP"></d-back>
    </list-item>
    <list-item class="content">
      <div class="vip-intro">
        <text class="intro-title">解锁高级功能</text>
        <text class="intro-desc">开通VIP即可使用所有高级功能</text>
      </div>
      
      <div class="vip-card" onclick="selectVip(1)">
        <div class="card-header">
          <text class="card-title">月卡</text>
          <div class="card-right">
            <text class="card-price">¥1</text>
            <text if="{{ selectedVip === 1 }}" class="check-mark">✔</text>
          </div>
        </div>
        <text class="card-desc">1元/月</text>
      </div>

      <div class="vip-card" onclick="selectVip(2)">
        <div class="card-header">
          <text class="card-title">季卡</text>
          <div class="card-right">
            <text class="card-price">¥2</text>
            <text if="{{ selectedVip === 2 }}" class="check-mark">✔</text>
          </div>
        </div>
        <text class="card-desc">2元/季</text>
      </div>

      <div class="vip-card" onclick="selectVip(3)">
        <div class="card-header">
          <text class="card-title">年卡</text>
          <div class="card-right">
            <text class="card-price">¥6</text>
            <text if="{{ selectedVip === 3 }}" class="check-mark">✔</text>
          </div>
        </div>
        <text class="card-desc">6元/年</text>
      </div>

      <div class="vip-card" onclick="selectVip(4)">
        <div class="card-header">
          <text class="card-title">永久</text>
          <div class="card-right">
            <text class="card-price">¥9</text>
            <text if="{{ selectedVip === 4 }}" class="check-mark">✔</text>
          </div>
        </div>
        <text class="card-desc">9元/永久</text>
      </div>

      <div class="pay-btn-wrapper">
        <div class="pay-btn" onclick="createOrder">
          <text class="pay-btn-text">{{ loading ? '创建订单中...' : '创建订单' }}</text>
        </div>
      </div>

      <div if="{{ payUrl }}" class="qrcode-wrapper">
        <text class="qrcode-title">扫描二维码支付</text>
        <div class="qrcode-container">
          <qrcode value="{{ payUrl }}" class="qrcode" type="png"></qrcode>
        </div>
        <text class="qrcode-hint">支付成功后会自动开通</text>
      </div>

      <div class="device-info">
        <text>设备ID: {{ deviceId }}</text>
      </div>
    </list-item>
  </list>
</template>

<script>
  export default {
    data: {
      selectedVip: 1,
      deviceId: '获取中...',
      loading: false,
      payUrl: '',
      serverUrl: 'https://cal.666-114514.eu.org/'
    },

    onInit() {
      this.getDeviceId()
    },

    getDeviceId() {
      global.device.getId({
        type: ['device'],
        success: (ret) => {
          this.deviceId = ret.device || '获取失败'
        },
        fail: () => {
          this.deviceId = '获取失败'
        }
      })
    },

    selectVip(type) {
      this.selectedVip = type
      this.payUrl = ''
    },

    getPackageType() {
      const types = {
        1: 'month',
        2: 'quarter',
        3: 'year',
        4: 'permanent'
      }
      return types[this.selectedVip]
    },

    createOrder() {
      if (this.loading) return
      
      this.loading = true
      this.payUrl = ''
      
      const packageType = this.getPackageType()
      
      const postData = JSON.stringify({
        device_id: this.deviceId,
        package_type: packageType
      })
      
      global.fetch.fetch({
        url: this.serverUrl + 'api/vip/order',
        method: 'POST',
        responseType: 'json',
        header: {
          'Content-Type': 'application/json'
        },
        data: postData,
        success: (response) => {
          this.loading = false
          
          const ret = response.data || response
          
          if (ret && ret.success && ret.pay_url) {
            console.log('支付链接:', ret.pay_url)
            this.payUrl = ret.pay_url
          } else {
            console.log('订单创建失败:', ret)
          }
        },
        fail: (data, code) => {
          this.loading = false
          console.log('请求失败:', code, data)
        }
      })
    }
  }
</script>


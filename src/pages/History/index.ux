<import name="d-back" src="./../../components/d-back"></import>

<template>
  <list class="wrapper" title="true">
    <list-item>
      <d-back value="{{ $t('history.title') }}"></d-back>
    </list-item>
    <list-item class="content">
      <div type="about">
        <div class="history-content">
          <text class="page-title">{{ $t('history.title') }}</text>
          <text class="page-desc">{{ $t('history.desc') }}</text>
        </div>
      </div>
      <div type="card">
        <div class="option-card" style="margin-bottom: 0" @click="clearHistory">
          <text class="card-label">{{ $t('history.clear') }}</text>
        </div>
      </div>
      <div for="item in historyList" type="card">
        <div class="history-card" style="margin-top: 18px" onclick="continueCalculate(item)">
          <text class="history-expression">{{ item.expression }}</text>
          <text class="history-result">= {{ item.result }}</text>
        </div>
      </div>
      <div style="height: 26px" show="{{ historyList.length !== 0 }}"></div>
      <div>
        <div class="empty-hint" show="{{ historyList.length === 0 }}">
          <text class="app-desc">{{ $t('history.empty') }}</text>
        </div>
      </div>
    </list-item>
  </list>
</template>

<script>
  export default {
    data: {
      historyList: [],
    },

    onInit() {
      this.loadHistory()
    },

    onShow() {
      this.loadHistory()
    },

    loadHistory() {
      this.historyList = (global.calculatorHistory || []).slice()
    },

    clearHistory() {
      global.calculatorHistory = []
      global.saveHistory()
      this.historyList = []
    },

    continueCalculate(item) {
      global.pendingHistoryItem = item
      global.router.back()
    },
  }
</script>


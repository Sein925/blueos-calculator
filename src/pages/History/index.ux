<import name="d-back" src="./../../components/d-back"></import>

<template>
  <div class="wrapper">
    <d-back value="历史记录"></d-back>
    <list class="content">
      <list-item type="about">
        <div class="history-content">
          <text class="page-title">历史记录</text>
          <text class="page-desc">最近20条计算记录</text>
        </div>
      </list-item>
      <list-item type="card">
        <div class="option-card" style="margin-bottom: 0" @click="clearHistory">
          <text class="card-label">清除历史</text>
        </div>
      </list-item>
      <list-item for="item in historyList" type="card">
        <div class="history-card" style="margin-top: 18px">
          <text class="history-expression">{{ item.expression }}</text>
          <text class="history-result">= {{ item.result }}</text>
        </div>
      </list-item>
      <list-item>
        <div class="empty-hint" show="{{ historyList.length === 0 }}">
          <text class="app-desc">暂无历史记录</text>
        </div>
      </list-item>
    </list>
  </div>
</template>

<script>
  export default {
    data: {
      historyList: []
    },

    onInit() {
      this.historyList = global.calculatorHistory || []
    },

    onShow() {
      this.historyList = global.calculatorHistory || []
    },

    clearHistory() {
      global.calculatorHistory = []
      this.historyList = []
    }
  }
</script>


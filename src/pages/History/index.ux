    @include flex-box-mixins(column, center, flex-start);

    .content {
      width: 100%;
      padding: 0 2 * $size-factor;
      @include flex-box-mixins(column, center, flex-start);
      margin-bottom: 20px;
    }

    .history-content {
      width: 100%;
      @include flex-box-mixins(column, flex-start, center);

      .page-title {
        font-size: 9 * $size-factor;
        font-weight: bold;
        color: $white;
        margin: 2 * $size-factor;
      }

      .page-desc {
        font-size: 6 * $size-factor;
        color: $gray;
        margin-bottom: 6 * $size-factor;
      }
    }

    .app-desc {
      font-size: 6 * $size-factor;
      color: $light-gray;
    }

    .option-card {
      width: 100%;
      background-color: $card-bg;
      border-radius: 8 * $size-factor;
      padding: 24px 30px;
      @include flex-box-mixins(row, flex-start, center);

      .card-label {
        font-size: 8 * $size-factor;
        color: $white;
      }

      &:active {
        opacity: 0.4;
      }
    }

    .history-card {
      width: 100%;
      background-color: $card-bg;
      border-radius: 8 * $size-factor;
      padding: 24px 30px;
      @include flex-box-mixins(column, flex-start, flex-start);

      .history-expression {
        font-size: 6 * $size-factor;
        color: $light-gray;
      }

      .history-result {
        font-size: 9 * $size-factor;
        color: $white;
        font-weight: bold;
        margin-top: 2 * $size-factor;
      }

      &:active {
        opacity: 0.4;
      }
    }

    .empty-hint {
      width: 100%;
      @include flex-box-mixins(row, center, center);
      padding: 40px 0;
    }
  }
</style>

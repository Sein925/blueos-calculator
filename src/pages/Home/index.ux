<template>
  <div class="wrapper">
    <swiper class="swiper-container" index="0" indicator="true">
      <div class="swiper-slide calculator-panel">
        <div class="calculator-card fullscreen">
          <div class="display-card" onclick="openHistoryPage">
            <div class="scroll-display">
              <marquee class="history-display" style="margin-bottom: 4px">
                {{ history }}
              </marquee>
            </div>
            <div class="scroll-display">
              <marquee class="main-display">{{ display }}</marquee>
            </div>
          </div>

          <div class="buttons-container">
            <div class="button-row" show="{{ !showAdvanced }}">
              <div class="btn btn-function" onclick="clearAll">
                <text>C</text>
              </div>
              <div class="btn btn-function" onclick="toggleSign">
                <text class="iconfont" style="font-size: 34px">&#xe622;</text>
              </div>
              <div class="btn btn-function" onclick="backspace">
                <text class="iconfont" style="font-size: 46px">&#xe62b;</text>
              </div>
              <div class="btn btn-operator" onclick="inputOperator('/')">
                <text>÷</text>
              </div>
            </div>

            <div class="button-row" show="{{ showAdvanced }}">
              <div
                class="btn btn-scientific"
                onclick="scientificFunction('sin')">
                <text>sin</text>
              </div>
              <div
                class="btn btn-scientific"
                onclick="scientificFunction('cos')">
                <text>cos</text>
              </div>
              <div
                class="btn btn-scientific"
                onclick="scientificFunction('tan')">
                <text>tan</text>
              </div>
              <div class="btn btn-operator" onclick="inputOperator('/')">
                <text>÷</text>
              </div>
            </div>

            <div class="button-row" show="{{ !showAdvanced }}">
              <div class="btn btn-number" onclick="inputNumber('7')">
                <text>7</text>
              </div>
              <div class="btn btn-number" onclick="inputNumber('8')">
                <text>8</text>
              </div>
              <div class="btn btn-number" onclick="inputNumber('9')">
                <text>9</text>
              </div>
              <div class="btn btn-operator" onclick="inputOperator('*')">
                <text>×</text>
              </div>
            </div>

            <div class="button-row" show="{{ showAdvanced }}">
              <div
                class="btn btn-scientific"
                onclick="scientificFunction('sqrt')">
                <text>√</text>
              </div>
              <div
                class="btn btn-scientific"
                onclick="scientificFunction('square')">
                <text>x²</text>
              </div>
              <div
                class="btn btn-scientific"
                onclick="scientificFunction('cube')">
                <text>x³</text>
              </div>
              <div class="btn btn-operator" onclick="inputOperator('*')">
                <text>×</text>
              </div>
            </div>

            <div class="button-row" show="{{ !showAdvanced }}">
              <div class="btn btn-number" onclick="inputNumber('4')">
                <text>4</text>
              </div>
              <div class="btn btn-number" onclick="inputNumber('5')">
                <text>5</text>
              </div>
              <div class="btn btn-number" onclick="inputNumber('6')">
                <text>6</text>
              </div>
              <div class="btn btn-operator" onclick="inputOperator('-')">
                <text>-</text>
              </div>
            </div>

            <div class="button-row" show="{{ showAdvanced }}">
              <div
                class="btn btn-scientific"
                onclick="scientificFunction('log')">
                <text>log</text>
              </div>
              <div
                class="btn btn-scientific"
                onclick="scientificFunction('ln')">
                <text>ln</text>
              </div>
              <div class="btn btn-scientific" onclick="inputConstant('pi')">
                <text>π</text>
              </div>
              <div class="btn btn-operator" onclick="inputOperator('-')">
                <text>-</text>
              </div>
            </div>

            <div class="button-row" show="{{ !showAdvanced }}">
              <div class="btn btn-number" onclick="inputNumber('1')">
                <text>1</text>
              </div>
              <div class="btn btn-number" onclick="inputNumber('2')">
                <text>2</text>
              </div>
              <div class="btn btn-number" onclick="inputNumber('3')">
                <text>3</text>
              </div>
              <div class="btn btn-operator" onclick="inputOperator('+')">
                <text>+</text>
              </div>
            </div>

            <div class="button-row" show="{{ showAdvanced }}">
              <div class="btn btn-scientific" onclick="inputConstant('e')">
                <text>e</text>
              </div>
              <div class="btn btn-scientific" onclick="inputPercent()">
                <text>%</text>
              </div>
              <div class="btn btn-scientific" onclick="inputOperator('^')">
                <text>^</text>
              </div>
              <div class="btn btn-operator" onclick="inputOperator('+')">
                <text>+</text>
              </div>
            </div>

            <div class="button-row" show="{{ !showAdvanced }}">
              <div class="btn btn-number" onclick="inputNumber('0')">
                <text>0</text>
              </div>
              <div class="btn btn-number" onclick="inputDecimal()">
                <text>.</text>
              </div>
              <div class="btn btn-function" onclick="toggleAdvanced">
                <text>2nd</text>
              </div>
              <div class="btn btn-equals" onclick="calculate">
                <text>=</text>
              </div>
            </div>

            <div class="button-row" show="{{ showAdvanced }}">
              <div
                class="btn btn-function"
                style="flex: 3"
                onclick="toggleAdvanced">
                <text>2nd</text>
              </div>
              <div class="btn btn-equals" style="flex: 1" onclick="calculate">
                <text>=</text>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="swiper-slide advanced-panel">
        <list class="content" title="true">
          <list-item class="title">
            <text class="title-icon">&#xe629;</text>
            <text class="advanced-title">高级功能</text>
          </list-item>
          <list-item type="card" style="margin-top: 3 * $size-factor">
            <div class="feature-card" onclick="openEquationPage">
              <text class="feature-icon">&#xe66f;</text>
              <text class="feature-name">方程求解</text>
            </div>
          </list-item>
          <list-item type="card" style="margin-top: 3 * $size-factor">
            <div class="feature-card" onclick="openGraphPage">
              <text class="feature-icon">&#xe63f;</text>
              <text class="feature-name">函数绘图</text>
            </div>
          </list-item>
          <list-item type="card" style="margin-top: 3 * $size-factor">
            <div class="feature-card" onclick="openStatisticsPage">
              <text class="feature-icon">&#xe644;</text>
              <text class="feature-name">统计分析</text>
            </div>
          </list-item>
          <list-item type="card" style="margin-top: 3 * $size-factor">
            <div class="feature-card" onclick="openDateCalculator">
              <text class="feature-icon">&#xe645;</text>
              <text class="feature-name">日期计算</text>
            </div>
          </list-item>
          <list-item
            type="card"
            style="margin-top: 3 * $size-factor; margin-bottom: 80px">
            <div class="feature-card" onclick="openRandomPage">
              <text class="feature-icon">&#xe7de;</text>
              <text class="feature-name">随机数</text>
            </div>
          </list-item>
        </list>
      </div>

      <div class="swiper-slide nav-panel">
        <list class="content">
          <list-item>
            <text class="section-title">计算</text>
          </list-item>
          <list-item type="card" style="margin-top: 14px">
            <div class="nav-card" onclick="openHistoryPage">
              <text class="nav-label">历史记录</text>
            </div>
          </list-item>
          <list-item>
            <text class="section-title">其他</text>
          </list-item>
          <list-item type="card" style="margin-top: 14px">
            <div class="nav-card" onclick="openSettingsPage">
              <text class="nav-label">设置</text>
            </div>
          </list-item>
          <list-item type="card" style="margin: 14px 0 88px 0">
            <div class="nav-card" onclick="openAboutPage">
              <text class="nav-label">关于</text>
            </div>
          </list-item>
        </list>
      </div>
    </swiper>
  </div>
</template>

<script>
  const PI = 3.141592653589793
  const E = 2.718281828459045

  function isInteger(num) {
    return num === Math.floor(num)
  }

  function evaluateExpression(expr) {
    if (expr.length === 0) return 0
    if (expr.length === 1) return parseFloat(expr[0])

    let tokens = []
    for (let i = 0; i < expr.length; i++) {
      const token = expr[i]
      if (i % 2 === 0) {
        tokens.push(parseFloat(token))
      } else {
        tokens.push(token)
      }
    }

    for (let i = 1; i < tokens.length; i += 2) {
      if (tokens[i] === '^') {
        let left = tokens[i - 1]
        let right = tokens[i + 1]
        let result = Math.pow(left, right)
        tokens.splice(i - 1, 3, roundResult(result))
        i -= 2
      }
    }

    for (let i = 1; i < tokens.length; i += 2) {
      if (tokens[i] === '*' || tokens[i] === '/') {
        let left = tokens[i - 1]
        let op = tokens[i]
        let right = tokens[i + 1]
        let result
        if (op === '*') {
          result = left * right
        } else {
          if (right === 0) return 'Error'
          result = left / right
        }
        tokens.splice(i - 1, 3, roundResult(result))
        i -= 2
      }
    }

    let result = tokens[0]
    for (let i = 1; i < tokens.length; i += 2) {
      const op = tokens[i]
      const right = tokens[i + 1]
      if (op === '+') {
        result += right
      } else if (op === '-') {
        result -= right
      }
    }

    return roundResult(result)
  }

  function roundResult(num) {
    if (!isFinite(num)) return 0 / 0
    const str = num.toPrecision(12)
    return parseFloat(str)
  }

  function sin(x) {
    const rad = global.angleMode === 'deg' ? (x * PI) / 180 : x
    if (isMultipleOf(rad, PI)) return 0
    return Math.sin(rad)
  }

  function cos(x) {
    const rad = global.angleMode === 'deg' ? (x * PI) / 180 : x
    if (isMultipleOf(rad - PI / 2, PI)) return 0
    return Math.cos(rad)
  }

  function tan(x) {
    const rad = global.angleMode === 'deg' ? (x * PI) / 180 : x
    if (isMultipleOf(rad - PI / 2, PI)) return 'Error'
    return Math.tan(rad)
  }

  function isMultipleOf(value, base) {
    const remainder = Math.abs(value % base)
    return remainder < 1e-9 || Math.abs(remainder - base) < 1e-9
  }

  export default {
    data: {
      display: '0',
      history: '',
      operator: '',
      waitingForOperand: false,
      showAdvanced: false,
      error: false,
      pendingFunction: '',
      expression: [],
    },

    onInit() {},

    onShow() {
      if (global.pendingHistoryItem) {
        this.display = global.pendingHistoryItem.result
        this.expression = [global.pendingHistoryItem.result]
        this.waitingForOperand = true
        this.history = global.pendingHistoryItem.expression + ' ='
        this.error = false
        this.pendingFunction = ''
        global.pendingHistoryItem = null
      }
    },

    inputNumber(num) {
      if (this.error) {
        this.clearAll()
      }

      if (this.waitingForOperand) {
        this.display = num
        this.waitingForOperand = false
        if (this.expression.length === 1) {
          this.expression = []
          this.history = ''
        }
      } else {
        this.display = this.display === '0' ? num : this.display + num
      }
    },

    inputDecimal() {
      if (this.error) {
        this.clearAll()
      }

      if (this.waitingForOperand) {
        this.display = '0.'
        this.waitingForOperand = false
        if (this.expression.length === 1) {
          this.expression = []
          this.history = ''
        }
      } else if (this.display.indexOf('.') === -1) {
        this.display += '.'
      }
    },

    inputOperator(op) {
      if (this.error) {
        this.clearAll()
      }

      if (this.pendingFunction) {
        const funcInput = this.display
        const funcName = this.pendingFunction
        this.executePendingFunction()
        this.expression.push(op)
        this.operator = op
        this.waitingForOperand = true
        this.history = `${funcName}(${funcInput}) ${this.getOperatorSymbol(op)} `
        this.pendingFunction = ''
        return
      }

      if (this.waitingForOperand) {
        if (this.expression.length > 0) {
          const lastItem = this.expression[this.expression.length - 1]
          if (
            lastItem === '+' ||
            lastItem === '-' ||
            lastItem === '*' ||
            lastItem === '/' ||
            lastItem === '^'
          ) {
            this.expression[this.expression.length - 1] = op
          } else {
            this.expression.push(op)
          }
          this.operator = op
          this.history = this.buildHistory()
        }
        return
      }

      this.expression.push(this.display)
      this.expression.push(op)
      this.operator = op
      this.waitingForOperand = true
      this.history = this.buildHistory()
    },

    buildHistory() {
      return (
        this.expression
          .map((item) => {
            if (
              item === '+' ||
              item === '-' ||
              item === '*' ||
              item === '/' ||
              item === '^'
            ) {
              return this.getOperatorSymbol(item)
            }
            return item
          })
          .join(' ') + ' '
      )
    },

    getOperatorSymbol(op) {
      const symbols = {
        '+': '+',
        '-': '-',
        '*': '×',
        '/': '÷',
        '^': '^',
      }
      return symbols[op] || op
    },

    calculate() {
      if (this.error) {
        this.clearAll()
        return
      }

      if (this.pendingFunction) {
        this.executePendingFunction()
        return
      }

      if (this.expression.length === 0 || this.waitingForOperand) {
        return
      }

      this.expression.push(this.display)

      const exprStr = this.buildHistory().replace(/ $/, '') + ' ='
      const result = evaluateExpression(this.expression)

      if (result === 'Error' || !isFinite(result)) {
        this.display = 'Error'
        this.error = true
        this.expression = []
        this.history = ''
        return
      }

      this.history = `${exprStr}`
      this.addToHistory(exprStr.replace(' =', ''), this.formatResult(result))
      this.display = this.formatResult(result)
      this.expression = [this.formatResult(result)]
      this.waitingForOperand = true
    },

    formatResult(num) {
      if (typeof num === 'string') {
        return num
      }
      if (!isFinite(num) || Math.abs(num) > 1e15) {
        return 'Error'
      }
      if (Math.abs(num) < 1e-10) {
        return '0'
      }
      if (isInteger(num)) {
        return num.toString()
      }
      const str = num.toPrecision(12)
      return parseFloat(str).toString()
    },

    clearAll() {
      this.display = '0'
      this.history = ''
      this.operator = ''
      this.waitingForOperand = false
      this.error = false
      this.expression = []
      this.pendingFunction = ''
    },

    backspace() {
      if (this.error) return
      if (
        this.display.length === 1 ||
        (this.display.length === 2 && this.display.startsWith('-'))
      ) {
        this.display = '0'
      } else {
        this.display = this.display.slice(0, -1)
      }
    },

    toggleSign() {
      if (this.error) return
      const value = parseFloat(this.display)
      this.display = this.formatResult(-value)
    },

    toggleAdvanced() {
      this.showAdvanced = !this.showAdvanced
    },

    scientificFunction(func) {
      if (this.error) {
        this.clearAll()
      }

      if (this.pendingFunction) {
        this.executePendingFunction()
      }

      this.pendingFunction = func
      this.history = `${func}(`
      this.waitingForOperand = true
    },

    executePendingFunction() {
      if (!this.pendingFunction) return

      const value = parseFloat(this.display)
      const funcName = this.pendingFunction
      let result

      switch (funcName) {
        case 'sin':
          result = sin(value)
          break
        case 'cos':
          result = cos(value)
          break
        case 'tan':
          result = tan(value)
          break
        case 'sqrt':
          if (value < 0) {
            this.display = 'Error'
            this.error = true
            this.pendingFunction = ''
            return
          }
          result = Math.sqrt(value)
          break
        case 'square':
          result = Math.pow(value, 2)
          break
        case 'cube':
          result = Math.pow(value, 3)
          break
        case 'log':
          if (value <= 0) {
            this.display = 'Error'
            this.error = true
            this.pendingFunction = ''
            return
          }
          result = Math.log10(value)
          break
        case 'ln':
          if (value <= 0) {
            this.display = 'Error'
            this.error = true
            this.pendingFunction = ''
            return
          }
          result = Math.log(value)
          break
        default:
          this.pendingFunction = ''
          return
      }

      const formattedResult = this.formatResult(result)
      const expressionStr = `${funcName}(${value})`
      this.display = formattedResult
      this.expression = [formattedResult]
      this.waitingForOperand = true
      this.pendingFunction = ''
      this.history = `${expressionStr} =`

      if (formattedResult !== 'Error' && isFinite(result)) {
        this.addToHistory(expressionStr, formattedResult)
      }
    },

    inputConstant(constant) {
      if (this.error) {
        this.clearAll()
      }

      let value
      switch (constant) {
        case 'pi':
          value = PI
          break
        case 'e':
          value = E
          break
        default:
          return
      }

      const formattedValue = this.formatResult(value)

      if (this.pendingFunction) {
        this.executePendingFunction()
        const funcResult = this.display
        this.expression.push(funcResult)
      }

      this.display = formattedValue
      this.waitingForOperand = false
    },

    inputPercent() {
      if (this.error) return
      const value = parseFloat(this.display)
      this.display = this.formatResult(value / 100)
    },

    addToHistory(expression, result) {
      global.calculatorHistory.unshift({
        expression: expression,
        result: result,
      })
      if (global.calculatorHistory.length > 20) {
        global.calculatorHistory.pop()
      }
      global.saveHistory()
    },

    openHistoryPage() {
      global.router.push({
        uri: 'pages/History',
      })
    },

    openAboutPage() {
      global.router.push({
        uri: 'pages/About',
      })
    },

    openSettingsPage() {
      global.router.push({
        uri: 'pages/Settings',
      })
    },

    openDateCalculator() {
      global.router.push({
        uri: 'pages/Advanced/Date',
      })
    },

    openEquationPage() {
      global.router.push({
        uri: 'pages/Advanced/Equation',
      })
    },

    openGraphPage() {
      global.router.push({
        uri: 'pages/Advanced/Graph',
      })
    },

    openStatisticsPage() {
      global.router.push({
        uri: 'pages/Advanced/Statistics',
      })
    },

    openRandomPage() {
      global.router.push({
        uri: 'pages/Advanced/Random',
      })
    },
  }
</script>

<style lang="scss">
  @import './../../assets/styles/style.scss';

  .wrapper {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .swiper-container {
    width: 100%;
    height: 100%;
  }

  .swiper-slide {
    width: 100%;
    height: 100%;
    @include flex-box-mixins(column, center, flex-start);
  }

  .advanced-panel {
    .content {
      width: 100%;
      padding: 4 * $size-factor 2 * $size-factor;
    }

    .title {
      @include flex-box-mixins(column, center, center);

      .advanced-title {
        color: $light-gray;
        font-size: 45px;
        margin-top: 4 * $size-factor;

        @media (device: watch-round) {
          font-size: 40px;
        }
      }
    }

    .title-icon {
      font-size: 66px;
      color: $light-gray;
      margin: 10px 0 -20px 0;
      font-family: 'iconfont';
    }

    .feature-card {
      width: 100%;
      background-color: rgba(255, 255, 255, 0.1);
      border-radius: 8 * $size-factor;
      padding: 5 * $size-factor 6 * $size-factor;
      @include flex-box-mixins(row, flex-start, center);
      margin-top: 10px;

      &:active {
        opacity: 0.4;
      }

      .feature-icon {
        font-size: 56px;
        color: #00ff99;
        margin: -12px 12px -12px 0;
        font-family: 'iconfont';
      }

      .feature-name {
        font-size: 8 * $size-factor;
        color: $white;
      }
    }
  }

  .calculator-panel {
    .content {
      width: 100%;
      padding: 0 6 * $size-factor;
    }
  }

  .nav-panel {
    .content {
      width: 100%;
      padding: 3 * $size-factor 2 * $size-factor;
    }
  }

  .section-title {
    color: $light-gray;
    font-size: 7 * $size-factor;
    margin-top: 4 * $size-factor;
    margin-left: 4 * $size-factor;

    @media (device: watch-round) {
      width: 100%;
      margin-left: 0;
      text-align: center;
      font-size: 40px;
    }
  }

  .calculator-card {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 8 * $size-factor;
    padding: 16px 24px 18px 24px;
    @include flex-box-mixins(column, flex-start, center);

    @media (device: watch-round) {
      background-color: transparent;
      border-radius: 0;
      padding: 8px 30px 10px 30px;
    }
  }

  .display-card {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 12px;
    padding: 16px 20px;
    margin-bottom: 16px;
    @include flex-box-mixins(column, flex-start, center);

    @media (device: watch-round) {
      border-radius: 16px;
      padding: 10px 14px;
      margin-bottom: 10px;
    }
  }

  .scroll-display {
    width: 100%;
    height: 36px;

    @media (device: watch-round) {
      height: 30px;
      justify-content: center;
    }
  }

  .history-display {
    color: $gray;
    font-size: 5 * $size-factor;
    font-weight: 400;
    text-align: right;
    line-height: 36px;

    @media (device: watch-round) {
      font-size: 20px;
      line-height: 30px;
    }
  }

  .main-display {
    color: $white;
    font-size: 7 * $size-factor;
    font-weight: 600;
    text-align: right;
    line-height: 48px;

    @media (device: watch-round) {
      font-size: 30px;
      line-height: 40px;
    }
  }

  .buttons-container {
    width: 100%;
    @include flex-box-mixins(column, space-between, space-between);

    @media (device: watch-round) {
      justify-content: flex-start;
    }
  }

  .button-row {
    width: 100%;
    @include flex-box-mixins(row, space-between, center);
  }

  .btn {
    flex: 1;
    height: 72px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 8 * $size-factor;
    @include flex-box-mixins(row, center, center);

    text {
      font-size: 7 * $size-factor;
      color: $white;
    }

    &:active {
      opacity: 0.4;
    }

    @media (device: watch-round) {
      height: 60px;
      border-radius: 30px;

      text {
        font-size: 32px;
      }
    }
  }

  .btn-number {

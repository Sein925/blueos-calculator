    }
  }

  .calculator-card {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 8 * $size-factor;
    padding: 24px 30px;
    margin-top: 20px;
    @include flex-box-mixins(column, flex-start, center);
  }

  .display-card {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 6 * $size-factor;
    padding: 16px 20px;
    margin-bottom: 18px;
    @include flex-box-mixins(column, flex-start, center);
  }

  .scroll-display {
    width: 100%;

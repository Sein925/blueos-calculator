<template>
  <div class="wrapper">
    <swiper class="swiper-container" index="0" indicator="true">
      <div class="swiper-slide calculator-panel">
        <div class="calculator-card fullscreen">
          <div class="display-card" onclick="navigateTo('pages/History')">
            <div class="scroll-display">
              <marquee class="history-display" style="margin-bottom: 4px">
                {{ history }}
              </marquee>
            </div>
            <div class="scroll-display">
              <marquee class="main-display">{{ display }}</marquee>
            </div>
          </div>

          <div class="buttons-container">
            <div class="button-row" show="{{ !showAdvanced }}">
              <div class="btn btn-function" onclick="clearAll">
                <text>C</text>
              </div>
              <div class="btn btn-function" onclick="toggleSign">
                <text class="iconfont" style="font-size: 34px">&#xe622;</text>
              </div>
              <div class="btn btn-function" onclick="backspace">
                <text class="iconfont" style="font-size: 46px">&#xe62b;</text>
              </div>
              <div class="btn btn-operator" onclick="inputOperator('/')">
                <text>÷</text>
              </div>
            </div>

            <div class="button-row" show="{{ showAdvanced }}">
              <div
                class="btn btn-scientific"
                onclick="scientificFunction('sin')">
                <text>sin</text>
              </div>
              <div
                class="btn btn-scientific"
                onclick="scientificFunction('cos')">
                <text>cos</text>
              </div>
              <div
                class="btn btn-scientific"
                onclick="scientificFunction('tan')">
                <text>tan</text>
              </div>
              <div class="btn btn-operator" onclick="inputOperator('/')">
                <text>÷</text>
              </div>
            </div>

            <div class="button-row" show="{{ !showAdvanced }}">
              <div class="btn btn-number" onclick="inputNumber('7')">
                <text>7</text>
              </div>
              <div class="btn btn-number" onclick="inputNumber('8')">
                <text>8</text>
              </div>
              <div class="btn btn-number" onclick="inputNumber('9')">
                <text>9</text>
              </div>
              <div class="btn btn-operator" onclick="inputOperator('*')">
                <text>×</text>
              </div>
            </div>

            <div class="button-row" show="{{ showAdvanced }}">
              <div
                class="btn btn-scientific"
                onclick="scientificFunction('sqrt')">
                <text>√</text>
              </div>
              <div
                class="btn btn-scientific"
                onclick="scientificFunction('square')">
                <text>x²</text>
              </div>
              <div
                class="btn btn-scientific"
                onclick="scientificFunction('cube')">
                <text>x³</text>
              </div>
              <div class="btn btn-operator" onclick="inputOperator('*')">
                <text>×</text>
              </div>
            </div>

            <div class="button-row" show="{{ !showAdvanced }}">
              <div class="btn btn-number" onclick="inputNumber('4')">
                <text>4</text>
              </div>
              <div class="btn btn-number" onclick="inputNumber('5')">
                <text>5</text>
              </div>
              <div class="btn btn-number" onclick="inputNumber('6')">
                <text>6</text>
              </div>
              <div class="btn btn-operator" onclick="inputOperator('-')">
                <text>-</text>
              </div>
            </div>

            <div class="button-row" show="{{ showAdvanced }}">
              <div
                class="btn btn-scientific"
                onclick="scientificFunction('log')">
                <text>log</text>
              </div>
              <div
                class="btn btn-scientific"
                onclick="scientificFunction('ln')">
                <text>ln</text>
              </div>
              <div class="btn btn-scientific" onclick="inputConstant('pi')">
                <text>π</text>
              </div>
              <div class="btn btn-operator" onclick="inputOperator('-')">
                <text>-</text>
              </div>
            </div>

            <div class="button-row" show="{{ !showAdvanced }}">
              <div class="btn btn-number" onclick="inputNumber('1')">
                <text>1</text>
              </div>
              <div class="btn btn-number" onclick="inputNumber('2')">
                <text>2</text>
              </div>
              <div class="btn btn-number" onclick="inputNumber('3')">
                <text>3</text>
              </div>
              <div class="btn btn-operator" onclick="inputOperator('+')">
                <text>+</text>
              </div>
            </div>

            <div class="button-row" show="{{ showAdvanced }}">
              <div class="btn btn-scientific" onclick="inputConstant('e')">
                <text>e</text>
              </div>
              <div class="btn btn-scientific" onclick="inputPercent()">
                <text>%</text>
              </div>
              <div class="btn btn-scientific" onclick="inputOperator('^')">
                <text>^</text>
              </div>
              <div class="btn btn-operator" onclick="inputOperator('+')">
                <text>+</text>
              </div>
            </div>

            <div class="button-row" show="{{ !showAdvanced }}">
              <div class="btn btn-number" onclick="inputNumber('0')">
                <text>0</text>
              </div>
              <div class="btn btn-number" onclick="inputDecimal()">
                <text>.</text>
              </div>
              <div class="btn btn-function" onclick="toggleAdvanced">
                <text>2nd</text>
              </div>
              <div class="btn btn-equals" onclick="calculate">
                <text>=</text>
              </div>
            </div>

            <div class="button-row" show="{{ showAdvanced }}">
              <div
                class="btn btn-function"
                style="flex: 3"
                onclick="toggleAdvanced">
                <text>2nd</text>
              </div>
              <div class="btn btn-equals" style="flex: 1" onclick="calculate">
                <text>=</text>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="swiper-slide advanced-panel">
        <list class="content" title="true">
          <list-item class="title" style="margin-top: 20px">
            <text class="title-icon">&#xe629;</text>
            <text class="advanced-title">{{ $t('home.advanced_title') }}</text>
          </list-item>
          <list-item if="{{ hasPinnedFeatures }}">
            <text class="section-title">{{ $t('home.pinned') }}</text>
          </list-item>
          <list-item
            for="(index, item) in pinnedList"
            type="card"
            style="margin-top: 4px">
            <div class="feature-card" onclick="navigateTo(item.route)" onlongpress="showFeatureDialog(item.key)">
              <div class="feature-icon-wrapper">
                <text class="feature-icon">{{ item.icon }}</text>
              </div>
              <text class="feature-name">{{ $t('home.' + item.key) }}</text>
            </div>
          </list-item>
          <list-item if="{{ hasPinnedFeatures }}">
            <text class="section-title">{{ $t('home.all') }}</text>
          </list-item>
          <list-item
            for="(index, item) in unpinnedList"
            type="card"
            style="margin-top: 4px">
            <div class="feature-card" onclick="navigateTo(item.route)" onlongpress="showFeatureDialog(item.key)">
              <div class="feature-icon-wrapper">
                <text class="feature-icon">{{ item.icon }}</text>
              </div>
              <text class="feature-name">{{ $t('home.' + item.key) }}</text>
            </div>
          </list-item>
          <list-item if="{{ !hasPinnedFeatures }}" type="text">
            <text class="app-desc">{{ $t('home.pin_tip') }}</text>
          </list-item>
        </list>
      </div>

      <div class="swiper-slide nav-panel">
        <list class="content">
          <list-item style="margin-top: 15px">
            <text class="section-title">{{ $t('home.calculation') }}</text>
          </list-item>
          <list-item type="card" style="margin-top: 14px">
            <div class="nav-card" onclick="navigateTo('pages/History')">
              <text class="nav-label">{{ $t('home.history') }}</text>
            </div>
          </list-item>
          <list-item>
            <text class="section-title">{{ $t('home.other') }}</text>
          </list-item>
          <list-item type="card" style="margin-top: 14px">
            <div class="nav-card" onclick="navigateTo('pages/Settings')">
              <text class="nav-label">{{ $t('home.settings') }}</text>
            </div>
          </list-item>
          <list-item type="card" style="margin: 14px 0 88px 0">
            <div class="nav-card" onclick="navigateTo('pages/About')">
              <text class="nav-label">{{ $t('home.about') }}</text>
            </div>
          </list-item>
        </list>
      </div>
    </swiper>

    <div if="{{ featureDialogVisible }}" class="dialog-mask {{ featureDialogHiding ? 'mask-hide' : 'mask-show' }}" onclick="hideFeatureDialog">
      <div class="dialog-panel {{ featureDialogHiding ? 'pop-out' : 'pop-in' }}" onclick="stopDialogPropagation">
        <div class="dialog-content">
          <text class="dialog-title">{{ $t('home.' + featureDialogKey) }}</text>
          <text class="dialog-subtitle">{{ pinnedFeatures[featureDialogKey] ? $t('home.confirm_unpin') : $t('home.confirm_pin') }}</text>
        </div>
        <div class="dialog-divider"></div>
        <div class="dialog-btn-area">
          <div class="dialog-btn" onclick="hideFeatureDialog">
            <text class="dialog-cancel-text">{{ $t('home.cancel') }}</text>
          </div>
          <div class="dialog-divider-v"></div>
          <div class="dialog-btn" onclick="toggleFeaturePin">
            <text class="dialog-confirm-text">{{ $t('common.confirm') }}</text>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
  import features from './features.js'

  const PI = 3.141592653589793
  const E = 2.718281828459045

  function isInteger(num) {
    return num === Math.floor(num)
  }

  function evaluateExpression(expr) {
    if (expr.length === 0) return 0
    if (expr.length === 1) return parseFloat(expr[0])

    let tokens = []
    for (let i = 0; i < expr.length; i++) {
      const token = expr[i]
      if (i % 2 === 0) {
        tokens.push(parseFloat(token))
      } else {
        tokens.push(token)
      }
    }

    for (let i = 1; i < tokens.length; i += 2) {
      if (tokens[i] === '^') {
        let left = tokens[i - 1]
        let right = tokens[i + 1]
        let result = Math.pow(left, right)
        tokens.splice(i - 1, 3, roundResult(result))
        i -= 2
      }
    }

    for (let i = 1; i < tokens.length; i += 2) {
      if (tokens[i] === '*' || tokens[i] === '/') {
        let left = tokens[i - 1]
        let op = tokens[i]
        let right = tokens[i + 1]
        let result
        if (op === '*') {
          result = left * right
        } else {
          if (right === 0) return 'Error'
          result = left / right
        }
        tokens.splice(i - 1, 3, roundResult(result))
        i -= 2
      }
    }

    let result = tokens[0]
    for (let i = 1; i < tokens.length; i += 2) {
      const op = tokens[i]
      const right = tokens[i + 1]
      if (op === '+') {
        result += right
      } else if (op === '-') {
        result -= right
      }
    }

    return roundResult(result)
  }

  function roundResult(num) {
    if (!isFinite(num)) return 0 / 0
    const str = num.toPrecision(12)
    return parseFloat(str)
  }

  function sin(x) {
    const rad = global.angleMode === 'deg' ? (x * PI) / 180 : x
    if (isMultipleOf(rad, PI)) return 0
    return Math.sin(rad)
  }

  function cos(x) {
    const rad = global.angleMode === 'deg' ? (x * PI) / 180 : x
    if (isMultipleOf(rad - PI / 2, PI)) return 0
    return Math.cos(rad)
  }

  function tan(x) {
    const rad = global.angleMode === 'deg' ? (x * PI) / 180 : x
    if (isMultipleOf(rad - PI / 2, PI)) return 'Error'
    return Math.tan(rad)
  }

  function isMultipleOf(value, base) {
    const remainder = Math.abs(value % base)
    return remainder < 1e-9 || Math.abs(remainder - base) < 1e-9
  }

  export default {
    data: {
      display: '0',
      history: '',
      operator: '',
      waitingForOperand: false,
      showAdvanced: false,
      error: false,
      pendingFunction: '',
      expression: [],
      featureDialogVisible: false,
      featureDialogHiding: false,
      featureDialogKey: '',
      featureDialogTimer: null,
      pinnedFeatures: {},
      hasPinnedFeatures: false,
      features: features,
      pinnedList: [],
      unpinnedList: [],
    },

    onInit() {
      this.pinnedFeatures = global.pinnedFeatures || {}
      this.updatePinnedFlag()
    },

    onShow() {
      if (global.pendingHistoryItem) {
        this.display = global.pendingHistoryItem.result
        this.expression = [global.pendingHistoryItem.result]
        this.waitingForOperand = true
        this.history = global.pendingHistoryItem.expression + ' ='
        this.error = false
        this.pendingFunction = ''
        global.pendingHistoryItem = null
      }
    },

    inputNumber(num) {
      global.triggerHaptic()
      if (this.error) {
        this.clearAll()
      }

      if (this.waitingForOperand) {
        this.display = num
        this.waitingForOperand = false
        if (this.expression.length === 1) {
          this.expression = []
          this.history = ''
        }
      } else {
        this.display = this.display === '0' ? num : this.display + num
      }
    },

    inputDecimal() {
      global.triggerHaptic()
      if (this.error) {
        this.clearAll()
      }

      if (this.waitingForOperand) {
        this.display = '0.'
        this.waitingForOperand = false
        if (this.expression.length === 1) {
          this.expression = []
          this.history = ''
        }
      } else if (this.display.indexOf('.') === -1) {
        this.display += '.'
      }
    },

    inputOperator(op) {
      global.triggerHaptic()
      if (this.error) {
        this.clearAll()
      }

      if (this.pendingFunction) {
        const funcInput = this.display
        const funcName = this.pendingFunction
        this.executePendingFunction()
        this.expression.push(op)
        this.operator = op
        this.waitingForOperand = true
        this.history = `${funcName}(${funcInput}) ${this.getOperatorSymbol(op)} `
        this.pendingFunction = ''
        return
      }

      if (this.waitingForOperand) {
        if (this.expression.length > 0) {
          const lastItem = this.expression[this.expression.length - 1]
          if (
            lastItem === '+' ||
            lastItem === '-' ||
            lastItem === '*' ||
            lastItem === '/' ||
            lastItem === '^'
          ) {
            this.expression[this.expression.length - 1] = op
          } else {
            this.expression.push(op)
          }
          this.operator = op
          this.history = this.buildHistory()
        }
        return
      }

      this.expression.push(this.display)
      this.expression.push(op)
      this.operator = op
      this.waitingForOperand = true
      this.history = this.buildHistory()
    },

    buildHistory() {
      return (
        this.expression
          .map((item) => {
            if (
              item === '+' ||
              item === '-' ||
              item === '*' ||
              item === '/' ||
              item === '^'
            ) {
              return this.getOperatorSymbol(item)
            }
            return item
          })
          .join(' ') + ' '
      )
    },

    getOperatorSymbol(op) {
      const symbols = {
        '+': '+',
        '-': '-',
        '*': '×',
        '/': '÷',
        '^': '^',
      }
      return symbols[op] || op
    },

    calculate() {
      global.triggerHaptic()
      if (this.error) {
        this.clearAll()
        return
      }

      if (this.pendingFunction) {
        this.executePendingFunction()
        return
      }

      if (this.expression.length === 0 || this.waitingForOperand) {
        return
      }

      this.expression.push(this.display)

      const exprStr = this.buildHistory().replace(/ $/, '') + ' ='
      const result = evaluateExpression(this.expression)

      if (result === 'Error' || !isFinite(result)) {
        this.display = 'Error'
        this.error = true
        this.expression = []
        this.history = ''
        return
      }

      this.history = `${exprStr}`
      this.addToHistory(exprStr.replace(' =', ''), this.formatResult(result))
      this.display = this.formatResult(result)
      this.expression = [this.formatResult(result)]
      this.waitingForOperand = true
    },

    formatResult(num) {
      if (typeof num === 'string') {
        return num
      }
      if (!isFinite(num) || Math.abs(num) > 1e15) {
        return 'Error'
      }
      if (Math.abs(num) < 1e-10) {
        return '0'
      }
      if (isInteger(num)) {
        return num.toString()
      }
      const str = num.toPrecision(12)
      return parseFloat(str).toString()
    },

    clearAll() {
      global.triggerHaptic()
      this.display = '0'
      this.history = ''
      this.operator = ''
      this.waitingForOperand = false
      this.error = false
      this.expression = []
      this.pendingFunction = ''
    },

    backspace() {
      global.triggerHaptic()
      if (this.error) return
      if (
        this.display.length === 1 ||
        (this.display.length === 2 && this.display.startsWith('-'))
      ) {
        this.display = '0'
      } else {
        this.display = this.display.slice(0, -1)
      }
    },

    toggleSign() {
      global.triggerHaptic()
      if (this.error) return
      const value = parseFloat(this.display)
      this.display = this.formatResult(-value)
    },

    toggleAdvanced() {
      global.triggerHaptic()
      this.showAdvanced = !this.showAdvanced
    },

    scientificFunction(func) {
      global.triggerHaptic()
      if (this.error) {
        this.clearAll()
      }

      if (this.pendingFunction) {
        this.executePendingFunction()
      }

      this.pendingFunction = func
      this.history = `${func}(`
      this.waitingForOperand = true
    },

    executePendingFunction() {
      if (!this.pendingFunction) return

      const value = parseFloat(this.display)
      const funcName = this.pendingFunction
      let result

      switch (funcName) {
        case 'sin':
          result = sin(value)
          break
        case 'cos':
          result = cos(value)
          break
        case 'tan':
          result = tan(value)
          break
        case 'sqrt':
          if (value < 0) {
            this.display = 'Error'
            this.error = true
            this.pendingFunction = ''
            return
          }
          result = Math.sqrt(value)
          break
        case 'square':
          result = Math.pow(value, 2)
          break
        case 'cube':
          result = Math.pow(value, 3)
          break
        case 'log':
          if (value <= 0) {
            this.display = 'Error'
            this.error = true
            this.pendingFunction = ''
            return
          }
          result = Math.log10(value)
          break
        case 'ln':
          if (value <= 0) {
            this.display = 'Error'
            this.error = true
            this.pendingFunction = ''
            return
          }
          result = Math.log(value)
          break
        default:
          this.pendingFunction = ''
          return
      }

      const formattedResult = this.formatResult(result)
      const expressionStr = `${funcName}(${value})`
      this.display = formattedResult
      this.expression = [formattedResult]
      this.waitingForOperand = true
      this.pendingFunction = ''
      this.history = `${expressionStr} =`

      if (formattedResult !== 'Error' && isFinite(result)) {
        this.addToHistory(expressionStr, formattedResult)
      }
    },

    inputConstant(constant) {
      global.triggerHaptic()
      if (this.error) {
        this.clearAll()
      }

      let value
      switch (constant) {
        case 'pi':
          value = PI
          break
        case 'e':
          value = E
          break
        default:
          return
      }

      const formattedValue = this.formatResult(value)

      if (this.pendingFunction) {
        this.executePendingFunction()
        const funcResult = this.display
        this.expression.push(funcResult)
      }

      this.display = formattedValue
      this.waitingForOperand = false
    },

    inputPercent() {
      global.triggerHaptic()
      if (this.error) return
      const value = parseFloat(this.display)
      this.display = this.formatResult(value / 100)
    },

    addToHistory(expression, result) {
      global.calculatorHistory.unshift({
        expression: expression,
        result: result,
      })
      if (global.calculatorHistory.length > 20) {
        global.calculatorHistory.pop()
      }
      global.saveHistory()
    },

    navigateTo(uri) {
      global.router.push({ uri: uri })
    },

    showFeatureDialog(key) {
      global.triggerHaptic()
      this.featureDialogKey = key
      this.featureDialogHiding = false
      this.featureDialogVisible = true
    },

    hideFeatureDialog() {
      this.featureDialogHiding = true
      if (this.featureDialogTimer) clearTimeout(this.featureDialogTimer)
      this.featureDialogTimer = setTimeout(() => {
        this.featureDialogVisible = false
      }, 250)
    },

    stopDialogPropagation(e) {
      if (e && e.stopPropagation) e.stopPropagation()
    },

    toggleFeaturePin() {
      global.triggerHaptic()
      const key = this.featureDialogKey
      const pinned = Object.assign({}, this.pinnedFeatures)
      if (pinned[key]) {
        delete pinned[key]
      } else {
        pinned[key] = true
      }
      this.pinnedFeatures = pinned
      global.pinnedFeatures = pinned
      global.savePinnedFeatures()
      this.updatePinnedFlag()
      this.hideFeatureDialog()
    },

    updatePinnedFlag() {
      let hasPin = false
      const pinned = []
      const unpinned = []
      for (let i = 0; i < this.features.length; i++) {
        const f = this.features[i]
        if (this.pinnedFeatures[f.key]) {
          pinned.push(f)
          hasPin = true
        } else {
          unpinned.push(f)
        }
      }
      this.hasPinnedFeatures = hasPin
      this.pinnedList = pinned
      this.unpinnedList = unpinned
    },
  }
</script>

<style lang="scss">
  @import './../../assets/styles/style.scss';

  .wrapper {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .swiper-container {
    width: 100%;
    height: 100%;
  }

  .swiper-slide {
    width: 100%;
    height: 100%;
    @include flex-box-mixins(column, center, flex-start);
  }

  .advanced-panel {
    .content {
      width: 100%;
      padding: 0 10px 80px 10px;
    }

    .title {
      @include flex-box-mixins(column, center, center);
    }

    .title-icon {
      font-size: 64px;
      color: $success;
      font-family: 'iconfont';

      @media (device: watch-round) {
        font-size: 54px;
      }
    }

    .advanced-title {
      color: $light-gray;
      font-size: 46px;

      @media (device: watch-round) {
        font-size: 44px;
      }
    }

    .app-desc {
      font-size: 6 * $size-factor;
      margin-top: 14px;
      color: $light-gray;
      width: 100%;
      text-align: center;
    }

    .feature-card {
      width: 100%;
      background-color: $card-bg;
      border-radius: 8 * $size-factor;
      padding: 5 * $size-factor 6 * $size-factor;
      @include flex-box-mixins(row, flex-start, center);
      margin-top: 10px;

      &:active {
        opacity: 0.4;
      }

      .feature-icon-wrapper {
        width: 56px;
        height: 56px;
        background: linear-gradient(to bottom, rgba(0, 255, 153, 0.35), rgba(0, 255, 153, 0.05));
        border-radius: 10 * $size-factor;
        @include flex-box-mixins(row, center, center);
        margin-right: 3 * $size-factor;
        flex-shrink: 0;
      }

      .feature-icon {
        font-size: 42px;
        color: $success;
        font-family: 'iconfont';
      }

      .feature-name {
        font-size: 8 * $size-factor;
        color: $white;
      }
    }
  }

  .calculator-panel {
    .content {
      width: 100%;
      padding: 0 6 * $size-factor;
    }
  }

  .nav-panel {
    .content {
      width: 100%;
      padding: 0 2 * $size-factor;
    }
  }

  .section-title {
    color: $light-gray;
    font-size: 7 * $size-factor;
    margin-top: 4 * $size-factor;
    margin-left: 4 * $size-factor;

    @media (device: watch-round) {
      width: 100%;
      margin-left: 0;
      text-align: center;
      font-size: 40px;
    }
  }

  .calculator-card {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 8 * $size-factor;
    padding: 16px 24px 18px 24px;
    @include flex-box-mixins(column, flex-start, center);

    @media (device: watch-round) {
      background-color: transparent;
      border-radius: 0;
      padding: 8px 30px 10px 30px;
    }
  }

  .display-card {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 12px;
    padding: 16px 20px;
    margin-bottom: 16px;
    @include flex-box-mixins(column, flex-start, center);

    @media (device: watch-round) {
      border-radius: 16px;
      padding: 10px 14px;
      margin-bottom: 10px;
    }
  }

  .scroll-display {
    width: 100%;
    height: 36px;

    @media (device: watch-round) {
      height: 30px;
      justify-content: center;
    }
  }

  .history-display {
    color: $gray;
    font-size: 5 * $size-factor;
    font-weight: 400;
    text-align: right;
    line-height: 36px;

    @media (device: watch-round) {
      font-size: 20px;
      line-height: 30px;
    }
  }

  .main-display {
    color: $white;
    font-size: 7 * $size-factor;
    font-weight: 600;
    text-align: right;
    line-height: 48px;

    @media (device: watch-round) {
      font-size: 30px;
      line-height: 40px;
    }
  }

  .buttons-container {
    width: 100%;
    @include flex-box-mixins(column, space-between, space-between);

    @media (device: watch-round) {
      justify-content: flex-start;
    }
  }

  .button-row {
    width: 100%;
    @include flex-box-mixins(row, space-between, center);
  }

  .btn {
    flex: 1;
    height: 72px;
    background-color: $card-bg;
    border-radius: 8 * $size-factor;
    @include flex-box-mixins(row, center, center);

    text {
      font-size: 7 * $size-factor;
      color: $white;
    }

    &:active {
      opacity: 0.4;
    }

    @media (device: watch-round) {
      height: 60px;
      border-radius: 30px;

      text {
        font-size: 32px;
      }
    }
  }

  .btn-number {
    background-color: $input-bg;
  }

  .btn-operator {
    background-color: $brand;
  }

  .btn-function {
    background-color: $light-brand;

    text {
      color: $brand;
      font-weight: 600;
    }
  }

  .btn-scientific {
    background-color: rgba(25, 118, 210, 0.2);

    text {
      color: #1976d2;
      font-weight: 500;
    }
  }

  .btn-equals {
    background-color: $brand;
  }

  .nav-card {
    width: 100%;
    background-color: $card-bg;
    border-radius: 8 * $size-factor;
    padding: 24px 30px;
    @include flex-box-mixins(row, flex-start, center);

    .nav-label {
      font-size: 8 * $size-factor;
      color: $white;
    }

    &:active {
      opacity: 0.4;
    }
  }

  .dialog-mask {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: $overlay-bg;
    justify-content: center;
    align-items: center;
  }

  .dialog-panel {
    width: 340px;
    flex-direction: column;
    align-items: center;
    background-color: $panel-bg;
    border-radius: 28px;
  }

  .dialog-content {
    flex-direction: column;
    align-items: center;
    padding: 30px;
    width: 100%;
  }

  .dialog-title {
    font-size: 34px;
    color: $white;
    font-weight: bold;
    text-align: center;
  }

  .dialog-subtitle {
    font-size: 26px;
    color: $text-secondary;
    text-align: center;
    margin-top: 8px;
  }

  .dialog-divider {
    width: 100%;
    height: 2px;
    background-color: $card-bg;
  }

  .dialog-btn-area {
    width: 100%;
    height: 80px;
    flex-direction: row;
  }

  .dialog-btn {
    flex: 1;
    height: 100%;
    justify-content: center;
    align-items: center;

    &:active {
      opacity: 0.4;
    }
  }

  .dialog-divider-v {
    width: 2px;
    height: 100%;
    background-color: $card-bg;
  }

  .dialog-cancel-text {
    font-size: 32px;
    color: $text-secondary;
  }

  .dialog-confirm-text {
    font-size: 32px;
    font-weight: bold;
    color: $success;
  }

  @keyframes maskFadeIn {
    0% { background-color: rgba(0, 0, 0, 0); }
    100% { background-color: $overlay-bg; }
  }

  @keyframes maskFadeOut {
    0% { background-color: $overlay-bg; }
    100% { background-color: rgba(0, 0, 0, 0); }
  }

  @keyframes popIn {
    0% { transform: scale(0.6); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  @keyframes popOut {
    0% { transform: scale(1); opacity: 1; }
    100% { transform: scale(0.8); opacity: 0; }
  }

  .mask-show {
    animation-name: maskFadeIn;
    animation-duration: 250ms;
    animation-fill-mode: forwards;
  }

  .mask-hide {
    animation-name: maskFadeOut;
    animation-duration: 250ms;
    animation-fill-mode: forwards;
  }

  .pop-in {
    animation-name: popIn;
    animation-duration: 350ms;
    animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
    animation-fill-mode: forwards;
  }

  .pop-out {
    animation-name: popOut;
    animation-duration: 200ms;
    animation-timing-function: ease-in;
    animation-fill-mode: forwards;
  }
</style>

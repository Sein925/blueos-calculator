    line-height: 40px;
  }

  .main-display {
    color: $white;
    font-size: 7 * $size-factor;
    font-weight: bold;
    text-align: right;
    line-height: 40px;
  }

  .buttons-container {
    width: 100%;
    @include flex-box-mixins(column, flex-start, center);
    gap: 12px;
  }

  .button-row {
    width: 100%;
    @include flex-box-mixins(row, space-between, center);
    gap: 12px;
  }

  .btn {
    flex: 1;
    height: 11 * $size-factor;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 6 * $size-factor;
    @include flex-box-mixins(row, center, center);

    text {
      font-size: 5.5 * $size-factor;
      font-weight: 500;
      color: $white;
    }

    &:active {
      opacity: 0.4;
    }
  }

  .btn-number {
    background-color: rgba(255, 255, 255, 0.15);
  }

  .btn-operator {
    background-color: $brand;
  }

  .btn-function {
    background-color: rgba(9, 186, 7, 0.2);

    text {
      color: $brand;
    }
  }

  .btn-scientific {
    background-color: rgba(25, 118, 210, 0.2);

    text {
      color: #1976d2;
    }
  }

  .btn-equals {
    background-color: $brand;
  }

  .nav-card {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 8 * $size-factor;
    padding: 24px 30px;
    @include flex-box-mixins(row, flex-start, center);

    .nav-label {
      font-size: 8 * $size-factor;
      color: $white;
    }

    &:active {
      opacity: 0.4;
    }
  }
</style>

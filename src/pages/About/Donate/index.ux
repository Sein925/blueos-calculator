<import name="d-back" src="./../../../components/d-back"></import>

<template>
  <div class="wrapper">
    <swiper>
      <div class="content">
        <d-back></d-back>
        <qrcode
          value="wxp://f2f0mNO7_JkaWQ0N7E0w4IfMNgbiO64MQRasJ6jB-Gu70DOZOnhfVZ0k1v8iFjZQfkX0"
          type="circle"></qrcode>
        <text>微信打赏</text>
        <text style="color: #999; font-size: 26px; margin-top: -2px">感谢您的支持</text>
      </div>
      <div class="content">
        <d-back></d-back>
        <qrcode
          value="https://qr.alipay.com/tsx15421dkgubkqrf52i502"
          type="circle"></qrcode>
        <text>支付宝打赏</text>
        <text style="color: #999; font-size: 26px; margin-top: -2px">感谢您的支持</text>
      </div>
      <list class="content" title="true">
        <list-item>
          <d-back></d-back>
        </list-item>
        <list-item class="list-header">
          <text class="list-title">打赏名单</text>
          <text class="list-desc">感谢以下支持者</text>
        </list-item>
        <list-item for="group in donorList" style="padding: 0 10px;">
          <div class="donor-group">
            <text class="group-amount">¥{{ group.a }}</text>
            <text class="donor-names">{{ group.n.join(', ') }}</text>
          </div>
        </list-item>
        <list-item class="empty-hint" show="{{ donorList.length === 0 }}">
          <text class="empty-text">暂无打赏记录</text>
        </list-item>
        <list-item class="total-item">
          <div class="total-box">
            <text class="total-label">累计打赏</text>
            <text class="total-amount">¥{{ getTotalAmount() }}</text>
            <text class="total-count">共 {{ getTotalCount() }} 位支持者</text>
          </div>
        </list-item>
      </list>
    </swiper>
  </div>
</template>

<script>
  import donorData from './../../../assets/data/donors.json'

  export default {
    data: {
      donorList: donorData,
    },

    getTotalAmount() {
      let amount = 0
      for (let i = 0; i < this.donorList.length; i++) {
        const item = this.donorList[i]
        const a = parseFloat(item.a) || 0
        const c = (item.n && item.n.length) || 0
        amount += a * c
      }
      const cents = Math.round(amount * 100)
      const integerPart = Math.floor(cents / 100)
      const decimalPart = cents % 100
      return integerPart + '.' + (decimalPart < 10 ? '0' + decimalPart : decimalPart)
    },

    getTotalCount() {
      let count = 0
      for (let i = 0; i < this.donorList.length; i++) {
        const names = this.donorList[i].n
        count += (names && names.length) || 0
      }
      return count
    },
  }
</script>


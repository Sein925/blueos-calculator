<import name="d-back" src="./../../../components/d-back"></import>

<template>
  <div class="wrapper">
    <swiper>
      <div class="content">
        <d-back></d-back>
        <qrcode
          value="wxp://f2f0mNO7_JkaWQ0N7E0w4IfMNgbiO64MQRasJ6jB-Gu70DOZOnhfVZ0k1v8iFjZQfkX0"
          type="circle"></qrcode>
        <text>微信打赏</text>
        <text style="color: #999; font-size: 26px; margin-top: -2px">感谢您的支持</text>
      </div>
      <div class="content">
        <d-back></d-back>
        <qrcode
          value="https://qr.alipay.com/tsx15421dkgubkqrf52i502"
          type="circle"></qrcode>
        <text>支付宝打赏</text>
        <text style="color: #999; font-size: 26px; margin-top: -2px">感谢您的支持</text>
      </div>
      <list class="content" title="true">
        <list-item>
          <d-back></d-back>
        </list-item>
        <list-item class="list-header">
          <text class="list-title">打赏名单</text>
          <text class="list-desc">感谢以下支持者</text>
          <div class="refresh-bar" onclick="fetchDonors">
            <text class="refresh-btn">
              {{ isLoading ? '刷新中…' : '刷新数据' }}
            </text>
          </div>
        </list-item>
        <list-item for="group in donorList" style="padding: 0 10px">
          <div class="donor-group">
            <text class="group-amount">¥{{ group.a }}</text>
            <text class="donor-names">{{ group.n.join(', ') }}</text>
          </div>
        </list-item>
        <list-item class="small-item" show="{{ smallNames.length > 0 }}">
          <div class="donor-group small-group">
            <text class="group-amount small-amount">小额支持</text>
            <text class="donor-names small-names">{{ smallNames.join(', ') }}</text>
          </div>
        </list-item>
        <list-item class="empty-hint" show="{{ donorList.length === 0 && smallNames.length === 0 }}">
          <text class="empty-text">暂无打赏记录</text>
        </list-item>
        <list-item class="total-item" show="{{ donorList.length > 0 || smallNames.length > 0 }}">
          <div class="total-box">
            <text class="total-label">累计打赏</text>
            <text class="total-amount">¥{{ totalAmount }}</text>
            <text class="total-count">共 {{ totalCount }} 位支持者</text>
          </div>
          <text class="update-time">{{ updateTime }}</text>
        </list-item>
      </list>
    </swiper>
  </div>
</template>

<script>
  import fetch from '@system.fetch'
  const API_BASE = 'donors.666-114514.eu.org'

  const STORAGE_KEY = 'donors_cache_v1'

  export default {
    data: {
      donorList: [],
      smallNames: [],
      totalAmount: '0.00',
      totalCount: 0,
      updateTime: '点击刷新获取最新',
      isLoading: false,
    },

    onInit() {
      this.loadFromLocal()
    },

    loadFromLocal() {
      const self = this
      try {
        global.storage.get({
          key: STORAGE_KEY,
          success: function (data) {
            if (data) {
              try {
                const parsed = JSON.parse(data)
                if (parsed && Array.isArray(parsed.data)) {
                  self.donorList = parsed.data
                }
                self.smallNames = Array.isArray(parsed.smallNames) ? parsed.smallNames : []
                self.totalAmount = parsed.totalAmount || '0.00'
                self.totalCount =
                  typeof parsed.totalCount === 'number' ? parsed.totalCount : 0
                self.updateTime = parsed.updateTime || '本地缓存（未联网）'
              } catch (e) {}
            }
          },
          fail: function () {},
        })
      } catch (e) {}
    },

    saveToLocal() {
      const self = this
      try {
        const cache = JSON.stringify({
          data: self.donorList,
          smallNames: self.smallNames,
          totalAmount: self.totalAmount,
          totalCount: self.totalCount,
          updateTime: self.updateTime,
        })
        global.storage.set({
          key: STORAGE_KEY,
          value: cache,
          success: function () {},
          fail: function () {},
        })
      } catch (e) {}
    },

    fetchDonors() {
      const self = this
      if (self.isLoading) return
      self.isLoading = true
      self.updateTime = '正在刷新...'

      fetch.fetch({
        url: 'https://' + API_BASE + '/api/donors',
        method: 'GET',
        responseType: 'json',
        header: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        timeout: 15000,
        success: function (response) {
          self.isLoading = false

          let rawBody = null
          let json = null
          let debugKeys = ''

          if (response !== undefined && response !== null) {
            if (typeof response === 'object') {
              const keys = []
              const vals = {}
              for (const k in response) {
                keys.push(k)
                vals[k] = response[k]
              }
              debugKeys = keys.join(',')

              if (vals.data !== undefined && vals.data !== null) {
                rawBody = vals.data
              } else if (vals.text !== undefined && vals.text !== null) {
                rawBody = vals.text
              } else if (vals.body !== undefined && vals.body !== null) {
                rawBody = vals.body
              } else if (vals.content !== undefined && vals.content !== null) {
                rawBody = vals.content
              }

              if (
                rawBody === null &&
                keys.length === 2 &&
                keys.indexOf('code') >= 0
              ) {
                rawBody = null
              } else if (rawBody === null) {
                rawBody = response
              }
            } else {
              rawBody = response
            }
          }

          if (rawBody === null) {
            self.updateTime = '解析失败：仅 keys=' + debugKeys
            return
          }

          try {
            if (typeof rawBody === 'string') {
              json = JSON.parse(rawBody)
            } else if (typeof rawBody === 'object') {
              json = rawBody
            } else {
              self.updateTime = '解析失败：body 类型=' + typeof rawBody
              return
            }
          } catch (e) {
            self.updateTime = '解析失败：' + e
            return
          }

          if (!json || json.ok !== true) {
            self.updateTime =
              '刷新失败：' +
              (json && json.message ? json.message : '返回 ok=false')
            return
          }

          if (!Array.isArray(json.data)) {
            self.updateTime = '刷新失败：data 字段不是数组'
            return
          }

          self.donorList = json.data
          self.smallNames = Array.isArray(json.smallNames) ? json.smallNames : []

          // 优先使用后端返回的 totalAmount / totalCount，避免前端计算遗漏
          if (
            json.meta &&
            (typeof json.meta.totalAmount === 'string' ||
              typeof json.meta.totalAmount === 'number') &&
            typeof json.meta.totalCount === 'number'
          ) {
            self.totalAmount = String(json.meta.totalAmount)
            self.totalCount = json.meta.totalCount
          } else {
            self.totalAmount = self.getTotalAmount()
            self.totalCount = self.getTotalCount() + self.smallNames.length
          }

          if (json.meta && json.meta.updatedAt) {
            self.updateTime =
              '数据更新于 ' + self.formatTime(json.meta.updatedAt)
          } else {
            self.updateTime =
              '已更新 ' + self.formatTime(new Date().toISOString())
          }
          self.saveToLocal()
        },
        fail: function (data) {
          self.isLoading = false
          let msg = '网络错误'
          if (typeof data === 'object') {
            if (data.code) msg = msg + '（' + data.code + '）'
            else if (data.errMsg) msg = msg + '：' + data.errMsg
          } else if (typeof data === 'string') {
            msg = msg + '：' + data
          }
          self.updateTime = msg
        },
        complete: function () {
          self.isLoading = false
        },
      })
    },

    formatTime(iso) {
      try {
        const d = new Date(iso)
        const pad = (n) => (n < 10 ? '0' + n : '' + n)
        return (
          d.getFullYear() +
          '-' +
          pad(d.getMonth() + 1) +
          '-' +
          pad(d.getDate()) +
          ' ' +
          pad(d.getHours()) +
          ':' +
          pad(d.getMinutes())
        )
      } catch (e) {
        return iso
      }
    },

    getTotalAmount() {
      // 总金额 = 当前列表的累计
      const data = this.donorList
      let amount = 0
      for (let i = 0; i < data.length; i++) {
        const item = data[i]
        const a = parseFloat(item.a) || 0
        const c = (item.n && item.n.length) || 0
        amount += a * c
      }
      const cents = Math.round(amount * 100)
      const integerPart = Math.floor(cents / 100)
      const decimalPart = cents % 100
      return (
        integerPart + '.' + (decimalPart < 10 ? '0' + decimalPart : decimalPart)
      )
    },

    getTotalCount() {
      const data = this.donorList
      let count = 0
      for (let i = 0; i < data.length; i++) {
        const names = data[i].n
        count += (names && names.length) || 0
      }
      return count
    },
  }
</script>

<style lang="scss">
  @import './../../../assets/styles/style.scss';

  .wrapper {
    flex-direction: column;

    .content {
      flex-direction: column;
      align-items: center;

      qrcode {
        width: 335px;
        height: 335px;
        margin-top: 10px;
      }

      text {
        color: #fff;
        font-size: 36px;
        margin-top: 8px;
      }

      .list-header {
        width: 100%;
        flex-direction: column;
        align-items: center;
        margin-bottom: 30px;

        .list-title {
          font-size: 9 * $size-factor;
          font-weight: bold;
          color: $white;
          margin: 2 * $size-factor;
        }

        .list-desc {
          font-size: 6 * $size-factor;
          color: $gray;
        }

        .refresh-bar {
          width: 100%;
          margin-top: 16px;
          flex-direction: column;
          align-items: center;

          &:active {
            opacity: 0.4;
          }
        }

        .refresh-btn {
          padding: 12px 34px;
          background-color: $brand;
          color: $white;
          font-size: 7 * $size-factor;
          font-weight: bold;
          border-radius: 7 * $size-factor;
        }
      }

      .donor-group {
        width: 100%;
        background-color: #1a1a1a;
        border-radius: 8 * $size-factor;
        padding: 24px 30px;
        margin-bottom: 18px;
        flex-direction: column;
        align-items: flex-start;

        .group-amount {
          font-size: 10 * $size-factor;
          color: $brand;
          font-weight: bold;
          margin-bottom: 6px;
        }

        .donor-names {
          width: 100%;
          font-size: 6 * $size-factor;
          color: $white;
          font-weight: 500;
          margin-bottom: 14px;
        }
      }

      .small-item .small-group {
        background-color: #202020;
      }

      .small-item .small-amount {
        font-size: 8 * $size-factor;
        color: #ffcc66;
      }

      .small-item .small-names {
        font-size: 5.2 * $size-factor;
        color: #d8d8d8;
      }

      .empty-hint {
        width: 100%;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        padding: 40px 0;

        .empty-text {
          font-size: 6 * $size-factor;
          color: $light-gray;
        }
      }

      .total-item {
        width: 100%;
        padding: 10px 10px 30px;
        flex-direction: column;

        .update-time {
          color: $light-gray;
          margin-top: 20px;
          margin-bottom: 20px;
          font-size: 4.4 * $size-factor;
          text-align: center;
        }

        .total-box {
          width: 100%;
          background-color: #1a1a1a;
          border-radius: 8 * $size-factor;
          padding: 28px 30px;
          @include flex-box-mixins(column, center, center);

          .total-label {
            font-size: 6 * $size-factor;
            color: $gray;
            margin-bottom: 6px;
          }

          .total-amount {
            font-size: 14 * $size-factor;
            color: $brand;
            font-weight: bold;
            margin-bottom: 6px;
          }

          .total-count {
            font-size: 5 * $size-factor;
            color: $light-gray;
          }
        }
      }
    }
  }
</style>

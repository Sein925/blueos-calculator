<import name="d-back" src="./../../../components/d-back"></import>

<template>
  <div class="wrapper">
    <swiper>
      <div class="content">
        <d-back></d-back>
        <qrcode
          value="wxp://f2f0mNO7_JkaWQ0N7E0w4IfMNgbiO64MQRasJ6jB-Gu70DOZOnhfVZ0k1v8iFjZQfkX0"
          type="circle"></qrcode>
        <text>{{ $t('donate.wechat') }}</text>
        <text style="color: #999; font-size: 26px; margin-top: -2px">{{ $t('donate.thanks') }}</text>
      </div>
      <div class="content">
        <d-back></d-back>
        <qrcode
          value="https://qr.alipay.com/tsx15421dkgubkqrf52i502"
          type="circle"></qrcode>
        <text>{{ $t('donate.alipay') }}</text>
        <text style="color: #999; font-size: 26px; margin-top: -2px">{{ $t('donate.thanks') }}</text>
      </div>
      <list class="content" title="true">
        <list-item>
          <d-back></d-back>
        </list-item>
        <list-item class="list-header">
          <text class="list-title">{{ $t('donate.list_title') }}</text>
          <text class="list-desc">{{ $t('donate.list_desc') }}</text>
          <div class="refresh-bar" @click="fetchDonors">
            <text class="refresh-btn">
              {{ isLoading ? $t('donate.refreshing') : $t('donate.refresh') }}
            </text>
          </div>
        </list-item>
        <list-item class="error-box" show="{{ errInfo.length > 0 }}" style="padding: 0 10px">
          <div class="error-inner">
            <text class="error-title">{{ $t('donate.error') }}</text>
            <text class="error-text">{{ errInfo }}</text>
          </div>
        </list-item>
        <list-item for="group in donorList" style="padding: 0 10px">
          <div class="donor-group">
            <text class="group-amount">¥{{ group.a }}</text>
            <text class="donor-names">{{ group.n.join(', ') }}</text>
          </div>
        </list-item>
        <list-item class="small-item" show="{{ smallNames.length > 0 }}" style="padding: 0 10px">
          <div class="donor-group small-group">
            <text class="group-amount small-amount">{{ $t('donate.small') }}</text>
            <text class="donor-names small-names">{{ smallNames.join(', ') }}</text>
          </div>
        </list-item>
        <list-item class="empty-hint" show="{{ donorList.length === 0 && smallNames.length === 0 }}">
          <text class="empty-text">{{ $t('donate.empty') }}</text>
        </list-item>
        <list-item class="total-item" show="{{ donorList.length > 0 || smallNames.length > 0 }}">
          <div class="total-box">
            <text class="total-label">{{ $t('donate.total') }}</text>
            <text class="total-amount">¥{{ totalAmount }}</text>
            <text class="total-count">{{ $t('donate.supporters', {count: totalCount}) }}</text>
          </div>
          <text class="update-time">{{ updateTime }}</text>
        </list-item>
      </list>
    </swiper>
  </div>
</template>

<script>
  const API_BASE = 'donors.666-114514.eu.org'

  const STORAGE_KEY = 'donors_cache_v1'

  export default {
    data: {
      donorList: [],
      smallNames: [],
      totalAmount: '0.00',
      totalCount: 0,
      updateTime: '点击刷新获取最新',
      isLoading: false,
      errInfo: '',
    },

    onInit() {
      this.loadFromLocal()
    },

    loadFromLocal() {
      const self = this
      try {
        global.storage.get({
          key: STORAGE_KEY,
          success: function (data) {
            if (data) {
              try {
                const parsed = JSON.parse(data)
                if (parsed && Array.isArray(parsed.data)) {
                  self.donorList = parsed.data
                }
                self.smallNames = Array.isArray(parsed.smallNames) ? parsed.smallNames : []
                self.totalAmount = parsed.totalAmount || '0.00'
                self.totalCount =
                  typeof parsed.totalCount === 'number' ? parsed.totalCount : 0
                self.updateTime = parsed.updateTime || self.$t('donate.cache')
              } catch (e) {}
            }
          },
          fail: function () {},
        })
      } catch (e) {}
    },

    saveToLocal() {
      const self = this
      try {
        const cache = JSON.stringify({
          data: self.donorList,
          smallNames: self.smallNames,
          totalAmount: self.totalAmount,
          totalCount: self.totalCount,
          updateTime: self.updateTime,
        })
        global.storage.set({
          key: STORAGE_KEY,
          value: cache,
          success: function () {},
          fail: function () {},
        })
      } catch (e) {}
    },

    fetchDonors() {
      const self = this
      if (self.isLoading) return
      self.isLoading = true
      self.errInfo = ''
      const url = 'http://' + API_BASE + '/api/donors'

      let finished = false
      const watchdog = setTimeout(function () {
        if (!finished) {
          finished = true
          self.isLoading = false
          self.errInfo =
            // '请求 URL: ' + url + '\n' +
            self.$t('donate.timeout')
        }
      }, 18000)

      function markDone() {
        if (!finished) {
          finished = true
          clearTimeout(watchdog)
        }
      }

      // 构造错误日志
      function buildLog(title, details) {
        const parts = []
        parts.push('[' + title + ']')
        // parts.push('URL: ' + url)
        if (details && details.length > 0) {
          for (let i = 0; i < details.length; i++) {
            parts.push(details[i])
            parts.push('解决方案：请将手表连接到vivo健康并确保手机网络正常')
          }
        }
        return parts.join('\n')
      }

      try {
        const net = global.fetch
        if (!net || typeof net.fetch !== 'function') {
          markDone()
          self.isLoading = false
          self.errInfo = buildLog('运行环境错误', [
            '未找到 global.fetch (@blueos.network.fetch)',
            'typeof global.fetch = ' + (typeof net),
          ])
          return
        }

        net.fetch({
          url: url,
          method: 'GET',
          responseType: 'json',
          header: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          success: function (response) {
            markDone()
            self.isLoading = false

            const vals = {}
            const keys = []
            if (
              response !== undefined &&
              response !== null &&
              typeof response === 'object'
            ) {
              for (const k in response) {
                keys.push(k)
                vals[k] = response[k]
              }
            }

            let httpCode = ''
            if (typeof vals.code === 'number') httpCode = 'code=' + vals.code
            else if (typeof vals.status === 'number') httpCode = 'status=' + vals.status

            let rawBody = null
            if (vals.data !== undefined && vals.data !== null) rawBody = vals.data
            else if (vals.text !== undefined && vals.text !== null) rawBody = vals.text
            else if (vals.body !== undefined && vals.body !== null) rawBody = vals.body
            else if (vals.content !== undefined && vals.content !== null) rawBody = vals.content
            if (rawBody === null) rawBody = response

            let bodyPreview = ''
            try {
              if (typeof rawBody === 'string') {
                if (rawBody.length <= 300) bodyPreview = rawBody
                else bodyPreview = rawBody.substring(0, 300) + '…'
              } else if (typeof rawBody === 'object' && rawBody !== null) {
                const k2 = []
                for (const k in rawBody) k2.push(k)
                bodyPreview = '{' + k2.join(',') + '}'
              } else {
                bodyPreview = 'type=' + (typeof rawBody)
              }
            } catch (e2) {
              bodyPreview = 'err'
            }

            let json = null
            try {
              if (typeof rawBody === 'string') json = JSON.parse(rawBody)
              else if (typeof rawBody === 'object') json = rawBody
            } catch (e) {
              self.errInfo = buildLog('响应解析失败', [
                'HTTP: ' + (httpCode || 'unknown'),
                'response keys: ' + keys.join(','),
                '原始内容: ' + bodyPreview,
                'JSON.parse err: ' + e,
              ])
              return
            }

            if (!json || json.ok !== true) {
              let message = ''
              if (json && typeof json.message === 'string') message = json.message
              else if (json && typeof json.msg === 'string') message = json.msg

              self.errInfo = buildLog('接口返回失败', [
                'HTTP: ' + (httpCode || 'unknown'),
                'response keys: ' + keys.join(','),
                'ok: ' + (json && json.ok),
                message ? 'message: ' + message : '响应: ' + bodyPreview,
              ])
              return
            }

            if (!Array.isArray(json.data)) {
              self.errInfo = buildLog('返回结构异常', [
                'HTTP: ' + (httpCode || 'unknown'),
                'json.data 类型: ' + (typeof json.data),
                'data keys: ' + bodyPreview,
              ])
              return
            }

            self.donorList = json.data
            self.smallNames = Array.isArray(json.smallNames) ? json.smallNames : []

            if (
              json.meta &&
              (typeof json.meta.totalAmount === 'string' ||
                typeof json.meta.totalAmount === 'number') &&
              typeof json.meta.totalCount === 'number'
            ) {
              self.totalAmount = String(json.meta.totalAmount)
              self.totalCount = json.meta.totalCount
            } else {
              self.totalAmount = self.getTotalAmount()
              self.totalCount = self.getTotalCount() + self.smallNames.length
            }

            if (json.meta && json.meta.updatedAt) {
              self.updateTime = self.$t('donate.updated_at') + ' ' + self.formatTime(json.meta.updatedAt)
            } else {
              self.updateTime = self.$t('donate.updated') + ' ' + self.formatTime(new Date().toISOString())
            }
            self.errInfo = ''
            self.saveToLocal()
          },
          fail: function (data) {
            markDone()
            self.isLoading = false

            const details = []
            try {
              if (typeof data === 'object') {
                const keys = []
                for (const k in data) keys.push(k)
                if (keys.length > 0) details.push('fail keys: ' + keys.join(','))
                if (typeof data.code === 'number' || typeof data.code === 'string') {
                  details.push('code: ' + data.code)
                } else if (typeof data.status === 'number') {
                  details.push('status: ' + data.status)
                }
                if (typeof data.errMsg === 'string' && data.errMsg.length > 0) {
                  details.push('errMsg: ' + data.errMsg)
                } else if (typeof data.message === 'string' && data.message.length > 0) {
                  details.push('message: ' + data.message)
                } else if (typeof data.data === 'string' && data.data.length > 0) {
                  details.push('data: ' + data.data)
                }
              } else if (typeof data === 'string') {
                details.push('raw: ' + data)
              }
            } catch (e) {
              details.push('处理失败回包时异常: ' + e)
            }
            self.errInfo = buildLog('网络错误', details)
          },
          complete: function () {
            markDone()
            self.isLoading = false
          },
        })
      } catch (e) {
        markDone()
        self.isLoading = false
        self.errInfo = buildLog('调用失败', [
          'exception: ' + e,
        ])
      }
    },

    formatTime(iso) {
      try {
        const d = new Date(iso)
        const pad = (n) => (n < 10 ? '0' + n : '' + n)
        return (
          d.getFullYear() +
          '-' +
          pad(d.getMonth() + 1) +
          '-' +
          pad(d.getDate()) +
          ' ' +
          pad(d.getHours()) +
          ':' +
          pad(d.getMinutes())
        )
      } catch (e) {
        return iso
      }
    },

    getTotalAmount() {
      const data = this.donorList
      let amount = 0
      for (let i = 0; i < data.length; i++) {
        const item = data[i]
        const a = parseFloat(item.a) || 0
        const c = (item.n && item.n.length) || 0
        amount += a * c
      }
      const cents = Math.round(amount * 100)
      const integerPart = Math.floor(cents / 100)
      const decimalPart = cents % 100
      return (
        integerPart + '.' + (decimalPart < 10 ? '0' + decimalPart : decimalPart)
      )
    },

    getTotalCount() {
      const data = this.donorList
      let count = 0
      for (let i = 0; i < data.length; i++) {
        const names = data[i].n
        count += (names && names.length) || 0
      }
      return count
    },
  }
</script>

<style lang="scss">
  @import './../../../assets/styles/style.scss';

  .wrapper {
    flex-direction: column;

    .content {
      flex-direction: column;
      align-items: center;

      qrcode {
        width: 335px;
        height: 335px;
        margin-top: 10px;
      }

      text {
        color: #fff;
        font-size: 36px;
        margin-top: 8px;
      }

      .list-header {
        width: 100%;
        flex-direction: column;
        align-items: center;
        margin-bottom: 30px;

        .list-title {
          font-size: 9 * $size-factor;
          font-weight: bold;
          color: $white;
          margin: 2 * $size-factor;
        }

        .list-desc {
          font-size: 6 * $size-factor;
          color: $gray;
        }

        .refresh-bar {
          width: 220px;
          height: 100px;
          background-color: $brand;
          margin-top: 20px;
          border-radius: 8 * $size-factor;
          flex-direction: column;
          justify-content: center;
          align-items: center;

          &:active {
            opacity: 0.4;
          }
        }

        .refresh-btn {
          font-size: 8 * $size-factor;
          color: $white;
          font-weight: bold;
          margin-bottom: 6px;
        }
      }

      .error-box {
        width: 100%;
        margin-bottom: 20px;
      }

      .error-box .error-inner {
        width: 100%;
        background-color: rgba(255, 100, 100, 0.15);
        border-radius: 8 * $size-factor;
        padding: 22px 24px;
        flex-direction: column;
        align-items: flex-start;
      }

      .error-box .error-title {
        font-size: 8 * $size-factor;
        color: #ff8a8a;
        font-weight: bold;
        margin-bottom: 8px;
      }

      .error-box .error-text {
        width: 100%;
        font-size: 5.2 * $size-factor;
        color: #ffe2e2;
      }

      .donor-group {
        width: 100%;
        background-color: #1a1a1a;
        border-radius: 8 * $size-factor;
        padding: 24px 30px;
        margin-bottom: 18px;
        flex-direction: column;
        align-items: flex-start;

        .group-amount {
          font-size: 10 * $size-factor;
          color: $brand;
          font-weight: bold;
          margin-bottom: 6px;
        }

        .donor-names {
          width: 100%;
          font-size: 6 * $size-factor;
          color: $white;
          font-weight: 500;
          margin-bottom: 14px;
        }
      }

      .small-item .small-group {
        background-color: #202020;
      }

      .small-item .small-amount {
        font-size: 8 * $size-factor;
        color: #ffcc66;
      }

      .small-item .small-names {
        font-size: 5.2 * $size-factor;
        color: #d8d8d8;
      }

      .empty-hint {
        width: 100%;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        padding: 14px 0;

        .empty-text {
          font-size: 6 * $size-factor;
          color: $light-gray;
        }
      }

      .total-item {
        width: 100%;
        padding: 10px 10px 30px;
        flex-direction: column;

        .update-time {
          color: $light-gray;
          margin-top: 20px;
          margin-bottom: 20px;
          font-size: 4.6 * $size-factor;
          text-align: center;
        }

        .total-box {
          width: 100%;
          background-color: #1a1a1a;
          border-radius: 8 * $size-factor;
          padding: 28px 30px;
          @include flex-box-mixins(column, center, center);

          .total-label {
            font-size: 6 * $size-factor;
            color: $gray;
            margin-bottom: 6px;
          }

          .total-amount {
            font-size: 14 * $size-factor;
            color: $brand;
            font-weight: bold;
            margin-bottom: 6px;
          }

          .total-count {
            font-size: 5 * $size-factor;
            color: $light-gray;
          }
        }
      }
    }
  }
</style>

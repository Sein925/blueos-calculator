<template>
  <div class="wrapper">
    <image class="app-logo" src="/assets/images/logo.png"></image>
    <text class="app-name">科学计算器</text>
  </div>
</template>

<style lang="scss">
  @import './../../assets/styles/style.scss';

  .wrapper {
    width: 100%;
    height: 100%;
    background-color: #000;
    @include flex-box-mixins(column, center, center);

    .app-logo {
      width: 196px;
      height: 196px;
      margin-bottom: 30px;
    }

    .app-name {
      font-size: 48px;
      color: $white;
    }
  }
</style>

<script>
  export default {
    data: {
      timerId: null,
    },

    onInit() {
      this.timerId = setTimeout(() => {
        this.checkAndNavigate()
      }, 500)
    },

    checkAndNavigate() {
      global.storage.get({
        key: 'hasSeenGuide',
        success: (data) => {
          if (data && data === 'true') {
            global.router.replace({
              uri: '/pages/Home',
            })
          } else {
            global.router.replace({
              uri: '/pages/Guide',
            })
          }
        },
        fail: () => {
          global.router.replace({
            uri: '/pages/Guide',
          })
        }
      })
    },

    onDestroy() {
      if (this.timerId) {
        clearTimeout(this.timerId)
        this.timerId = null
      }
    },
  }
</script>

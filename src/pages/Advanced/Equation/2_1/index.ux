<import name="d-back" src="./../../../../components/d-back"></import>
<import
  name="d-number-input"
  src="./../../../../components/d-number-input"></import>

<template>
  <list class="wrapper" title="true">
    <list-item>
      <d-back value="{{ $t('equation_2_1.title') }}"></d-back>
    </list-item>

    <list-item class="content">
      <text class="equation-form">a₁x + b₁y = c₁</text>
      <text class="equation-form">a₂x + b₂y = c₂</text>

      <div class="input-row">
        <text class="input-label">a₁ =</text>
        <d-number-input
          value="{{ a1 }}"
          label="{{ $t('common.input') }} a₁"
          placeholder="{{ $t('common.click_input') }}"
          @change="handleChangeA1"></d-number-input>
      </div>

      <div class="input-row">
        <text class="input-label">b₁ =</text>
        <d-number-input
          value="{{ b1 }}"
          label="{{ $t('common.input') }} b₁"
          placeholder="{{ $t('common.click_input') }}"
          @change="handleChangeB1"></d-number-input>
      </div>

      <div class="input-row">
        <text class="input-label">c₁ =</text>
        <d-number-input
          value="{{ c1 }}"
          label="{{ $t('common.input') }} c₁"
          placeholder="{{ $t('common.click_input') }}"
          @change="handleChangeC1"></d-number-input>
      </div>

      <div class="hr"></div>

      <div class="input-row">
        <text class="input-label">a₂ =</text>
        <d-number-input
          value="{{ a2 }}"
          label="{{ $t('common.input') }} a₂"
          placeholder="{{ $t('common.click_input') }}"
          @change="handleChangeA2"></d-number-input>
      </div>

      <div class="input-row">
        <text class="input-label">b₂ =</text>
        <d-number-input
          value="{{ b2 }}"
          label="{{ $t('common.input') }} b₂"
          placeholder="{{ $t('common.click_input') }}"
          @change="handleChangeB2"></d-number-input>
      </div>

      <div class="input-row">
        <text class="input-label">c₂ =</text>
        <d-number-input
          value="{{ c2 }}"
          label="{{ $t('common.input') }} c₂"
          placeholder="{{ $t('common.click_input') }}"
          @change="handleChangeC2"></d-number-input>
      </div>

      <div class="solve-btn" onclick="solve">
        <text class="solve-btn-text">{{ $t('equation_2_1.solve') }}</text>
      </div>

      <div if="{{ showResult }}" class="result-box">
        <text if="{{ showSimpleText }}" class="result-text">
          {{ simpleText }}
        </text>
        <div else class="solutions-container">
          <div class="solution-item">
            <text class="result-label">D =</text>
            <text class="result-value">{{ dValue }}</text>
          </div>
          <div class="solution-item">
            <text class="result-label">x =</text>
            <text if="{{ !xIsInteger && xIsNegative }}" class="fraction-sign">−</text>
            <text if="{{ xIsInteger }}" class="result-value">
              {{ xInteger }}
            </text>
            <div else class="fraction-container">
              <text class="fraction-numerator">{{ xNumeratorStr }}</text>
              <text class="fraction-line">{{ xFractionLine }}</text>
              <text class="fraction-denominator">{{ xDenominatorStr }}</text>
            </div>
          </div>
          <div class="solution-item">
            <text class="result-label">y =</text>
            <text if="{{ !yIsInteger && yIsNegative }}" class="fraction-sign">−</text>
            <text if="{{ yIsInteger }}" class="result-value">
              {{ yInteger }}
            </text>
            <div else class="fraction-container">
              <text class="fraction-numerator">{{ yNumeratorStr }}</text>
              <text class="fraction-line">{{ yFractionLine }}</text>
              <text class="fraction-denominator">{{ yDenominatorStr }}</text>
            </div>
          </div>
        </div>
      </div>
    </list-item>
  </list>
</template>

<script>
  // 计算最大公约数
  function gcd(a, b) {
    a = Math.abs(a)
    b = Math.abs(b)
    while (b) {
      const temp = a
      a = b
      b = temp % b
    }
    return a
  }

  // 简化分数
  function simplifyFraction(numerator, denominator) {
    if (numerator === 0) return { num: 0, den: 1 }

    const g = gcd(numerator, denominator)
    let num = numerator / g
    let den = denominator / g

    if (den < 0) {
      num = -num
      den = -den
    }

    return { num, den }
  }

  // 构造分数（自动约分，den 永远 > 0）
  function makeFrac(n, d) {
    d = d || 1
    if (d === 0) return null
    if (d < 0) {
      n = -n
      d = -d
    }
    const numInt = Math.round(n)
    const denInt = Math.round(d)
    if (denInt === 0) return null
    const g = gcd(Math.abs(numInt), Math.abs(denInt))
    return { num: numInt / g, den: denInt / g }
  }

  // 分数减法
  function subF(a, b) {
    return makeFrac(a.num * b.den - b.num * a.den, a.den * b.den)
  }

  // 分数乘法
  function mulF(a, b) {
    return makeFrac(a.num * b.num, a.den * b.den)
  }

  // 生成分数线
  function getFractionLine(len) {
    len = Math.min(len, 11)
    let line = ''
    for (let i = 0; i < len; i++) {
      line += '─'
    }
    return line
  }

  export default {
    data: {
      a1: '',
      b1: '',
      c1: '',
      a2: '',
      b2: '',
      c2: '',
      a1Frac: { num: 1, den: 1 },
      b1Frac: { num: 1, den: 1 },
      c1Frac: { num: 0, den: 1 },
      a2Frac: { num: 1, den: 1 },
      b2Frac: { num: 1, den: 1 },
      c2Frac: { num: 0, den: 1 },
      showResult: false,
      showSimpleText: false,
      simpleText: '',
      showSolutions: false,
      dValue: '',
      xIsInteger: false,
      xIsNegative: false,
      xInteger: '',
      xNumeratorStr: '',
      xDenominatorStr: '',
      xFractionLine: '',
      yIsInteger: false,
      yIsNegative: false,
      yInteger: '',
      yNumeratorStr: '',
      yDenominatorStr: '',
      yFractionLine: '',
    },

    onInit() {},

    handleChangeA1(evt) {
      this.a1 = evt.value
      if (evt.isFraction) {
        this.a1Frac = { num: evt.num, den: evt.den }
      } else {
        this.a1Frac = makeFrac(parseFloat(evt.value), 1) || { num: 1, den: 1 }
      }
    },
    handleChangeB1(evt) {
      this.b1 = evt.value
      if (evt.isFraction) {
        this.b1Frac = { num: evt.num, den: evt.den }
      } else {
        this.b1Frac = makeFrac(parseFloat(evt.value), 1) || { num: 1, den: 1 }
      }
    },
    handleChangeC1(evt) {
      this.c1 = evt.value
      if (evt.isFraction) {
        this.c1Frac = { num: evt.num, den: evt.den }
      } else {
        this.c1Frac = makeFrac(parseFloat(evt.value), 1) || { num: 0, den: 1 }
      }
    },
    handleChangeA2(evt) {
      this.a2 = evt.value
      if (evt.isFraction) {
        this.a2Frac = { num: evt.num, den: evt.den }
      } else {
        this.a2Frac = makeFrac(parseFloat(evt.value), 1) || { num: 1, den: 1 }
      }
    },
    handleChangeB2(evt) {
      this.b2 = evt.value
      if (evt.isFraction) {
        this.b2Frac = { num: evt.num, den: evt.den }
      } else {
        this.b2Frac = makeFrac(parseFloat(evt.value), 1) || { num: 1, den: 1 }
      }
    },
    handleChangeC2(evt) {
      this.c2 = evt.value
      if (evt.isFraction) {
        this.c2Frac = { num: evt.num, den: evt.den }
      } else {
        this.c2Frac = makeFrac(parseFloat(evt.value), 1) || { num: 0, den: 1 }
      }
    },

    formatNumber(num) {
      if (!isFinite(num)) return 'Error'
      if (Math.abs(num) < 1e-10) return '0'
      const str = num.toPrecision(10)
      return parseFloat(str).toString()
    },

    solve() {
      // 重置所有显示
      this.showResult = true
      this.showSimpleText = false
      this.showSolutions = false

      // 有效性检查（用分数的 num/den）
      const anyNaN = [
        this.a1Frac,
        this.b1Frac,
        this.c1Frac,
        this.a2Frac,
        this.b2Frac,
        this.c2Frac,
      ].some((f) => !f || isNaN(f.num) || isNaN(f.den) || f.den === 0)
      if (anyNaN) {
        this.showSimpleText = true
        this.simpleText = this.$t('equation_2_1.invalid_input')
        return
      }

      // 克莱姆法则：用精确分数算 D, Dx, Dy
      // D = a1*b2 - a2*b1
      const D = subF(mulF(this.a1Frac, this.b2Frac), mulF(this.a2Frac, this.b1Frac))
      // Dx = c1*b2 - c2*b1
      const Dx = subF(mulF(this.c1Frac, this.b2Frac), mulF(this.c2Frac, this.b1Frac))
      // Dy = a1*c2 - a2*c1
      const Dy = subF(mulF(this.a1Frac, this.c2Frac), mulF(this.a2Frac, this.c1Frac))

      if (!D || !Dx || !Dy) {
        this.showSimpleText = true
        this.simpleText = this.$t('equation_2_1.error')
        return
      }

      // D === 0 → 浮点比较用 D.num === 0
      if (D.num === 0) {
        this.showSimpleText = true
        const allZeroCoeff =
          this.a1Frac.num === 0 &&
          this.b1Frac.num === 0 &&
          this.a2Frac.num === 0 &&
          this.b2Frac.num === 0
        if (allZeroCoeff) {
          if (this.c1Frac.num === 0 && this.c2Frac.num === 0) {
            this.simpleText = this.$t('equation_2_1.infinite_solutions')
          } else {
            this.simpleText = this.$t('equation_2_1.no_solution')
          }
        } else if (Dx.num === 0 && Dy.num === 0) {
          this.simpleText = this.$t('equation_2_1.infinite_solutions')
        } else {
          this.simpleText = this.$t('equation_2_1.no_solution')
        }
        return
      }

      if (global.equationOutputMode === 'decimal') {
        this.showSimpleText = true
        const x = Dx.num / Dx.den / (D.num / D.den)
        const y = Dy.num / Dy.den / (D.num / D.den)
        this.simpleText =
          'D = ' +
          (D.num / D.den).toString() +
          '\nx = ' +
          this.formatNumber(x) +
          '\ny = ' +
          this.formatNumber(y)
        return
      }

      this.showSolutions = true
      this.dValue = D.num / D.den + ''

      // x = Dx / D：用整数化结果传给 simplifyFraction
      const xFrac = simplifyFraction(Dx.num * D.den, Dx.den * D.num)
      if (xFrac.den === 1) {
        this.xIsInteger = true
        this.xIsNegative = false
        this.xInteger = xFrac.num.toString()
      } else {
        this.xIsInteger = false
        this.xIsNegative = xFrac.num < 0
        this.xNumeratorStr = Math.abs(xFrac.num).toString()
        this.xDenominatorStr = xFrac.den.toString()
        const xMaxLen = Math.max(
          this.xNumeratorStr.length,
          this.xDenominatorStr.length
        )
        this.xFractionLine = getFractionLine(xMaxLen)
      }

      const yFrac = simplifyFraction(Dy.num * D.den, Dy.den * D.num)
      if (yFrac.den === 1) {
        this.yIsInteger = true
        this.yIsNegative = false
        this.yInteger = yFrac.num.toString()
      } else {
        this.yIsInteger = false
        this.yIsNegative = yFrac.num < 0
        this.yNumeratorStr = Math.abs(yFrac.num).toString()
        this.yDenominatorStr = yFrac.den.toString()
        const yMaxLen = Math.max(
          this.yNumeratorStr.length,
          this.yDenominatorStr.length
        )
        this.yFractionLine = getFractionLine(yMaxLen)
      }
    },
  }
</script>

<style lang="scss">
  @import './../../../../assets/styles/style.scss';

  .wrapper {
    width: 100%;
  }

  .content {
    width: 100%;
    flex-direction: column;
    padding: 0 2 * $size-factor 4 * $size-factor 2 * $size-factor;
  }

  .equation-form {
    width: 100%;
    text-align: center;
    font-size: 8 * $size-factor;
    color: $success;
    font-family: monospace;
  }

  .input-row {
    width: 100%;
    @include flex-box-mixins(row, space-between, center);
    margin-top: 20px;
  }

  .input-label {
    font-size: 6 * $size-factor;
    color: white;
    width: 60px;
    margin: 0 2 * $size-factor;
  }

  .solve-btn {
    width: 100%;
    padding: 3 * $size-factor 0;
    background-color: $brand;
    border-radius: 8 * $size-factor;
    margin: 28px 0 20px 0;
    @include flex-box-mixins(row, center, center);

    &:active {
      opacity: 0.4;
    }
  }

  .solve-btn-text {
    font-size: 8 * $size-factor;
    color: white;
  }

  .result-box {
    width: 100%;
    padding: 4 * $size-factor;
    background-color: $success-bg;
    border-radius: 8 * $size-factor;
    border-left-width: 3px;
    border-left-color: $success;
    margin-bottom: 16px;
  }

  .solutions-container {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .solution-item {
    display: flex;
    align-items: center;
  }

  .result-label {
    font-size: 6 * $size-factor;
    color: $success;
    font-family: monospace;
  }

  .result-value {
    font-size: 6 * $size-factor;
    color: $success;
    font-family: monospace;
    margin-left: 16px;
  }

  .result-text {
    font-size: 6 * $size-factor;
    color: $success;
    font-family: monospace;
  }

  .fraction-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-left: 16px;
  }

  .fraction-sign {
    font-size: 6 * $size-factor;
    color: $success;
    font-family: monospace;
    margin-left: 16px;
    margin-right: -8px;
  }

  .fraction-numerator {
    font-size: 6 * $size-factor;
    color: $success;
    font-family: monospace;
    padding-bottom: 2px;
    text-align: center;
  }

  .fraction-line {
    font-size: 6 * $size-factor;
    color: $success;
    font-family: monospace;
    line-height: 2;
  }

  .fraction-denominator {
    font-size: 6 * $size-factor;
    color: $success;
    font-family: monospace;
    padding-top: 2px;
    text-align: center;
  }
</style>

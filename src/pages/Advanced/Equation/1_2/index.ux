<import name="d-back" src="./../../../../components/d-back"></import>
<import
  name="d-number-input"
  src="./../../../../components/d-number-input"></import>

<template>
  <list class="wrapper" title="true">
    <list-item>
      <d-back value="{{ $t('equation_1_2.title') }}"></d-back>
    </list-item>

    <list-item class="content">
      <text class="equation-form">ax² + bx + c = 0</text>
      <text if="{{ showExactModeTip }}" class="description">{{ $t('equation_1_2.exact_tip') }}</text>

      <div class="input-row">
        <text class="input-label">a =</text>
        <d-number-input
          value="{{ a }}"
          label="{{ $t('common.input') }} a"
          placeholder="{{ $t('common.click_input') }}"
          @change="handleChangeA"></d-number-input>
      </div>

      <div class="input-row">
        <text class="input-label">b =</text>
        <d-number-input
          value="{{ b }}"
          label="{{ $t('common.input') }} b"
          placeholder="{{ $t('common.click_input') }}"
          @change="handleChangeB"></d-number-input>
      </div>

      <div class="input-row">
        <text class="input-label">c =</text>
        <d-number-input
          value="{{ c }}"
          label="{{ $t('common.input') }} c"
          placeholder="{{ $t('common.click_input') }}"
          @change="handleChangeC"></d-number-input>
      </div>

      <div class="solve-btn" onclick="solve">
        <text class="solve-btn-text">{{ $t('equation_1_2.solve') }}</text>
      </div>

      <div if="{{ showResult }}" class="result-box">
        <text if="{{ showSimpleText }}" class="result-text">
          {{ simpleText }}
        </text>

        <text if="{{ showRoots }}" class="result-text">{{ deltaText }}</text>
        <text if="{{ showRoots }}" class="result-text">{{ rootsLabel }}</text>

        <list if="{{ showRoots }}" class="result-row">
          <list-item>
            <text if="{{ !isDoubleRoot }}" class="result-label">x₁ =</text>
            <text else class="result-label">x₁ = x₂ =</text>
            <div if="{{ x1IsInt }}" class="result-content">
              <text class="result-value">{{ x1IntValue }}</text>
            </div>
            <div else if="{{ x1IsFrac }}" class="result-content">
              <div class="fraction-container">
                <text class="fraction-numerator">
                  {{ x1Num }}
                </text>
                <text class="fraction-line">{{ x1Line }}</text>
                <text class="fraction-denominator">
                  {{ x1Den }}
                </text>
              </div>
            </div>
            <div else if="{{ x1IsRad }}" class="result-content">
              <div if="{{ x1RadIsDenOne }}" class="result-content">
                <text class="result-value">{{ x1RadNumStr }}</text>
              </div>
              <div else class="fraction-container">
                <text class="fraction-numerator">
                  {{ x1RadNumStr }}
                </text>
                <text class="fraction-line">{{ x1RadLine }}</text>
                <text class="fraction-denominator">
                  {{ x1RadDen }}
                </text>
              </div>
            </div>
          </list-item>
        </list>

        <list if="{{ showX2 }}" class="result-row">
          <list-item>
            <text class="result-label">x₂ =</text>
            <div if="{{ x2IsInt }}" class="result-content">
              <text class="result-value">{{ x2IntValue }}</text>
            </div>
            <div else if="{{ x2IsFrac }}" class="result-content">
              <div class="fraction-container">
                <text class="fraction-numerator">
                  {{ x2Num }}
                </text>
                <text class="fraction-line">{{ x2Line }}</text>
                <text class="fraction-denominator">
                  {{ x2Den }}
                </text>
              </div>
            </div>
            <div else if="{{ x2IsRad }}" class="result-content">
              <div if="{{ x2RadIsDenOne }}" class="result-content">
                <text class="result-value">{{ x2RadNumStr }}</text>
              </div>
              <div else class="fraction-container">
                <text class="fraction-numerator">
                  {{ x2RadNumStr }}
                </text>
                <text class="fraction-line">{{ x2RadLine }}</text>
                <text class="fraction-denominator">
                  {{ x2RadDen }}
                </text>
              </div>
            </div>
          </list-item>
        </list>
      </div>
    </list-item>
  </list>
</template>

<script>
  function gcd(a, b) {
    a = Math.abs(a)
    b = Math.abs(b)

    if (a === 0) return b
    if (b === 0) return a

    // 位运算（|、>>）会把小数截断为 0 导致死循环，非整数参数直接返回 1（不化简）
    if (Math.floor(a) !== a || Math.floor(b) !== b) return 1

    // 找到 a 和 b 中 2 的最高次幂因子
    let shift = 0
    while (((a | b) & 1) === 0) {
      a >>= 1
      b >>= 1
      shift++
    }

    // 使 a 变为奇数
    while ((a & 1) === 0) {
      a >>= 1
    }

    do {
      // 使 b 变为奇数
      while ((b & 1) === 0) {
        b >>= 1
      }

      // 此时 a 和 b 都是奇数，交换使得 a <= b，然后 b = b - a
      if (a > b) {
        const temp = a
        a = b
        b = temp
      }
      b -= a
    } while (b !== 0)

    return a << shift
  }

  function gcd3(a, b, c) {
    return gcd(gcd(a, b), c)
  }

  function simplifyFraction(numerator, denominator) {
    if (numerator === 0) return { num: 0, den: 1 }

    const g = gcd(numerator, denominator)
    let num = numerator / g
    let den = denominator / g

    if (den < 0) {
      num = -num
      den = -den
    }

    return { num, den }
  }

  function numToFrac(n) {
    if (!isFinite(n)) return { num: 0, den: 1 }
    if (Math.floor(n) === n) return { num: n, den: 1 }
    const s = n.toFixed(12).replace(/\.?0+$/, '')
    const [intPart, decPart = ''] = s.split('.')
    if (!decPart) return { num: parseInt(intPart), den: 1 }
    const den = Math.pow(10, decPart.length)
    // parseInt(intPart + decPart) 已含符号（如 "-1.5625" → -15625），直接约分即可
    const num = parseInt(intPart + decPart)
    const g = gcd(Math.abs(num), den)
    return { num: num / g, den: den / g }
  }

  // 最小公倍数
  function lcm(a, b) {
    return (a * b) / gcd(a, b)
  }

  // 构造分数（自动约分，den 永远 > 0）
  function makeFrac(n, d) {
    d = d || 1
    if (d === 0) return null
    if (d < 0) {
      n = -n
      d = -d
    }
    const numInt = Math.round(n)
    const denInt = Math.round(d)
    if (denInt === 0) return null
    const g = gcd(Math.abs(numInt), Math.abs(denInt))
    return { num: numInt / g, den: denInt / g }
  }

  // 分数减法
  function subF(a, b) {
    return makeFrac(a.num * b.den - b.num * a.den, a.den * b.den)
  }

  // 分数乘法
  function mulF(a, b) {
    return makeFrac(a.num * b.num, a.den * b.den)
  }

  // 提取 n 的最大完全平方因子，返回 {out, rest} 表示 n = out² * rest
  function extractSquareFactor(n) {
    let out = 1
    let rest = Math.abs(Math.round(n))
    for (let i = 2; i * i <= rest; i++) {
      while (rest % (i * i) === 0) {
        out *= i
        rest /= i * i
      }
    }
    return { out, rest }
  }

  // 化简 sqrt(num/den) = coeff * sqrt(radicand) / den
  // 用公式 sqrt(a/b) = sqrt(a*b) / b
  function simplifyRadicalFrac(num, den) {
    if (num === 0) return { coeff: 0, radicand: 0, den: 1 }
    const sign = num < 0 ? -1 : 1
    const product = Math.abs(num) * Math.abs(den)
    const f = extractSquareFactor(product)
    return {
      coeff: f.out * sign,
      radicand: f.rest,
      den: Math.abs(den),
    }
  }

  // 分数取负
  function negF(a) {
    return { num: -a.num, den: a.den }
  }

  // 分数除法
  function divF(a, b) {
    return makeFrac(a.num * b.den, a.den * b.num)
  }

  // 分数转字符串（已约分）
  function fracToStr(f) {
    if (f.den === 1) return f.num.toString()
    return f.num + '/' + f.den
  }

  // 基于精确分数判断 delta 是否为完全平方分数 (p/q)²（无 q 上限、无浮点容差）
  // 例如 delta=25/4 → { p: 5, q: 2 }，即 √(25/4)；delta=9/4 → { p: 3, q: 2 }
  // delta 非有理平方（如 6）→ null
  function tryRationalSqrtExact(num, den) {
    if (num <= 0) return null
    const p = Math.round(Math.sqrt(num))
    const q = Math.round(Math.sqrt(den))
    if (p * p === num && q * q === den) return { p, q }
    return null
  }

  function getFractionLine(len) {
    len = Math.min(len, 11)
    let line = ''
    for (let i = 0; i < len; i++) {
      line += '─'
    }
    return line
  }

  function isInteger(num) {
    return Math.abs(num - Math.round(num)) < 1e-10
  }

  function formatRadicalNum(N, K, D) {
    let str = ''
    if (N !== 0) {
      str += N.toString()
    }

    if (K > 0) {
      if (N !== 0) str += ' + '
      if (K !== 1) str += K.toString()
      str += '√' + D.toString()
    } else if (K < 0) {
      if (N !== 0) str += ' − '
      else str += '−'
      if (K !== -1) str += (-K).toString()
      str += '√' + D.toString()
    }

    return str || '0'
  }

  export default {
    data: {
      a: '',
      b: '',
      c: '',
      aFrac: { num: 1, den: 1 },
      bFrac: { num: 0, den: 1 },
      cFrac: { num: 0, den: 1 },
      showResult: false,
      showSimpleText: false,
      simpleText: '',
      showRoots: false,
      deltaText: '',
      rootsLabel: '',
      isDoubleRoot: false,
      x1IsInt: false,
      x1IntValue: '',
      x1IsFrac: false,
      x1Num: '',
      x1Den: '',
      x1Line: '',
      x1IsRad: false,
      x1RadNumStr: '',
      x1RadIsDenOne: false,
      x1RadDen: '',
      x1RadLine: '',
      showX2: false,
      x2IsInt: false,
      x2IntValue: '',
      x2IsFrac: false,
      x2Num: '',
      x2Den: '',
      x2Line: '',
      x2IsRad: false,
      x2RadNumStr: '',
      x2RadIsDenOne: false,
      x2RadDen: '',
      x2RadLine: '',
      showExactModeTip: false,
    },

    onInit() {
      this.showExactModeTip = global.equationOutputMode === 'exact'
    },

    onShow() {
      this.showExactModeTip = global.equationOutputMode === 'exact'
    },

    handleChangeA(evt) {
      this.a = evt.value
      if (evt.isFraction) {
        this.aFrac = { num: evt.num, den: evt.den }
      } else {
        this.aFrac = numToFrac(parseFloat(evt.value)) || { num: 1, den: 1 }
      }
    },
    handleChangeB(evt) {
      this.b = evt.value
      if (evt.isFraction) {
        this.bFrac = { num: evt.num, den: evt.den }
      } else {
        this.bFrac = numToFrac(parseFloat(evt.value)) || { num: 0, den: 1 }
      }
    },
    handleChangeC(evt) {
      this.c = evt.value
      if (evt.isFraction) {
        this.cFrac = { num: evt.num, den: evt.den }
      } else {
        this.cFrac = numToFrac(parseFloat(evt.value)) || { num: 0, den: 1 }
      }
    },

    formatNumber(num) {
      if (!isFinite(num)) return 'Error'
      if (Math.abs(num) < 1e-10) return '0'
      if (isInteger(num)) {
        return Math.round(num).toString()
      }
      const str = num.toPrecision(10)
      return parseFloat(str).toString()
    },

    solve() {
      // 用精确分数算 delta（避免 88/3 平方的浮点误差）
      // delta = b² - 4ac
      const b2 = mulF(this.bFrac, this.bFrac)
      const fourAc = mulF(mulF(this.aFrac, this.cFrac), { num: 4, den: 1 })
      const deltaFrac = subF(b2, fourAc)
      if (!deltaFrac) {
        this.showResult = true
        this.showSimpleText = true
        this.simpleText = this.$t('equation_1_2.error')
        return
      }
      const delta = deltaFrac.num / deltaFrac.den
      const a = parseFloat(this.a)
      const b = parseFloat(this.b)

      this.showResult = true
      this.showSimpleText = false
      this.showRoots = false
      this.isDoubleRoot = false
      this.showX2 = false
      this.x1IsInt = false
      this.x1IsFrac = false
      this.x1IsRad = false
      this.x2IsInt = false
      this.x2IsFrac = false
      this.x2IsRad = false

      if (
        isNaN(parseFloat(this.a)) ||
        isNaN(parseFloat(this.b)) ||
        isNaN(parseFloat(this.c))
      ) {
        this.showSimpleText = true
        this.simpleText = this.$t('equation_1_2.invalid_input')
        return
      }

      // a === 0 时退化为一次方程（用 aFrac 判）
      if (this.aFrac.num === 0) {
        this.showSimpleText = true
        if (this.bFrac.num === 0) {
          if (this.cFrac.num === 0) {
            this.simpleText = this.$t('equation_1_2.infinite_solutions')
          } else {
            this.simpleText = this.$t('equation_1_2.no_solution')
          }
        } else {
          // x = -c / b
          const xFrac = divF(negF(this.cFrac), this.bFrac)
          this.simpleText =
            this.$t('equation_1_2.degenerate') + fracToStr(xFrac)
        }
        return
      }

      this.showRoots = true
      this.deltaText = 'Δ = ' + fracToStr(deltaFrac)

      const sqrtDelta = Math.sqrt(delta)

      if (delta < 0) {
        this.showRoots = false
        this.showSimpleText = true
        const realPart = -b / (2 * a)
        const imagPart = Math.sqrt(-delta) / (2 * Math.abs(a))
        this.simpleText =
          'Δ = ' +
          this.formatNumber(delta) +
          ' < 0\n' + this.$t('equation_1_2.no_real_roots') + '\nx₁ = ' +
          this.formatNumber(realPart) +
          ' + ' +
          this.formatNumber(imagPart) +
          'i\nx₂ = ' +
          this.formatNumber(realPart) +
          ' - ' +
          this.formatNumber(imagPart) +
          'i'
        return
      }

      if (global.equationOutputMode === 'decimal') {
        this.showSimpleText = true
        this.showRoots = false
        if (delta > 0) {
          const x1 = (-b + sqrtDelta) / (2 * a)
          const x2 = (-b - sqrtDelta) / (2 * a)
          this.simpleText =
            this.$t('equation_1_2.two_roots') + '\nx₁ = ' +
            this.formatNumber(x1) +
            '\nx₂ = ' +
            this.formatNumber(x2)
        } else {
          const x = -b / (2 * a)
          this.simpleText =
            this.$t('equation_1_2.double_root') + '\nx₁ = x₂ = ' + this.formatNumber(x)
        }
        return
      }

      this.x1IsInt = false
      this.x1IsFrac = false
      this.x1IsRad = false
      this.x2IsInt = false
      this.x2IsFrac = false
      this.x2IsRad = false

      if (isInteger(sqrtDelta)) {
        const sqrtD = Math.round(sqrtDelta)

        // 用精确分数算根，避免浮点 -b±sqrtD、2a 传入 gcd（位运算截断小数会导致死循环）
        // x = (-b ± sqrtD)/(2a) = ((-bFrac.num ± sqrtD*bFrac.den) * aFrac.den) / (bFrac.den * 2*aFrac.num)
        const aFracN = this.aFrac.num
        const aFracD = this.aFrac.den
        const bFracN = this.bFrac.num
        const bFracD = this.bFrac.den
        const rootFrac = sign =>
          simplifyFraction(
            (-bFracN + sign * sqrtD * bFracD) * aFracD,
            bFracD * 2 * aFracN
          )

        if (delta > 0) {
          this.rootsLabel = this.$t('equation_1_2.two_roots')
          this.showX2 = true

          const frac1 = rootFrac(1)
          if (frac1.den === 1) {
            this.x1IsInt = true
            this.x1IntValue = frac1.num.toString()
          } else {
            this.x1IsFrac = true
            this.x1Num = frac1.num.toString()
            this.x1Den = frac1.den.toString()
            const maxLen1 = Math.max(this.x1Num.length, this.x1Den.length)
            this.x1Line = getFractionLine(maxLen1)
          }

          const frac2 = rootFrac(-1)
          if (frac2.den === 1) {
            this.x2IsInt = true
            this.x2IntValue = frac2.num.toString()
          } else {
            this.x2IsFrac = true
            this.x2Num = frac2.num.toString()
            this.x2Den = frac2.den.toString()
            const maxLen2 = Math.max(this.x2Num.length, this.x2Den.length)
            this.x2Line = getFractionLine(maxLen2)
          }
        } else {
          this.rootsLabel = this.$t('equation_1_2.double_root')
          this.showX2 = false
          this.isDoubleRoot = true

          const frac = rootFrac(0)
          if (frac.den === 1) {
            this.x1IsInt = true
            this.x1IntValue = frac.num.toString()
          } else {
            this.x1IsFrac = true
            this.x1Num = frac.num.toString()
            this.x1Den = frac.den.toString()
            const maxLen = Math.max(this.x1Num.length, this.x1Den.length)
            this.x1Line = getFractionLine(maxLen)
          }
        }
        return
      }

      // 分支 1.5：delta 是有理平方 (p/q)²（如 6.25 = (5/2)²、2.25 = (3/2)²）
      // 把 -b 也按 q 整数化后用分数算根，避免落入根式分支后被错误 round
      const rationalSqrt = tryRationalSqrtExact(deltaFrac.num, deltaFrac.den)
      if (rationalSqrt) {
        const p = rationalSqrt.p
        const q = rationalSqrt.q

        // 直接用 handleChange 存的精确分数（this.bFrac/this.aFrac），
        // 不再 numToFrac(b) 从浮点重建，避免二次误差
        const bFrac = this.bFrac
        const aFrac = this.aFrac
        const commonDen = lcm(bFrac.den, q)

        // 把所有项乘以 commonDen 转为整数
        const bInt = bFrac.num * (commonDen / bFrac.den)
        const pInt = p * (commonDen / q)
        const twoAInt = 2 * aFrac.num * (commonDen / aFrac.den)

        // x = (-b ± p/q) / (2a)，统一分母后：x = (-bInt ± pInt) / twoAInt
        const x1 = simplifyFraction(-bInt + pInt, twoAInt)
        const x2 = simplifyFraction(-bInt - pInt, twoAInt)

        this.rootsLabel = this.$t('equation_1_2.two_roots')
        this.showX2 = true
        this.isDoubleRoot = false

        if (x1.den === 1) {
          this.x1IsInt = true
          this.x1IntValue = x1.num.toString()
        } else {
          this.x1IsFrac = true
          this.x1Num = x1.num.toString()
          this.x1Den = x1.den.toString()
          const maxLen1 = Math.max(this.x1Num.length, this.x1Den.length)
          this.x1Line = getFractionLine(maxLen1)
        }

        if (x2.den === 1) {
          this.x2IsInt = true
          this.x2IntValue = x2.num.toString()
        } else {
          this.x2IsFrac = true
          this.x2Num = x2.num.toString()
          this.x2Den = x2.den.toString()
          const maxLen2 = Math.max(this.x2Num.length, this.x2Den.length)
          this.x2Line = getFractionLine(maxLen2)
        }

        return
      }

      // 根式分支：用精确分数化简 sqrt(delta) = K*sqrt(D)/M
      const rad = simplifyRadicalFrac(deltaFrac.num, deltaFrac.den)
      const K = rad.coeff
      const D = rad.radicand
      const M = rad.den

      // 算 N = -b / (2a)（精确分数）
      const negB = negF(this.bFrac)
      const twoA = mulF(this.aFrac, { num: 2, den: 1 })
      if (!twoA) {
        this.showSimpleText = true
        this.simpleText = this.$t('equation_1_2.error')
        return
      }
      const N = divF(negB, twoA)

      if (!N) {
        this.showSimpleText = true
        this.simpleText = this.$t('equation_1_2.error')
        return
      }

      // 算 x = N ± (K*sqrt(D)/M) / (2a)
      //   = N.num/N.den ± (K*twoA.den)*sqrt(D) / (M*twoA.num)
      // 注意：twoA = 2*aFrac 是约分后的分数，sqrt(Δ)/(2a) 也必须用约分后的 twoA，
      // 否则当 a 是 x/2 形式（twoA 约掉因子 2）时，根式系数会多算 aFrac.den/twoA.den 倍。
      // 整体分子：N.num*M*twoA.num ± K*twoA.den*sqrt(D)*N.den
      // 整体分母：N.den*M*twoA.num
      // numInt = N.num * M * twoA.num
      // coefK  = K * twoA.den * N.den
      // denInt = N.den * M * twoA.num
      const numInt = N.num * M * twoA.num
      const coefK = K * twoA.den * N.den
      const denInt = N.den * M * twoA.num

      // 整体化简：三者最大公因
      const g = gcd3(Math.abs(numInt), Math.abs(coefK), Math.abs(denInt))
      let N_out = numInt / g
      let K_out = coefK / g
      let Den_out = denInt / g

      // 分母符号归一化：保证 Den_out > 0（a<0 时 twoA.num<0 会令 Den_out 为负）
      if (Den_out < 0) {
        N_out = -N_out
        K_out = -K_out
        Den_out = -Den_out
      }

      this.rootsLabel = this.$t('equation_1_2.two_roots')

      // x1 = N_out + K_out*sqrt(D),  x2 = N_out - K_out*sqrt(D)
      // 共同根号部分：|K_out|*sqrt(D)
      // x1 根式系数：+K_out
      // x2 根式系数：-K_out
      const x1K = K_out
      const x2K = -K_out

      // 共同 N 部分（K=0 时退化为纯整数或纯分数）
      if (K_out === 0) {
        // 退化为整数或分数（已经在 isInteger 路径覆盖，但保险起见）
        if (Den_out === 1) {
          this.x1IsInt = true
          this.x1IntValue = N_out.toString()
          this.x1IsRad = false
        } else {
          this.x1IsFrac = true
          this.x1Num = N_out.toString()
          this.x1Den = Den_out.toString()
          this.x1Line = getFractionLine(
            Math.max(this.x1Num.length, this.x1Den.length)
          )
        }
        this.showX2 = delta > 0
        if (this.showX2) {
          // 双重根：x1 = x2
        }
        return
      }

      // 根式显示：N_out/Den_out ± K_out*sqrt(D)
      // 当 Den_out == 1：N_out ± K_out*sqrt(D)
      // 当 Den_out > 1：(N_out ± K_out*sqrt(D)) / Den_out
      const x1NumStr = formatRadicalNum(N_out, x1K, D)
      const x2NumStr = formatRadicalNum(N_out, x2K, D)

      if (Den_out === 1) {
        this.x1IsRad = true
        this.x1RadNumStr = x1NumStr
        this.x1RadIsDenOne = true
      } else {
        this.x1IsRad = true
        this.x1RadNumStr = x1NumStr
        this.x1RadDen = Den_out.toString()
        const maxLen1 = Math.max(x1NumStr.length, Den_out.toString().length)
        this.x1RadLine = getFractionLine(maxLen1)
      }

      if (delta > 0) {
        this.showX2 = true
        if (Den_out === 1) {
          this.x2IsRad = true
          this.x2RadNumStr = x2NumStr
          this.x2RadIsDenOne = true
        } else {
          this.x2IsRad = true
          this.x2RadNumStr = x2NumStr
          this.x2RadDen = Den_out.toString()
          const maxLen2 = Math.max(x2NumStr.length, Den_out.toString().length)
          this.x2RadLine = getFractionLine(maxLen2)
        }
      } else {
        this.showX2 = false
      }
    },
  }
</script>

<style lang="scss">
  @import './../../../../assets/styles/style.scss';

  .wrapper {
    width: 100%;
  }

  .content {
    width: 100%;

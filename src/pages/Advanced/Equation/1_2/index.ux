    padding: 0 2 * $size-factor 4 * $size-factor 2 * $size-factor;
  }

  .equation-form {
    width: 100%;
    text-align: center;
    font-size: 8 * $size-factor;
    color: $success;
    font-family: monospace;
  }

  .description {
    color: $gray;
    font-size: 6 * $size-factor;
    margin-top: 3 * $size-factor;
    margin-left: 2.4 * $size-factor;
  }

  .input-row {
    width: 100%;
    @include flex-box-mixins(row, space-between, center);
    margin-top: 20px;
  }

  .input-label {
    font-size: 6 * $size-factor;
    color: white;
    width: 60px;
    margin: 0 2 * $size-factor;
  }

  .solve-btn {
    width: 100%;
    padding: 3 * $size-factor 0;
    background-color: $brand;
    border-radius: 8 * $size-factor;
    margin: 28px 0 20px 0;
    @include flex-box-mixins(row, center, center);

    &:active {
      opacity: 0.4;
    }
  }

  .solve-btn-text {
    font-size: 8 * $size-factor;
    color: white;
  }

  .result-box {
    width: 100%;
    flex-direction: column;
    padding: 4 * $size-factor;
    background-color: $success-bg;
    border-radius: 8 * $size-factor;
    margin-bottom: 16px;
    max-height: 350px;
  }

  .result-text {
    font-size: 6 * $size-factor;
    color: $success;
    font-family: monospace;
  }

  .result-row {
    align-items: center;
    margin-top: 8px;
    flex-direction: row;
    height: 90px;
  }

  .result-content {
    display: flex;
    align-items: center;
    margin-left: 8px;
  }

  .result-label {
    font-size: 6 * $size-factor;
    color: $success;
    font-family: monospace;
  }

  .result-value {
    font-size: 6 * $size-factor;
    color: $success;
    font-family: monospace;
    margin-left: 8px;
  }

  .fraction-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-left: 8px;
  }

  .fraction-numerator {
    font-size: 6 * $size-factor;
    color: $success;
    font-family: monospace;
    padding-bottom: 2px;
    text-align: center;
  }

  .fraction-line {
    font-size: 6 * $size-factor;
    color: $success;
    font-family: monospace;
    line-height: 2;
  }

  .fraction-denominator {
    font-size: 6 * $size-factor;
    color: $success;
    font-family: monospace;
    padding-top: 2px;
    text-align: center;
  }
</style>

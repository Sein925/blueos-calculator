<import name="d-back" src="./../../../../components/d-back"></import>
<import
  name="d-number-input"
  src="./../../../../components/d-number-input"></import>

<template>
  <list class="wrapper" title="true">
    <list-item>
      <d-back value="一元一次方程"></d-back>
    </list-item>

    <list-item class="content">
      <text class="equation-form">ax + b = c</text>

      <div class="input-row">
        <text class="input-label">a =</text>
        <d-number-input
          value="{{ a }}"
          label="输入 a"
          placeholder="点击输入"
          @change="handleChangeA"></d-number-input>
      </div>

      <div class="input-row">
        <text class="input-label">b =</text>
        <d-number-input
          value="{{ b }}"
          label="输入 b"
          placeholder="点击输入"
          @change="handleChangeB"></d-number-input>
      </div>

      <div class="input-row">
        <text class="input-label">c =</text>
        <d-number-input
          value="{{ c }}"
          label="输入 c"
          placeholder="点击输入"
          @change="handleChangeC"></d-number-input>
      </div>

      <div class="solve-btn" onclick="solve">
        <text class="solve-btn-text">求解</text>
      </div>

      <div if="{{ showResult }}" class="result-box">
        <text if="{{ showSimpleText }}" class="result-text">
          {{ simpleText }}
        </text>
        <div else if="{{ showInteger }}" class="result-content">
          <text class="result-label">x =</text>
          <text class="result-value">{{ integerValue }}</text>
        </div>
        <div else if="{{ showFraction }}" class="result-content">
          <text class="result-label">x =</text>
          <text if="{{ showNegativeSign }}" class="fraction-sign">−</text>
          <div class="fraction-container">
            <text class="fraction-numerator">{{ numeratorStr }}</text>
            <text class="fraction-line">{{ fractionLine }}</text>
            <text class="fraction-denominator">{{ denominatorStr }}</text>
          </div>
        </div>
      </div>
    </list-item>
  </list>
</template>

<script>
  // 计算最大公约数
  function gcd(a, b) {
    a = Math.abs(a)
    b = Math.abs(b)
    while (b) {
      const temp = a
      a = b
      b = temp % b
    }
    return a
  }

  // 简化分数
  function simplifyFraction(numerator, denominator) {
    if (numerator === 0) return { num: 0, den: 1 }

    const g = gcd(numerator, denominator)
    let num = numerator / g
    let den = denominator / g

    if (den < 0) {
      num = -num
      den = -den
    }

    return { num, den }
  }

  // 构造分数（自动约分，den 永远 > 0）
  function makeFrac(n, d) {
    d = d || 1
    if (d === 0) return null
    if (d < 0) {
      n = -n
      d = -d
    }
    const numInt = Math.round(n)
    const denInt = Math.round(d)
    if (denInt === 0) return null
    const g = gcd(Math.abs(numInt), Math.abs(denInt))
    return { num: numInt / g, den: denInt / g }
  }

  // 分数减法
  function subF(a, b) {
    return makeFrac(a.num * b.den - b.num * a.den, a.den * b.den)
  }

  // 分数除法
  function divF(a, b) {
    return makeFrac(a.num * b.den, a.den * b.num)
  }

  // 分数取负
  function negF(a) {
    return { num: -a.num, den: a.den }
  }

  // 生成分数线
  function getFractionLine(len) {
    len = Math.min(len, 11)
    let line = ''
    for (let i = 0; i < len; i++) {
      line += '─'
    }
    return line
  }

  export default {
    data: {
      a: '',
      b: '',
      c: '',
      aFrac: { num: 1, den: 1 },
      bFrac: { num: 0, den: 1 },
      cFrac: { num: 0, den: 1 },
      showResult: false,
      showSimpleText: false,
      simpleText: '',
      showInteger: false,
      integerValue: '',
      showFraction: false,
      showNegativeSign: false,
      numeratorStr: '',
      denominatorStr: '',
      fractionLine: '',
    },

    onInit() {},

    handleChangeA(evt) {
      this.a = evt.value
      if (evt.isFraction) {
        this.aFrac = { num: evt.num, den: evt.den }
      } else {
        this.aFrac = makeFrac(parseFloat(evt.value), 1) || { num: 1, den: 1 }
      }
    },
    handleChangeB(evt) {
      this.b = evt.value
      if (evt.isFraction) {
        this.bFrac = { num: evt.num, den: evt.den }
      } else {
        this.bFrac = makeFrac(parseFloat(evt.value), 1) || { num: 0, den: 1 }
      }
    },
    handleChangeC(evt) {
      this.c = evt.value
      if (evt.isFraction) {
        this.cFrac = { num: evt.num, den: evt.den }
      } else {
        this.cFrac = makeFrac(parseFloat(evt.value), 1) || { num: 0, den: 1 }
      }
    },

    formatNumber(num) {
      if (!isFinite(num)) return 'Error'
      if (Math.abs(num) < 1e-10) return '0'
      const str = num.toPrecision(10)
      return parseFloat(str).toString()
    },

    solve() {
      const a = parseFloat(this.a)
      const b = parseFloat(this.b)
      const c = parseFloat(this.c)

      // 重置所有显示
      this.showResult = true
      this.showSimpleText = false
      this.showInteger = false
      this.showFraction = false

      if (isNaN(a) || isNaN(b) || isNaN(c)) {
        this.showSimpleText = true
        this.simpleText = '请输入有效的数字'
        return
      }

      if (a === 0) {
        this.showSimpleText = true
        if (b === c) {
          this.simpleText = '方程有无穷多解'
        } else {
          this.simpleText = '方程无解'
        }
        return
      }

      if (global.equationOutputMode === 'decimal') {
        this.showSimpleText = true
        this.simpleText = 'x = ' + this.formatNumber((c - b) / a)
        return
      }

      // 用精确分数算 c - b（避免 1/3 - 1/3 = 0.0000000004 的浮点误差）
      const num = subF(this.cFrac, this.bFrac)
      // x = (c - b) / a
      const frac = divF(num, this.aFrac)

      if (frac.den === 1) {
        this.showInteger = true
        this.integerValue = frac.num.toString()
      } else {
        this.showFraction = true
        this.showNegativeSign = frac.num < 0
        this.numeratorStr = Math.abs(frac.num).toString()
        this.denominatorStr = frac.den.toString()
        const maxLen = Math.max(
          this.numeratorStr.length,
          this.denominatorStr.length
        )
        this.fractionLine = getFractionLine(maxLen)
      }
    },
  }
</script>

<style lang="scss">
  @import './../../../../assets/styles/style.scss';

  .wrapper {
    width: 100%;
  }

  .content {
    width: 100%;
    flex-direction: column;
    padding: 0 2 * $size-factor 4 * $size-factor 2 * $size-factor;
  }

  .equation-form {
    width: 100%;
    text-align: center;
    font-size: 10 * $size-factor;
    color: #00ff99;
    font-family: monospace;
  }

  .input-row {
    width: 100%;
    @include flex-box-mixins(row, space-between, center);
    margin-top: 20px;
  }

  .input-label {
    font-size: 6 * $size-factor;
    color: white;
    width: 60px;
    margin: 0 2 * $size-factor;
  }

  .solve-btn {
    width: 100%;
    padding: 3 * $size-factor 0;
    background-color: $brand;
    border-radius: 8 * $size-factor;
    margin: 28px 0 20px 0;
    @include flex-box-mixins(row, center, center);

    &:active {
      opacity: 0.4;
    }
  }

  .solve-btn-text {
    font-size: 8 * $size-factor;
    color: white;
  }

  .result-box {
    width: 100%;
    padding: 4 * $size-factor;
    background-color: rgba(0, 255, 153, 0.15);
    border-radius: 8 * $size-factor;
    border-left-width: 3px;
    border-left-color: #00ff99;
    margin-bottom: 16px;
  }

  .result-content {
    display: flex;
    align-items: center;
  }

  .result-label {
    font-size: 6 * $size-factor;
    color: #00ff99;
    font-family: monospace;
    white-space: nowrap;
  }

  .result-value {
    font-size: 6 * $size-factor;
    color: #00ff99;
    font-family: monospace;
    margin-left: 16px;
  }

  .result-text {
    font-size: 6 * $size-factor;
    color: #00ff99;
    font-family: monospace;
  }

  .fraction-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-left: 16px;
  }

  .fraction-sign {
    font-size: 6 * $size-factor;
    color: #00ff99;
    font-family: monospace;
    margin-left: 16px;
    margin-right: -8px;
  }

  .fraction-numerator {
    font-size: 6 * $size-factor;
    color: #00ff99;
    font-family: monospace;
    padding-bottom: 2px;
    text-align: center;
  }

  .fraction-line {
    font-size: 6 * $size-factor;
    color: #00ff99;
    font-family: monospace;
    line-height: 2;
  }

  .fraction-denominator {
    font-size: 6 * $size-factor;
    color: #00ff99;
    font-family: monospace;
    padding-top: 2px;
    text-align: center;
  }
</style>

<import name="d-back" src="./../../../components/d-back"></import>

<template>
  <list class="wrapper" title="true">
    <list-item>
      <d-back value="{{ $t('graph.title') }}"></d-back>
    </list-item>

    <list-item class="content" disabled="{{ isLoading }}">
      <div show="{{ isLoading }}" class="loading-mask">
        <vw-loading size="100"></vw-loading>
        <text style="color: white; font-size: 38px; margin-top: 16px">{{ $t('graph.loading') }}</text>
      </div>
      <div show="{{ currentStep === 'input' }}" class="input-container">
        <div class="expr-tabs">
          <div
            class="expr-tab {{ activeExprIndex === 0 ? 'expr-tab-active' : '' }}"
            style="border-left-color: #00ff99; background-color: {{ activeExprIndex === 0 ? 'rgba(0, 255, 153, 0.3)' : 'rgba(0, 255, 153, 0.15)' }};"
            onclick="switchExpr(0)">
            <text style="color: {{ activeExprIndex === 0 ? '#00ff99' : '#ffffff' }};">f₁</text>
          </div>
          <div
            class="expr-tab {{ activeExprIndex === 1 ? 'expr-tab-active' : '' }}"
            show="{{ exprCount > 1 }}"
            style="border-left-color: #ff6b6b; background-color: {{ activeExprIndex === 1 ? 'rgba(255, 107, 107, 0.3)' : 'rgba(255, 107, 107, 0.15)' }};"
            onclick="switchExpr(1)">
            <text style="color: {{ activeExprIndex === 1 ? '#ff6b6b' : '#ffffff' }};">f₂</text>
          </div>
          <div
            class="expr-tab {{ activeExprIndex === 2 ? 'expr-tab-active' : '' }}"
            show="{{ exprCount > 2 }}"
            style="border-left-color: #4dabf7; background-color: {{ activeExprIndex === 2 ? 'rgba(77, 171, 247, 0.3)' : 'rgba(77, 171, 247, 0.15)' }};"
            onclick="switchExpr(2)">
            <text style="color: {{ activeExprIndex === 2 ? '#4dabf7' : '#ffffff' }};">f₃</text>
          </div>
          <div
            class="expr-tab expr-tab-add"
            show="{{ exprCount < 3 }}"
            onclick="addExpr">
            <text>+</text>
          </div>
        </div>
        <div class="input-display">
          <text class="y-label" style="color: {{ activeExprIndex === 0 ? '#00ff99' : (activeExprIndex === 1 ? '#ff6b6b' : '#4dabf7') }};">y =</text>
          <marquee if="{{ inputDisplayMode === 'marquee' }}" class="expression-text">
            {{ expressions[activeExprIndex] || $t('graph.input_hint') }}
          </marquee>
          <text if="{{ inputDisplayMode === 'static' }}" class="expression-static" lines="1">
            {{ displayExpr }}
          </text>
        </div>

        <div class="buttons-container">
          <div class="button-row">
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('7')">
              <text>7</text>
            </div>
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('8')">
              <text>8</text>
            </div>
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('9')">
              <text>9</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('sin(x)')">
              <text>sin</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('cos(x)')">
              <text>cos</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('tan(x)')">
              <text>tan</text>
            </div>
            <div class="btn btn-operator" onclick="inputChar('*')">
              <text>×</text>
            </div>
          </div>

          <div class="button-row">
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('4')">
              <text>4</text>
            </div>
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('5')">
              <text>5</text>
            </div>
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('6')">
              <text>6</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('sqrt(x)')">
              <text>√x</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('log(x)')">
              <text>log</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('ln(x)')">
              <text>ln</text>
            </div>
            <div class="btn btn-operator" onclick="inputChar('/')">
              <text>÷</text>
            </div>
          </div>

          <div class="button-row">
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('1')">
              <text>1</text>
            </div>
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('2')">
              <text>2</text>
            </div>
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('3')">
              <text>3</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('abs(x)')">
              <text>|x|</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('pi')">
              <text>π</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('exp(x)')">
              <text>e^x</text>
            </div>
            <div class="btn btn-operator" onclick="inputChar('+')">
              <text>+</text>
            </div>
          </div>

          <div class="button-row">
            <div
              class="btn btn-x"
              show="{{ !showAdvanced }}"
              onclick="inputChar('x')">
              <text>x</text>
            </div>
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('0')">
              <text>0</text>
            </div>
            <div
              class="btn btn-function"
              show="{{ !showAdvanced }}"
              onclick="inputChar('^')">
              <text>^</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('x^2')">
              <text>x²</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('(')">
              <text>(</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset(')')">
              <text>)</text>
            </div>
            <div class="btn btn-operator" onclick="inputChar('-')">
              <text>-</text>
            </div>
          </div>

          <div class="button-row">
            <div class="btn btn-function" onclick="clearExpression">
              <text>C</text>
            </div>
            <div class="btn btn-function" onclick="toggleAdvanced">
              <text>2nd</text>
            </div>
            <div class="btn btn-function" onclick="deleteChar">
              <text class="iconfont" style="font-size: 46px">&#xe62b;</text>
            </div>
            <div class="btn btn-draw" onclick="drawGraph">
              <text class="draw-btn-text">{{ $t('graph.draw') }}</text>
            </div>
          </div>
        </div>
      </div>

      <div if="{{ currentStep === 'result' }}" class="result-container">
        <div class="equation-display">
          <marquee
            class="equation-text"
            if="{{ expressions[0] }}"
            style="color: #00ff99"
            double-ended-shadow-color="#002617">
            f₁: y={{ expressions[0] }}
          </marquee>
          <marquee
            class="equation-text"
            if="{{ expressions[1] }}"
            style="color: #ff6b6b"
            double-ended-shadow-color="#002617">
            f₂: y={{ expressions[1] }}
          </marquee>
          <marquee
            class="equation-text"
            if="{{ expressions[2] }}"
            style="color: #4dabf7"
            double-ended-shadow-color="#002617">
            f₃: y={{ expressions[2] }}
          </marquee>
        </div>

        <div class="canvas-container">
          <canvas class="graph-canvas" id="graphCanvas"></canvas>
        </div>

        <div class="action-buttons">
          <div class="action-btn" onclick="zoomIn">
            <text class="iconfont" style="font-size: 36px">&#xe63b;</text>
          </div>
          <div class="action-btn" onclick="zoomOut">
            <text class="iconfont" style="font-size: 36px">&#xe63a;</text>
          </div>
          <div class="action-btn" onclick="resetView">
            <text class="iconfont" style="font-size: 36px">&#xe604;</text>
          </div>
          <div class="action-btn" onclick="backToInput">
            <text>{{ $t('graph.edit') }}</text>
          </div>
        </div>

        <div class="action-buttons">
          <div class="action-btn" onclick="moveLeft">
            <text class="iconfont" style="font-size: 36px">←</text>
          </div>
          <div class="action-btn" onclick="moveUp">
            <text class="iconfont" style="font-size: 36px">↑</text>
          </div>
          <div class="action-btn" onclick="moveDown">
            <text class="iconfont" style="font-size: 36px">↓</text>
          </div>
          <div class="action-btn" onclick="moveRight">
            <text class="iconfont" style="font-size: 36px">→</text>
          </div>
        </div>
      </div>
    </list-item>
  </list>
</template>

<script>
  const PI = 3.141592653589793
  const E = 2.718281828459045

  export default {
    data: {
      currentStep: 'input',
      expressions: ['', '', ''],
      activeExprIndex: 0,
      exprCount: 1,
      showAdvanced: false,
      canvasWidth: 400,
      canvasHeight: 400,
      scale: 20,
      offsetX: 0,
      offsetY: 0,
      drawTimerId: 0,
      isLoading: false,
      compiledFns: [null, null, null],
      inputDisplayMode: 'static',
      displayExpr: this.$t('graph.input_hint'),
      maxDisplayLen: 12,
    },

    onInit() {
      this.inputDisplayMode = global.inputDisplayMode || 'marquee'
      this.updateDisplayExpr()
    },

    onDestroy() {
      this.clearTimer()
    },

    onShow() {
      this.inputDisplayMode = global.inputDisplayMode || 'marquee'
      this.updateDisplayExpr()
      if (this.currentStep === 'result') {
        this.scheduleDraw()
      }
    },

    backToInput() {
      this.clearTimer()
      this.currentStep = 'input'
    },

    clearTimer() {
      if (this.drawTimerId) {
        clearTimeout(this.drawTimerId)
        this.drawTimerId = 0
      }
    },

    inputPreset(preset) {
      global.triggerHaptic()
      this.expressions[this.activeExprIndex] += preset
      this.updateDisplayExpr()
    },

    inputChar(char) {
      global.triggerHaptic()
      this.expressions[this.activeExprIndex] += char
      this.updateDisplayExpr()
    },

    deleteChar() {
      global.triggerHaptic()
      if (this.expressions[this.activeExprIndex].length > 0) {
        this.expressions[this.activeExprIndex] = this.expressions[
          this.activeExprIndex
        ].slice(0, -1)
      }
      this.updateDisplayExpr()
    },

    clearExpression() {
      global.triggerHaptic()
      this.expressions[this.activeExprIndex] = ''
      this.updateDisplayExpr()
    },

    switchExpr(index) {
      this.activeExprIndex = index
      this.updateDisplayExpr()
    },

    addExpr() {
      if (this.exprCount < 3) {
        this.exprCount++
        this.activeExprIndex = this.exprCount - 1
        this.updateDisplayExpr()
      }
    },

    // 静态文本模式下的显示字符串：保留末尾 token 完整性 + 前导省略号
    // 关键：不能把 cos/log/sin 这类函数名截成 "co" + "s"，要么完整保留要么整体删除
    updateDisplayExpr() {
      var expr = this.expressions[this.activeExprIndex] || ''
      if (expr.length === 0) {
        this.displayExpr = '输入函数'
        return
      }
      var maxLen = this.maxDisplayLen
      if (expr.length <= maxLen) {
        this.displayExpr = expr
        return
      }

      var tailLen = maxLen - 1
      var cutStart = expr.length - tailLen
      if (cutStart < 0) cutStart = 0

      var isLetter = function (c) {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
      }

      // 步骤 1：如果截断点落在字母-字母中间（函数名/变量名内部），
      //        往前跳到该 token 的开始位置
      while (cutStart > 0 && cutStart < expr.length) {
        if (isLetter(expr[cutStart]) && isLetter(expr[cutStart - 1])) {
          cutStart--
        } else {
          break
        }
      }

      // 步骤 2：如果跳到位置 0 仍在字母 token 内部（首 token 必然被部分截），
      //        直接跳到首 token 之后，让该 token 整体被省略号代替
      if (cutStart === 0 && isLetter(expr[0])) {
        for (var i = 1; i < expr.length; i++) {
          if (!isLetter(expr[i])) {
            cutStart = i
            break
          }
        }
      }

      this.displayExpr = '…' + expr.slice(cutStart)
    },

    toggleAdvanced() {
      global.triggerHaptic()
      this.showAdvanced = !this.showAdvanced
    },

    tokenize(expr) {
      var tokens = []
      var i = 0
      while (i < expr.length) {
        var ch = expr[i]
        if (ch === ' ') {
          i++
          continue
        }
        if ((ch >= '0' && ch <= '9') || ch === '.') {
          var num = ''
          while (
            i < expr.length &&
            ((expr[i] >= '0' && expr[i] <= '9') || expr[i] === '.')
          ) {
            num += expr[i]
            i++
          }
          tokens.push({ type: 'num', value: parseFloat(num) })
          continue
        }
        if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')) {
          var name = ''
          while (
            i < expr.length &&
            ((expr[i] >= 'a' && expr[i] <= 'z') ||
              (expr[i] >= 'A' && expr[i] <= 'Z'))
          ) {
            name += expr[i]
            i++
          }
          if (name === 'x') tokens.push({ type: 'var' })
          else if (name === 'pi') tokens.push({ type: 'num', value: PI })
          else if (name === 'e') tokens.push({ type: 'num', value: E })
          else tokens.push({ type: 'func', name: name })
          continue
        }
        if (
          ch === '+' ||
          ch === '-' ||
          ch === '*' ||
          ch === '/' ||
          ch === '^' ||
          ch === '(' ||
          ch === ')'
        ) {
          tokens.push({ type: 'op', value: ch })
          i++
          continue
        }
        i++
      }
      return tokens
    },

    parseExpr(tokens, pos, x) {
      var result = this.parseTerm(tokens, pos, x)
      if (result.err) return result
      pos = result.pos
      var val = result.value
      while (pos < tokens.length) {
        var t = tokens[pos]
        if (t.type !== 'op' || (t.value !== '+' && t.value !== '-')) break
        pos++
        var right = this.parseTerm(tokens, pos, x)
        if (right.err) return right
        pos = right.pos
        if (t.value === '+') val = val + right.value
        else val = val - right.value
      }
      return { value: val, pos: pos }
    },

    parseTerm(tokens, pos, x) {
      var result = this.parsePower(tokens, pos, x)
      if (result.err) return result
      pos = result.pos
      var val = result.value
      while (pos < tokens.length) {
        var t = tokens[pos]
        if (t.type !== 'op' || (t.value !== '*' && t.value !== '/')) break
        pos++
        var right = this.parsePower(tokens, pos, x)
        if (right.err) return right
        pos = right.pos
        if (t.value === '*') val = val * right.value
        else val = val / right.value
      }
      return { value: val, pos: pos }
    },

    parsePower(tokens, pos, x) {
      var result = this.parseUnary(tokens, pos, x)
      if (result.err) return result
      pos = result.pos
      var val = result.value
      if (
        pos < tokens.length &&
        tokens[pos].type === 'op' &&
        tokens[pos].value === '^'
      ) {
        pos++
        var right = this.parsePower(tokens, pos, x)
        if (right.err) return right
        return { value: Math.pow(val, right.value), pos: right.pos }
      }
      return { value: val, pos: pos }
    },

    parseUnary(tokens, pos, x) {
      if (
        pos < tokens.length &&
        tokens[pos].type === 'op' &&
        tokens[pos].value === '-'
      ) {
        pos++
        var result = this.parseAtom(tokens, pos, x)
        if (result.err) return result
        return { value: -result.value, pos: result.pos }
      }
      return this.parseAtom(tokens, pos, x)
    },

    parseAtom(tokens, pos, x) {
      if (pos >= tokens.length) return { err: true, pos: pos }
      var t = tokens[pos]
      if (t.type === 'num') return { value: t.value, pos: pos + 1 }
      if (t.type === 'var') return { value: x, pos: pos + 1 }
      if (t.type === 'func') {
        var name = t.name
        pos++
        if (
          pos >= tokens.length ||
          tokens[pos].type !== 'op' ||
          tokens[pos].value !== '('
        ) {
          return { err: true, pos: pos }
        }
        pos++
        var result = this.parseExpr(tokens, pos, x)
        if (result.err) return result
        pos = result.pos
        if (
          pos >= tokens.length ||
          tokens[pos].type !== 'op' ||
          tokens[pos].value !== ')'
        ) {
          return { err: true, pos: pos }
        }
        pos++
        var arg = result.value
        var val
        if (name === 'sin') val = Math.sin(arg)
        else if (name === 'cos') val = Math.cos(arg)
        else if (name === 'tan') val = Math.tan(arg)
        else if (name === 'sqrt') val = Math.sqrt(arg)
        else if (name === 'log') val = Math.log(arg) / Math.log(10)
        else if (name === 'ln') val = Math.log(arg)
        else if (name === 'exp') val = Math.exp(arg)
        else if (name === 'abs') val = Math.abs(arg)
        else return { err: true, pos: pos }
        return { value: val, pos: pos }
      }
      if (t.type === 'op' && t.value === '(') {
        pos++
        var result = this.parseExpr(tokens, pos, x)
        if (result.err) return result
        pos = result.pos
        if (
          pos >= tokens.length ||
          tokens[pos].type !== 'op' ||
          tokens[pos].value !== ')'
        ) {
          return { err: true, pos: pos }
        }
        return { value: result.value, pos: pos + 1 }
      }
      return { err: true, pos: pos }
    },

    preprocessExpression(expr) {
      var result = ''
      var functions = ['sin', 'cos', 'tan', 'sqrt', 'log', 'ln', 'exp', 'abs']

      for (var i = 0; i < expr.length; i++) {
        var curr = expr[i]

        if (i > 0) {
          var prev = expr[i - 1]

          var prevIsNum = (prev >= '0' && prev <= '9') || prev === '.'
          var prevIsClose = prev === ')'
          var prevIsLetter =
            (prev >= 'a' && prev <= 'z') || (prev >= 'A' && prev <= 'Z')

          var currIsLetter =
            (curr >= 'a' && curr <= 'z') || (curr >= 'A' && curr <= 'Z')
          var currIsNum = (curr >= '0' && curr <= '9') || curr === '.'
          var currIsOpen = curr === '('

          if (prevIsNum && (currIsLetter || currIsOpen)) {
            result += '*'
          } else if (prevIsClose && (currIsNum || currIsLetter || currIsOpen)) {
            result += '*'
          } else if (prevIsLetter && currIsOpen) {
            var funcName = ''
            var j = i - 1
            while (
              j >= 0 &&
              ((expr[j] >= 'a' && expr[j] <= 'z') ||
                (expr[j] >= 'A' && expr[j] <= 'Z'))
            ) {
              funcName = expr[j] + funcName
              j--
            }
            if (functions.indexOf(funcName) === -1) {
              result += '*'
            }
          }
        }

        result += curr
      }
      return result
    },

    evalExpr(expr, x) {
      // 保留旧入口兼容：未编译时回退到旧实现
      var processed = this.preprocessExpression(expr)
      var tokens = this.tokenize(processed)
      if (tokens.length === 0) return 0 / 0
      var result = this.parseExpr(tokens, 0, x)
      if (result.err) return 0 / 0
      return result.value
    },

    // 预编译：把表达式解析为求值闭包，后续每像素只跑一次函数调用
    compileExpr(expr) {
      if (!expr) return null
      var processed = this.preprocessExpression(expr)
      var tokens = this.tokenize(processed)
      if (tokens.length === 0) return null
      var self = this
      return function (x) {
        var result = self.parseExpr(tokens, 0, x)
        if (result.err) return 0 / 0
        return result.value
      }
    },

    compileAll() {
      for (var i = 0; i < this.expressions.length; i++) {
        this.compiledFns[i] = this.compileExpr(this.expressions[i])
      }
    },

    drawGraph() {
      var hasExpr = false
      for (var i = 0; i < this.expressions.length; i++) {
        if (this.expressions[i]) hasExpr = true
      }
      if (!hasExpr) return
      this.clearTimer()
      this.isLoading = true
      this.currentStep = 'result'
      // 预编译所有表达式，避免每帧重复词法/语法分析
      this.compileAll()
      this.scheduleDraw()
    },

    scheduleDraw() {
      this.clearTimer()
      var self = this
      this.drawTimerId = setTimeout(function () {
        self.drawTimerId = 0
        self.doDrawGraph()
      }, 100)
    },

    doDrawGraph() {
      var canvas = this.$element('graphCanvas')
      if (!canvas) return

      // 使用 1x 物理像素，避免快应用 webview 高 DPI canvas 不稳定 / 性能差
      canvas.width = this.canvasWidth
      canvas.height = this.canvasHeight

      var ctx = canvas.getContext('2d')
      if (!ctx) return

      var width = this.canvasWidth
      var height = this.canvasHeight
      var centerX = width / 2 + this.offsetX
      var centerY = height / 2 + this.offsetY
      var scale = this.scale

      ctx.clearRect(0, 0, width, height)

      this.drawGridAndAxes(ctx, width, height, centerX, centerY, scale)
      this.drawCurves(ctx, width, height, centerX, centerY, scale)

      this.isLoading = false
    },

    // 绘制网格、坐标轴、刻度文字（纯静态，可独立刷新区分）
    drawGridAndAxes(ctx, width, height, centerX, centerY, scale) {
      var targetStep = 80 / scale
      var pow10 = Math.pow(10, Math.floor(Math.log(targetStep) / Math.log(10)))
      var raw = targetStep / pow10
      var step
      if (raw < 1.5) step = 1 * pow10
      else if (raw < 3.5) step = 2 * pow10
      else if (raw < 7.5) step = 5 * pow10
      else step = 10 * pow10
      var decimals = Math.max(0, -Math.floor(Math.log(step) / Math.log(10)))
      var stepRound = Math.pow(10, -decimals)
      var labelFormat = function (n) {
        if (decimals === 0) return n.toString()
        var rounded = Math.round(n / stepRound) * stepRound
        var pow = Math.pow(10, decimals)
        var absR = Math.abs(rounded)
        var intPart = Math.floor(absR)
        var fracPart = Math.round((absR - intPart) * pow)
        if (fracPart === pow) {
          intPart += 1
          fracPart = 0
        }
        var sign = rounded < 0 ? '-' : ''
        var fracStr = String(fracPart)
        while (fracStr.length < decimals) fracStr = '0' + fracStr
        return sign + String(intPart) + '.' + fracStr
      }

      ctx.strokeStyle = 'rgba(255, 255, 255, 0.1)'
      ctx.lineWidth = 1

      var xLeft = -centerX / scale
      var xRight = (width - centerX) / scale
      var yBottom = -(height - centerY) / scale
      var yTop = centerY / scale

      var xStart = Math.ceil(xLeft / step) * step
      for (var i = xStart; i <= xRight + 1e-9; i += step) {
        var xv = centerX + i * scale
        ctx.beginPath()
        ctx.moveTo(xv, 0)
        ctx.lineTo(xv, height)
        ctx.stroke()
      }
      var yStart = Math.ceil(yBottom / step) * step
      for (var i = yStart; i <= yTop + 1e-9; i += step) {
        var yv = centerY - i * scale
        ctx.beginPath()
        ctx.moveTo(0, yv)
        ctx.lineTo(width, yv)
        ctx.stroke()
      }

      ctx.strokeStyle = 'rgba(255, 255, 255, 0.6)'
      ctx.lineWidth = 2
      ctx.beginPath()
      ctx.moveTo(0, centerY)
      ctx.lineTo(width, centerY)
      ctx.stroke()
      ctx.beginPath()
      ctx.moveTo(centerX, 0)
      ctx.lineTo(centerX, height)
      ctx.stroke()

      ctx.fillStyle = 'rgba(255, 255, 255, 0.8)'
      ctx.font = '12px sans-serif'
      ctx.textAlign = 'center'
      ctx.textBaseline = 'top'
      for (var i = xStart; i <= xRight + 1e-9; i += step) {
        if (Math.abs(i) > 1e-9) {
          var xv = centerX + i * scale
          ctx.fillText(labelFormat(i), xv, centerY + 4)
        }
      }

      ctx.textAlign = 'right'
      ctx.textBaseline = 'middle'
      for (var i = yStart; i <= yTop + 1e-9; i += step) {
        if (Math.abs(i) > 1e-9) {
          var yv = centerY - i * scale
          ctx.fillText(labelFormat(i), centerX - 4, yv)
        }
      }
    },

    // 绘制函数曲线：使用预编译闭包，加入跳变检测与自适应降采样
    drawCurves(ctx, width, height, centerX, centerY, scale) {
      var colors = ['#00ff99', '#ff6b6b', '#4dabf7']
      var fns = this.compiledFns
      // 跳变阈值：相邻样本 y 差超过半屏视为不连续
      var jumpThreshold = (height / scale) * 0.5

      // 统计活动函数数量，决定采样步长：3 个函数时减半采样，避免主线程卡死
      var activeCount = 0
      for (var i = 0; i < fns.length; i++) {
        if (fns[i]) activeCount++
      }
      var sampleStep = activeCount >= 3 ? 2 : 1

      // 单条曲线失败不影响其他曲线与整体渲染
      for (var ei = 0; ei < fns.length; ei++) {
        var fn = fns[ei]
        if (!fn) continue
        try {
          this.drawSingleCurve(
            ctx,
            width,
            height,
            centerX,
            centerY,
            scale,
            fn,
            colors[ei],
            sampleStep,
            jumpThreshold
          )
        } catch (e) {
          // 静默跳过出错曲线
        }
      }
    },

    drawSingleCurve(
      ctx,
      width,
      height,
      centerX,
      centerY,
      scale,
      fn,
      color,
      sampleStep,
      jumpThreshold
    ) {
      ctx.strokeStyle = color
      ctx.lineWidth = 2
      ctx.beginPath()

      var started = false
      var lastY = 0 / 0
      var screenY

      for (var px = 0; px < width; px += sampleStep) {
        var cx = (px - centerX) / scale
        var y = fn(cx)

        // 跳过 NaN / Infinity
        if (y !== y || y === 1 / 0 || y === -1 / 0) {
          started = false
          lastY = 0 / 0
          continue
        }

        screenY = centerY - y * scale

        // 越界直接跳过
        if (screenY < -100 || screenY > height + 100) {
          started = false
          lastY = 0 / 0
          continue
        }

        // 跳变检测：y 值剧变说明函数不连续，抬笔重起一段
        if (started && Math.abs(y - lastY) > jumpThreshold) {
          started = false
        }

        if (!started) {
          ctx.moveTo(px, screenY)
          started = true
        } else {
          ctx.lineTo(px, screenY)
        }
        lastY = y
      }

      ctx.stroke()
    },

    zoomIn() {
      this.isLoading = true
      var newScale = this.scale * 1.5
      // 记录当前屏幕中心对应的数学坐标，缩放后保持中心不变
      var cx = -this.offsetX / this.scale
      var cy = this.offsetY / this.scale
      this.scale = newScale
      this.offsetX = -cx * newScale
      this.offsetY = cy * newScale
      this.scheduleDraw()
    },

    zoomOut() {
      this.isLoading = true
      var newScale = this.scale / 1.5
      var cx = -this.offsetX / this.scale
      var cy = this.offsetY / this.scale
      this.scale = newScale
      this.offsetX = -cx * newScale
      this.offsetY = cy * newScale
      this.scheduleDraw()
    },

    resetView() {
      this.isLoading = true
      this.scale = 20
      this.offsetX = 0
      this.offsetY = 0
      this.scheduleDraw()
    },

    moveLeft() {
      this.isLoading = true
      this.offsetX += this.canvasWidth * 0.25
      this.scheduleDraw()
    },

    moveRight() {
      this.isLoading = true
      this.offsetX -= this.canvasWidth * 0.25
      this.scheduleDraw()
    },

    moveUp() {
      this.isLoading = true
      this.offsetY += this.canvasHeight * 0.25
      this.scheduleDraw()
    },

    moveDown() {
      this.isLoading = true
      this.offsetY -= this.canvasHeight * 0.25
      this.scheduleDraw()
    },
  }
</script>

<style lang="scss">
  @import './../../../assets/styles/style.scss';

  .wrapper {
    width: 100%;
  }

  .content {
    width: 100%;
    flex-direction: column;
    padding: 0 2 * $size-factor 4 * $size-factor 2 * $size-factor;
    margin-top: 6px;
    margin-bottom: 30px;

    @media (device: watch-round) {
      margin-bottom: 50px;
    }
  }

  .loading-mask {
    position: fixed;
    width: 100%;
    top: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0.8);
    @include flex-box-mixins(column, center, center);
  }

  .input-container {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .input-display {
    width: 100%;
    padding: 3 * $size-factor;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 8 * $size-factor;
    margin-bottom: 3 * $size-factor;
    display: flex;
    align-items: center;

    .y-label {
      font-size: 8 * $size-factor;
      color: $success;
      font-family: monospace;
      margin-left: 10px;
      margin-right: 4 * $size-factor;
    }

    .expression-text {
      flex: 1;
      font-size: 8 * $size-factor;
      color: $white;
      font-family: monospace;
    }

    .expression-static {
      // 静态显示：JS 已截取末尾 N 个字符 + 前导省略号
      // 这里用 text-align: left 让省略号在左、完整内容在右
      flex: 1;
      font-size: 8 * $size-factor;
      color: $white;
      font-family: monospace;
      text-align: left;
    }
  }

  .buttons-container {
    width: 100%;
    @include flex-box-mixins(column, space-between, space-between);
  }

  .button-row {
    width: 100%;
    @include flex-box-mixins(row, space-between, center);
    gap: 8px;
  }

  .btn {
    flex: 1;
    height: 72px;
    background-color: $card-bg;
    border-radius: 8 * $size-factor;
    @include flex-box-mixins(row, center, center);

    text {
      font-size: 7 * $size-factor;
      color: $white;
    }

    &:active {
      opacity: 0.4;
    }

    @media (device: watch-round) {
      height: 60px;
      border-radius: 30px;

      text {
        font-size: 32px;
      }
    }
  }

  .btn-number {
    background-color: $input-bg;
  }

  .btn-operator {
    background-color: $brand;
  }

  .btn-function {
    background-color: $light-brand;

    text {
      color: $brand;
      font-weight: 600;
    }
  }

  .btn-scientific {
    background-color: rgba(25, 118, 210, 0.2);

    text {
      color: #1976d2;
      font-weight: 500;
    }
  }

  .btn-equals {
    background-color: $brand;

    text {
      font-size: 7 * $size-factor;
      font-weight: 600;
      color: $white;
    }
  }

  .btn-x {
    background-color: rgba(255, 193, 7, 0.25);

    text {
      color: #ffc107;
      font-weight: 700;
      font-size: 8 * $size-factor;
    }
  }

  .btn-draw {
    background-color: rgba(233, 30, 99, 0.3);

    text {
      color: #e91e63;
      font-size: 7 * $size-factor;
      font-weight: 700;
    }
  }

  .result-container {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .expr-tabs {
    width: 100%;
    margin-left: 10px;
    margin-bottom: 12px;
  }

  .expr-tab {
    padding: 8px 26px;
    background-color: $card-bg;
    border-radius: 8 * $size-factor;
    margin-right: 12px;

    text {
      font-size: 7 * $size-factor;
      font-weight: 700;
    }

    &:active {
      opacity: 0.4;
    }
  }

  .expr-tab-active {
    background-color: $success-active;

    text {
      color: $success;
    }
  }

  .expr-tab-add {
    padding: 8px 18px;
    background-color: rgba(0, 255, 153, 0.2);
    border-radius: 6 * $size-factor;
    margin-right: 8px;

    text {
      font-size: 6 * $size-factor;
      font-weight: 700;
      color: $success;
    }

    &:active {
      opacity: 0.4;
    }
  }

  .equation-display {
    width: 100%;
    padding: 20px 36px;
    background-color: $success-bg;
    border-radius: 8 * $size-factor;
    margin-bottom: 20px;
    flex-direction: column;

    .equation-text {
      font-size: 8 * $size-factor;
    }
  }

  .canvas-container {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 4 * $size-factor;
  }

  .graph-canvas {
    width: 400px;
    height: 400px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 8 * $size-factor;
  }

  .action-buttons {
    width: 100%;
    justify-content: space-between;
    margin-top: 8px;

    .action-btn {
      padding: 3 * $size-factor 0;
      background-color: $card-bg;
      border-radius: 8 * $size-factor;
      align-items: center;
      justify-content: center;
      height: 70px;
      width: 106px;

      &:active {
        opacity: 0.4;
      }

      text {
        font-size: 7 * $size-factor;
        color: $white;
      }
    }
  }
</style>

<import name="d-back" src="./../../../components/d-back"></import>

<template>
  <list class="wrapper" title="true">
    <list-item>
      <d-back value="函数绘图"></d-back>
    </list-item>

    <list-item class="content">
      <!-- 输入页面 -->
      <div show="{{ currentStep === 'input' }}" class="input-container">
        <div class="input-display">
          <text class="y-label">y =</text>
          <marquee class="expression-text">
            {{ expression || '输入函数' }}
          </marquee>
        </div>

        <div class="buttons-container">
          <!-- 科学函数行 - 仅 2nd 模式下显示 -->
          <div class="button-row" show="{{ showAdvanced }}">
            <div class="btn btn-scientific" onclick="inputPreset('sin')">
              <text>sin</text>
            </div>
            <div class="btn btn-scientific" onclick="inputPreset('cos')">
              <text>cos</text>
            </div>
            <div class="btn btn-scientific" onclick="inputPreset('tan')">
              <text>tan</text>
            </div>
            <div class="btn btn-scientific" onclick="inputPreset('x^2')">
              <text>x²</text>
            </div>
          </div>

          <div class="button-row" show="{{ showAdvanced }}">
            <div class="btn btn-scientific" onclick="inputPreset('sqrt(x)')">
              <text>√x</text>
            </div>
            <div class="btn btn-scientific" onclick="inputPreset('log(x)')">
              <text>log</text>
            </div>
            <div class="btn btn-scientific" onclick="inputPreset('ln(x)')">
              <text>ln</text>
            </div>
            <div class="btn btn-scientific" onclick="inputPreset('exp(x)')">
              <text>e^x</text>
            </div>
          </div>

          <div class="button-row" show="{{ showAdvanced }}">
            <div class="btn btn-scientific" onclick="inputPreset('abs(x)')">
              <text>|x|</text>
            </div>
            <div class="btn btn-scientific" onclick="inputPreset('pi')">
              <text>π</text>
            </div>
            <div class="btn btn-scientific" onclick="inputPreset('(')">
              <text>(</text>
            </div>
            <div class="btn btn-scientific" onclick="inputPreset(')')">
              <text>)</text>
            </div>
          </div>

          <!-- 数字和操作符行 - 默认模式下显示 -->
          <div class="button-row" show="{{ !showAdvanced }}">
            <div class="btn btn-number" onclick="inputChar('7')">
              <text>7</text>
            </div>
            <div class="btn btn-number" onclick="inputChar('8')">
              <text>8</text>
            </div>
            <div class="btn btn-number" onclick="inputChar('9')">
              <text>9</text>
            </div>
            <div class="btn btn-operator" onclick="inputChar('*')">
              <text>×</text>
            </div>
          </div>

          <div class="button-row" show="{{ !showAdvanced }}">
            <div class="btn btn-number" onclick="inputChar('4')">
              <text>4</text>
            </div>
            <div class="btn btn-number" onclick="inputChar('5')">
              <text>5</text>
            </div>
            <div class="btn btn-number" onclick="inputChar('6')">
              <text>6</text>
            </div>
            <div class="btn btn-operator" onclick="inputChar('/')">
              <text>÷</text>
            </div>
          </div>

          <div class="button-row" show="{{ !showAdvanced }}">
            <div class="btn btn-number" onclick="inputChar('1')">
              <text>1</text>
            </div>
            <div class="btn btn-number" onclick="inputChar('2')">
              <text>2</text>
            </div>
            <div class="btn btn-number" onclick="inputChar('3')">
              <text>3</text>
            </div>
            <div class="btn btn-operator" onclick="inputChar('+')">
              <text>+</text>
            </div>
          </div>

          <div class="button-row">
            <div class="btn btn-x" onclick="inputChar('x')">
              <text>x</text>
            </div>
            <div class="btn btn-number" onclick="inputChar('0')">
              <text>0</text>
            </div>
            <div class="btn btn-function" onclick="inputChar('^')">
              <text>^</text>
            </div>
            <div class="btn btn-operator" onclick="inputChar('-')">
              <text>-</text>
            </div>
          </div>

          <div class="button-row">
            <div class="btn btn-function" onclick="clearExpression">
              <text>C</text>
            </div>
            <div class="btn btn-function" onclick="toggleAdvanced">
              <text>2nd</text>
            </div>
            <div class="btn btn-function" onclick="deleteChar">
              <image
                src="./../../../assets/images/backspace.svg"
                width="48px"></image>
            </div>
            <div class="btn btn-draw" onclick="drawGraph">
              <text class="draw-btn-text">绘图</text>
            </div>
          </div>
        </div>
      </div>

      <!-- 绘图结果页面 -->
      <div if="{{ currentStep === 'result' }}" class="result-container">
        <div class="equation-display">
          <text class="equation-text">y = {{ expression }}</text>
        </div>

        <div class="canvas-container">
          <canvas class="graph-canvas" id="graphCanvas"></canvas>
        </div>

        <div class="action-buttons">
          <div class="action-btn" onclick="zoomIn">
            <text>⊕</text>
          </div>
          <div class="action-btn" onclick="zoomOut">
            <text>⊖</text>
          </div>
          <div class="action-btn" onclick="resetView">
            <text>⟲</text>
          </div>
          <div class="action-btn" onclick="backToInput">
            <text>编辑</text>
          </div>
        </div>
      </div>
    </list-item>
  </list>
</template>

<script>
  const PI = 3.141592653589793
  const E = 2.718281828459045

  export default {
    data: {
      currentStep: 'input',
      expression: '',
      showAdvanced: false,
      canvasWidth: 350,
      canvasHeight: 350,
      scale: 20,
      drawTimerId: 0,
    },

    onInit() {},

    onDestroy() {
      this.clearTimer()
    },

    onShow() {
      if (this.currentStep === 'result') {
        this.scheduleDraw()
      }
    },

    backToInput() {
      this.clearTimer()
      this.currentStep = 'input'
    },

    clearTimer() {
      if (this.drawTimerId) {
        clearTimeout(this.drawTimerId)
        this.drawTimerId = 0
      }
    },

    inputPreset(preset) {
      this.expression += preset
    },

    inputChar(char) {
      this.expression += char
    },

    deleteChar() {
      if (this.expression.length > 0) {
        this.expression = this.expression.slice(0, -1)
      }
    },

    clearExpression() {
      this.expression = ''
    },

    toggleAdvanced() {
      this.showAdvanced = !this.showAdvanced
    },

    tokenize(expr) {
      var tokens = []
      var i = 0
      while (i < expr.length) {
        var ch = expr[i]
        if (ch === ' ') {
          i++
          continue
        }
        if ((ch >= '0' && ch <= '9') || ch === '.') {
          var num = ''
          while (
            i < expr.length &&
            ((expr[i] >= '0' && expr[i] <= '9') || expr[i] === '.')
          ) {
            num += expr[i]
            i++
          }
          tokens.push({ type: 'num', value: parseFloat(num) })
          continue
        }
        if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')) {
          var name = ''
          while (
            i < expr.length &&
            ((expr[i] >= 'a' && expr[i] <= 'z') ||
              (expr[i] >= 'A' && expr[i] <= 'Z'))
          ) {
            name += expr[i]
            i++
          }
          if (name === 'x') tokens.push({ type: 'var' })
          else if (name === 'pi') tokens.push({ type: 'num', value: PI })
          else if (name === 'e') tokens.push({ type: 'num', value: E })
          else tokens.push({ type: 'func', name: name })
          continue
        }
        if (
          ch === '+' ||
          ch === '-' ||
          ch === '*' ||
          ch === '/' ||
          ch === '^' ||
          ch === '(' ||
          ch === ')'
        ) {
          tokens.push({ type: 'op', value: ch })
          i++
          continue
        }
        i++
      }
      return tokens
    },

    parseExpr(tokens, pos, x) {
      var result = this.parseTerm(tokens, pos, x)
      if (result.err) return result
      pos = result.pos
      var val = result.value
      while (pos < tokens.length) {
        var t = tokens[pos]
        if (t.type !== 'op' || (t.value !== '+' && t.value !== '-')) break
        pos++
        var right = this.parseTerm(tokens, pos, x)
        if (right.err) return right
        pos = right.pos
        if (t.value === '+') val = val + right.value
        else val = val - right.value
      }
      return { value: val, pos: pos }
    },

    parseTerm(tokens, pos, x) {
      var result = this.parsePower(tokens, pos, x)
      if (result.err) return result
      pos = result.pos
      var val = result.value
      while (pos < tokens.length) {
        var t = tokens[pos]
        if (t.type !== 'op' || (t.value !== '*' && t.value !== '/')) break
        pos++
        var right = this.parsePower(tokens, pos, x)
        if (right.err) return right
        pos = right.pos
        if (t.value === '*') val = val * right.value
        else val = val / right.value
      }
      return { value: val, pos: pos }
    },

    parsePower(tokens, pos, x) {
      var result = this.parseUnary(tokens, pos, x)
      if (result.err) return result
      pos = result.pos
      var val = result.value
      if (
        pos < tokens.length &&
        tokens[pos].type === 'op' &&
        tokens[pos].value === '^'
      ) {
        pos++
        var right = this.parsePower(tokens, pos, x)
        if (right.err) return right
        return { value: Math.pow(val, right.value), pos: right.pos }
      }
      return { value: val, pos: pos }
    },

    parseUnary(tokens, pos, x) {
      if (
        pos < tokens.length &&
        tokens[pos].type === 'op' &&
        tokens[pos].value === '-'
      ) {
        pos++
        var result = this.parseAtom(tokens, pos, x)
        if (result.err) return result
        return { value: -result.value, pos: result.pos }
      }
      return this.parseAtom(tokens, pos, x)
    },

    parseAtom(tokens, pos, x) {
      if (pos >= tokens.length) return { err: true, pos: pos }
      var t = tokens[pos]
      if (t.type === 'num') return { value: t.value, pos: pos + 1 }
      if (t.type === 'var') return { value: x, pos: pos + 1 }
      if (t.type === 'func') {
        var name = t.name
        pos++
        if (
          pos >= tokens.length ||
          tokens[pos].type !== 'op' ||
          tokens[pos].value !== '('
        ) {
          return { err: true, pos: pos }
        }
        pos++
        var result = this.parseExpr(tokens, pos, x)
        if (result.err) return result
        pos = result.pos
        if (
          pos >= tokens.length ||
          tokens[pos].type !== 'op' ||
          tokens[pos].value !== ')'
        ) {
          return { err: true, pos: pos }
        }
        pos++
        var arg = result.value
        var val
        if (name === 'sin') val = Math.sin(arg)
        else if (name === 'cos') val = Math.cos(arg)
        else if (name === 'tan') val = Math.tan(arg)
        else if (name === 'sqrt') val = Math.sqrt(arg)
        else if (name === 'log') val = Math.log(arg) / Math.log(10)
        else if (name === 'ln') val = Math.log(arg)
        else if (name === 'exp') val = Math.exp(arg)
        else if (name === 'abs') val = Math.abs(arg)
        else return { err: true, pos: pos }
        return { value: val, pos: pos }
      }
      if (t.type === 'op' && t.value === '(') {
        pos++
        var result = this.parseExpr(tokens, pos, x)
        if (result.err) return result
        pos = result.pos
        if (
          pos >= tokens.length ||
          tokens[pos].type !== 'op' ||
          tokens[pos].value !== ')'
        ) {
          return { err: true, pos: pos }
        }
        return { value: result.value, pos: pos + 1 }
      }
      return { err: true, pos: pos }
    },

    evalExpr(expr, x) {
      if (!expr) return 0 / 0
      var tokens = this.tokenize(expr)
      if (tokens.length === 0) return 0 / 0
      var result = this.parseExpr(tokens, 0, x)
      if (result.err) return 0 / 0
      return result.value
    },

    drawGraph() {
      if (!this.expression) return
      this.clearTimer()
      this.currentStep = 'result'
      this.scheduleDraw()
    },

    scheduleDraw() {
      this.clearTimer()
      var self = this
      this.drawTimerId = setTimeout(function () {
        self.drawTimerId = 0
        self.doDrawGraph()
      }, 100)
    },

    doDrawGraph() {
      var canvas = this.$element('graphCanvas')
      if (!canvas) return

      canvas.width = this.canvasWidth * 2
      canvas.height = this.canvasHeight * 2

      var ctx = canvas.getContext('2d')
      if (!ctx) return
      ctx.scale(2, 2)

      var width = this.canvasWidth
      var height = this.canvasHeight
      var centerX = width / 2
      var centerY = height / 2
      var scale = this.scale

      ctx.clearRect(0, 0, width, height)

      ctx.strokeStyle = 'rgba(255, 255, 255, 0.1)'
      ctx.lineWidth = 1
      for (var i = 0; i <= width; i += scale) {
        ctx.beginPath()
        ctx.moveTo(i, 0)
        ctx.lineTo(i, height)
        ctx.stroke()
      }
      for (var i = 0; i <= height; i += scale) {
        ctx.beginPath()
        ctx.moveTo(0, i)
        ctx.lineTo(width, i)
        ctx.stroke()
      }

      ctx.strokeStyle = 'rgba(255, 255, 255, 0.6)'
      ctx.lineWidth = 2
      ctx.beginPath()
      ctx.moveTo(0, centerY)
      ctx.lineTo(width, centerY)
      ctx.stroke()
      ctx.beginPath()
      ctx.moveTo(centerX, 0)
      ctx.lineTo(centerX, height)
      ctx.stroke()

      ctx.fillStyle = 'rgba(255, 255, 255, 0.8)'
      ctx.font = '12px sans-serif'
      ctx.textAlign = 'center'
      ctx.textBaseline = 'top'
      for (var i = -8; i <= 8; i++) {
        if (i !== 0) {
          var xv = centerX + i * scale
          ctx.fillText(i.toString(), xv, centerY + 4)
        }
      }
      ctx.textAlign = 'right'
      ctx.textBaseline = 'middle'
      for (var i = -8; i <= 8; i++) {
        if (i !== 0) {
          var yv = centerY - i * scale
          ctx.fillText(i.toString(), centerX - 4, yv)
        }
      }

      ctx.strokeStyle = '#00ff99'
      ctx.lineWidth = 2
      ctx.beginPath()
      var started = false

      for (var px = 0; px < width; px++) {
        var cx = (px - centerX) / scale
        var y = this.evalExpr(this.expression, cx)

        if (y !== y || y === 1 / 0 || y === -1 / 0) {
          started = false
          continue
        }

        var screenY = centerY - y * scale

        if (screenY < -100 || screenY > height + 100) {
          started = false
          continue
        }

        if (!started) {
          ctx.moveTo(px, screenY)
          started = true
        } else {
          ctx.lineTo(px, screenY)
        }
      }

      ctx.stroke()
    },

    zoomIn() {
      this.scale = Math.min(this.scale * 1.5, 80)
      this.doDrawGraph()
    },

    zoomOut() {
      this.scale = Math.max(this.scale / 1.5, 5)
      this.doDrawGraph()
    },

    resetView() {
      this.scale = 20
      this.doDrawGraph()
    },
  }
</script>

<style lang="scss">
  @import './../../../assets/styles/style.scss';

  .wrapper {
    width: 100%;
  }

  .content {
    width: 100%;
    flex-direction: column;
    padding: 0 2 * $size-factor 4 * $size-factor 2 * $size-factor;
  }

  .input-container {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .input-display {
    width: 100%;
    padding: 3 * $size-factor;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 8 * $size-factor;
    margin-bottom: 3 * $size-factor;
    display: flex;
    align-items: center;

    .y-label {
      font-size: 8 * $size-factor;
      color: #00ff99;
      font-family: monospace;
      margin-right: 2 * $size-factor;
    }

    .expression-text {
      flex: 1;
      font-size: 8 * $size-factor;
      color: $white;
      font-family: monospace;
    }
  }

  .buttons-container {
    width: 100%;
    @include flex-box-mixins(column, space-between, space-between);
  }

  .button-row {
    width: 100%;
    @include flex-box-mixins(row, space-between, center);
  }

  .btn {
    flex: 1;
    height: 72px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 8 * $size-factor;
    @include flex-box-mixins(row, center, center);

    text {
      font-size: 7 * $size-factor;
      color: $white;
    }

    &:active {
      opacity: 0.4;
    }

    @media (device: watch-round) {
      height: 60px;
      border-radius: 30px;

      text {
        font-size: 32px;
      }
    }
  }

  .btn-number {
    background-color: rgba(255, 255, 255, 0.15);
  }

  .btn-operator {
    background-color: $brand;
  }

  .btn-function {
    background-color: rgba(9, 186, 7, 0.2);

    text {
      color: $brand;
      font-weight: 600;
    }
  }

  .btn-scientific {
    background-color: rgba(25, 118, 210, 0.2);

    text {
      color: #1976d2;
      font-weight: 500;
    }
  }

  .btn-equals {
    background-color: $brand;

    text {
      font-size: 7 * $size-factor;
      font-weight: 600;
      color: $white;
    }
  }

  .btn-x {
    background-color: rgba(255, 193, 7, 0.25);

    text {
      color: #ffc107;
      font-weight: 700;
      font-size: 8 * $size-factor;
    }
  }

  .btn-draw {
    background-color: rgba(233, 30, 99, 0.3);

    text {
      color: #e91e63;
      font-size: 7 * $size-factor;
      font-weight: 700;
    }
  }

  .result-container {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .equation-display {
    width: 100%;
    padding: 4 * $size-factor;
    background-color: rgba(0, 255, 153, 0.15);
    border-radius: 8 * $size-factor;
    border-left-width: 3px;
    border-left-color: #00ff99;
    margin-bottom: 16px;
    text-align: center;

    .equation-text {
      font-size: 9 * $size-factor;
      color: #00ff99;
      font-family: monospace;
    }
  }

  .canvas-container {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 4 * $size-factor;
  }

  .graph-canvas {
    width: 350px;
    height: 350px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 8 * $size-factor;
  }

  .action-buttons {
    width: 100%;
    display: flex;
    justify-content: space-around;
    gap: 3 * $size-factor;

    .action-btn {
      flex: 1;
      padding: 3 * $size-factor 0;
      background-color: rgba(255, 255, 255, 0.1);
      border-radius: 8 * $size-factor;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 70px;

      &:active {
        opacity: 0.4;
      }

      text {
        font-size: 7 * $size-factor;
        color: $white;
      }
    }
  }
</style>

<import name="d-back" src="./../../../components/d-back"></import>

<template>
  <list class="wrapper" title="true">
    <list-item>
      <d-back value="{{ $t('graph.title') }}"></d-back>
    </list-item>

    <list-item class="content" disabled="{{ isLoading }}">
      <div show="{{ isLoading }}" class="loading-mask">
        <vw-loading size="100"></vw-loading>
        <text style="color: white; font-size: 38px; margin-top: 16px">{{ $t('graph.loading') }}</text>
      </div>
      <div show="{{ currentStep === 'input' }}" class="input-container">
        <div class="expr-tabs">
          <div
            class="expr-tab {{ activeExprIndex === 0 ? 'expr-tab-active' : '' }}"
            style="border-left-color: #00ff99; background-color: {{ activeExprIndex === 0 ? 'rgba(0, 255, 153, 0.3)' : 'rgba(0, 255, 153, 0.15)' }};"
            onclick="switchExpr(0)">
            <text style="color: {{ activeExprIndex === 0 ? '#00ff99' : '#ffffff' }};">f₁</text>
          </div>
          <div
            class="expr-tab {{ activeExprIndex === 1 ? 'expr-tab-active' : '' }}"
            show="{{ exprCount > 1 }}"
            style="border-left-color: #ff6b6b; background-color: {{ activeExprIndex === 1 ? 'rgba(255, 107, 107, 0.3)' : 'rgba(255, 107, 107, 0.15)' }};"
            onclick="switchExpr(1)">
            <text style="color: {{ activeExprIndex === 1 ? '#ff6b6b' : '#ffffff' }};">f₂</text>
          </div>
          <div
            class="expr-tab {{ activeExprIndex === 2 ? 'expr-tab-active' : '' }}"
            show="{{ exprCount > 2 }}"
            style="border-left-color: #4dabf7; background-color: {{ activeExprIndex === 2 ? 'rgba(77, 171, 247, 0.3)' : 'rgba(77, 171, 247, 0.15)' }};"
            onclick="switchExpr(2)">
            <text style="color: {{ activeExprIndex === 2 ? '#4dabf7' : '#ffffff' }};">f₃</text>
          </div>
          <div
            class="expr-tab expr-tab-add"
            show="{{ exprCount < 3 }}"
            onclick="addExpr">
            <text>+</text>
          </div>
        </div>
        <div class="input-display">
          <text class="y-label" style="color: {{ activeExprIndex === 0 ? '#00ff99' : (activeExprIndex === 1 ? '#ff6b6b' : '#4dabf7') }};">y =</text>
          <marquee if="{{ inputDisplayMode === 'marquee' }}" class="expression-text">
            {{ expressions[activeExprIndex] || $t('graph.input_hint') }}
          </marquee>
          <text if="{{ inputDisplayMode === 'static' }}" class="expression-static" lines="1">
            {{ displayExpr }}
          </text>
        </div>
        <text if="{{ errorHint }}" class="error-hint">{{ errorHint }}</text>

        <div class="buttons-container">
          <div class="button-row">
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('7')">
              <text>7</text>
            </div>
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('8')">
              <text>8</text>
            </div>
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('9')">
              <text>9</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('sin(x)')">
              <text>sin</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('cos(x)')">
              <text>cos</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('tan(x)')">
              <text>tan</text>
            </div>
            <div class="btn btn-operator" onclick="inputChar('*')">
              <text>×</text>
            </div>
          </div>

          <div class="button-row">
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('4')">
              <text>4</text>
            </div>
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('5')">
              <text>5</text>
            </div>
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('6')">
              <text>6</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('sqrt(x)')">
              <text>√x</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('log(x)')">
              <text>log</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('ln(x)')">
              <text>ln</text>
            </div>
            <div class="btn btn-operator" onclick="inputChar('/')">
              <text>÷</text>
            </div>
          </div>

          <div class="button-row">
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('1')">
              <text>1</text>
            </div>
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('2')">
              <text>2</text>
            </div>
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('3')">
              <text>3</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('abs(x)')">
              <text>|x|</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('pi')">
              <text>π</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('exp(x)')">
              <text>e^x</text>
            </div>
            <div class="btn btn-operator" onclick="inputChar('+')">
              <text>+</text>
            </div>
          </div>

          <div class="button-row">
            <div
              class="btn btn-x"
              show="{{ !showAdvanced }}"
              onclick="inputChar('x')">
              <text>x</text>
            </div>
            <div
              class="btn btn-number"
              show="{{ !showAdvanced }}"
              onclick="inputChar('0')">
              <text>0</text>
            </div>
            <div
              class="btn btn-function"
              show="{{ !showAdvanced }}"
              onclick="inputChar('^')">
              <text>^</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('x^2')">
              <text>x²</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset('(')">
              <text>(</text>
            </div>
            <div
              class="btn btn-scientific"
              show="{{ showAdvanced }}"
              onclick="inputPreset(')')">
              <text>)</text>
            </div>
            <div class="btn btn-operator" onclick="inputChar('-')">
              <text>-</text>
            </div>
          </div>

          <div class="button-row">
            <div class="btn btn-function" onclick="clearExpression">
              <text>C</text>
            </div>
            <div class="btn btn-function" onclick="toggleAdvanced">
              <text>2nd</text>
            </div>
            <div class="btn btn-function" onclick="deleteChar">
              <text class="iconfont" style="font-size: 46px">&#xe62b;</text>
            </div>
            <div class="btn btn-draw" onclick="drawGraph">
              <text class="draw-btn-text">{{ $t('graph.draw') }}</text>
            </div>
          </div>
        </div>
      </div>

      <div if="{{ currentStep === 'result' }}" class="result-container">
        <div class="equation-display">
          <marquee
            class="equation-text"
            if="{{ expressions[0] }}"
            style="color: #00ff99"
            double-ended-shadow-color="#002617">
            f₁: y={{ expressions[0] }}
          </marquee>
          <marquee
            class="equation-text"
            if="{{ expressions[1] }}"
            style="color: #ff6b6b"
            double-ended-shadow-color="#002617">
            f₂: y={{ expressions[1] }}
          </marquee>
          <marquee
            class="equation-text"
            if="{{ expressions[2] }}"
            style="color: #4dabf7"
            double-ended-shadow-color="#002617">
            f₃: y={{ expressions[2] }}
          </marquee>
        </div>

        <text if="{{ errorHint }}" class="error-hint">{{ errorHint }}</text>

        <div class="canvas-container">
          <canvas class="graph-canvas" id="graphCanvas"></canvas>
        </div>

        <div class="action-buttons">
          <div class="action-btn" onclick="zoomIn">
            <text class="iconfont" style="font-size: 36px">&#xe63b;</text>
          </div>
          <div class="action-btn" onclick="zoomOut">
            <text class="iconfont" style="font-size: 36px">&#xe63a;</text>
          </div>
          <div class="action-btn" onclick="resetView">
            <text class="iconfont" style="font-size: 36px">&#xe604;</text>
          </div>
          <div class="action-btn" onclick="backToInput">
            <text>{{ $t('graph.edit') }}</text>
          </div>
        </div>

        <div class="action-buttons">
          <div class="action-btn" onclick="moveLeft">
            <text class="iconfont" style="font-size: 36px">←</text>
          </div>
          <div class="action-btn" onclick="moveUp">
            <text class="iconfont" style="font-size: 36px">↑</text>
          </div>
          <div class="action-btn" onclick="moveDown">
            <text class="iconfont" style="font-size: 36px">↓</text>
          </div>
          <div class="action-btn" onclick="moveRight">
            <text class="iconfont" style="font-size: 36px">→</text>
          </div>
        </div>
      </div>
    </list-item>
  </list>
</template>

<script>
  const PI = 3.141592653589793
  const E = 2.718281828459045
  // 交给 canvas 的坐标硬上限：超过先钳制，避免 1e17 级坐标进 webview canvas
  const COORD_LIMIT = 1e7
  // 裁剪框外扩像素：2px 线宽的描边自然溢出画布边缘
  const CLIP_MARGIN = 2

  export default {
    data: {
      currentStep: 'input',
      expressions: ['', '', ''],
      activeExprIndex: 0,
      exprCount: 1,
      showAdvanced: false,
      canvasWidth: 400,
      canvasHeight: 400,
      scale: 20,
      offsetX: 0,
      offsetY: 0,
      drawTimerId: 0,
      isLoading: false,
      compiledFns: [null, null, null],
      inputDisplayMode: 'static',
      // data 在组件实例初始化前解析，此处不能调用 this.$t（会取不到导致实例创建失败），
      // 占位文案统一在 onInit/updateDisplayExpr 里设置
      displayExpr: '',
      maxDisplayLen: 12,
      // 绘制失败提示（空输入 / 表达式无效），编辑输入时清空
      errorHint: '',
      // 画布尚未渲染时的重试次数，避免 isLoading 卡死
      retryCount: 0,
    },

    onInit() {
      this.inputDisplayMode = global.inputDisplayMode || 'marquee'
      this.updateDisplayExpr()
    },

    onDestroy() {
      this.clearTimer()
    },

    onShow() {
      this.inputDisplayMode = global.inputDisplayMode || 'marquee'
      this.updateDisplayExpr()
      if (this.currentStep === 'result') {
        this.scheduleDraw()
      }
    },

    backToInput() {
      this.clearTimer()
      this.currentStep = 'input'
    },

    clearTimer() {
      if (this.drawTimerId) {
        clearTimeout(this.drawTimerId)
        this.drawTimerId = 0
      }
    },

    inputPreset(preset) {
      global.triggerHaptic()
      this.expressions[this.activeExprIndex] += preset
      this.updateDisplayExpr()
    },

    inputChar(char) {
      global.triggerHaptic()
      this.expressions[this.activeExprIndex] += char
      this.updateDisplayExpr()
    },

    deleteChar() {
      global.triggerHaptic()
      if (this.expressions[this.activeExprIndex].length > 0) {
        this.expressions[this.activeExprIndex] = this.expressions[
          this.activeExprIndex
        ].slice(0, -1)
      }
      this.updateDisplayExpr()
    },

    clearExpression() {
      global.triggerHaptic()
      this.expressions[this.activeExprIndex] = ''
      this.updateDisplayExpr()
    },

    switchExpr(index) {
      this.activeExprIndex = index
      this.updateDisplayExpr()
    },

    addExpr() {
      if (this.exprCount < 3) {
        this.exprCount++
        this.activeExprIndex = this.exprCount - 1
        this.updateDisplayExpr()
      }
    },

    // 静态文本模式下的显示字符串：保留末尾 token 完整性 + 前导省略号
    // 关键：不能把 cos/log/sin 这类函数名截成 "co" + "s"，要么完整保留要么整体删除
    updateDisplayExpr() {
      var expr = this.expressions[this.activeExprIndex] || ''
      // 一编辑输入就清掉上一次的绘制错误提示
      this.errorHint = ''
      if (expr.length === 0) {
        this.displayExpr = this.$t('graph.input_hint')
        return
      }
      var maxLen = this.maxDisplayLen
      if (expr.length <= maxLen) {
        this.displayExpr = expr
        return
      }

      var tailLen = maxLen - 1
      var cutStart = expr.length - tailLen
      if (cutStart < 0) cutStart = 0

      var isLetter = function (c) {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
      }

      // 步骤 1：如果截断点落在字母-字母中间（函数名/变量名内部），
      //        往前跳到该 token 的开始位置
      while (cutStart > 0 && cutStart < expr.length) {
        if (isLetter(expr[cutStart]) && isLetter(expr[cutStart - 1])) {
          cutStart--
        } else {
          break
        }
      }

      // 步骤 2：如果跳到位置 0 仍在字母 token 内部（首 token 必然被部分截），
      //        直接跳到首 token 之后，让该 token 整体被省略号代替
      if (cutStart === 0 && isLetter(expr[0])) {
        for (var i = 1; i < expr.length; i++) {
          if (!isLetter(expr[i])) {
            cutStart = i
            break
          }
        }
      }

      this.displayExpr = '…' + expr.slice(cutStart)
    },

    toggleAdvanced() {
      global.triggerHaptic()
      this.showAdvanced = !this.showAdvanced
    },

    tokenize(expr) {
      var tokens = []
      var i = 0
      while (i < expr.length) {
        var ch = expr[i]
        if (ch === ' ') {
          i++
          continue
        }
        if ((ch >= '0' && ch <= '9') || ch === '.') {
          var num = ''
          while (
            i < expr.length &&
            ((expr[i] >= '0' && expr[i] <= '9') || expr[i] === '.')
          ) {
            num += expr[i]
            i++
          }
          // 科学计数法：1e6 / 2.5E-3。e 之后必须真的是数字，
          // 否则 2e 仍按 2×e 处理（e 是欧拉数，不是指数）
          if (i < expr.length && (expr[i] === 'e' || expr[i] === 'E')) {
            var expSign = ''
            var k = i + 1
            if (k < expr.length && (expr[k] === '+' || expr[k] === '-')) {
              expSign = expr[k]
              k++
            }
            var expDigits = ''
            while (k < expr.length && expr[k] >= '0' && expr[k] <= '9') {
              expDigits += expr[k]
              k++
            }
            if (expDigits.length > 0) {
              num += 'e' + expSign + expDigits
              i = k
            }
          }
          // 非法数字字面量（"." / "5..2"）标记为坏 token，交给解析器报错，
          // 不能靠 parseFloat 悄悄截成 5
          if (num === '.' || num.indexOf('.') !== num.lastIndexOf('.')) {
            tokens.push({ type: 'bad' })
          } else {
            tokens.push({ type: 'num', value: parseFloat(num) })
          }
          continue
        }
        if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')) {
          var name = ''
          while (
            i < expr.length &&
            ((expr[i] >= 'a' && expr[i] <= 'z') ||
              (expr[i] >= 'A' && expr[i] <= 'Z'))
          ) {
            name += expr[i]
            i++
          }
          if (name === 'x') tokens.push({ type: 'var' })
          else if (name === 'pi') tokens.push({ type: 'num', value: PI })
          else if (name === 'e') tokens.push({ type: 'num', value: E })
          else tokens.push({ type: 'func', name: name })
          continue
        }
        if (
          ch === '+' ||
          ch === '-' ||
          ch === '*' ||
          ch === '/' ||
          ch === '^' ||
          ch === '(' ||
          ch === ')'
        ) {
          tokens.push({ type: 'op', value: ch })
          i++
          continue
        }
        i++
      }
      return tokens
    },

    parseExpr(tokens, pos, x) {
      var result = this.parseTerm(tokens, pos, x)
      if (result.err) return result
      pos = result.pos
      var val = result.value
      while (pos < tokens.length) {
        var t = tokens[pos]
        if (t.type !== 'op' || (t.value !== '+' && t.value !== '-')) break
        pos++
        var right = this.parseTerm(tokens, pos, x)
        if (right.err) return right
        pos = right.pos
        if (t.value === '+') val = val + right.value
        else val = val - right.value
      }
      return { value: val, pos: pos }
    },

    parseTerm(tokens, pos, x) {
      var result = this.parseUnary(tokens, pos, x)
      if (result.err) return result
      pos = result.pos
      var val = result.value
      while (pos < tokens.length) {
        var t = tokens[pos]
        if (t.type !== 'op' || (t.value !== '*' && t.value !== '/')) break
        pos++
        var right = this.parseUnary(tokens, pos, x)
        if (right.err) return right
        pos = right.pos
        if (t.value === '*') val = val * right.value
        else val = val / right.value
      }
      return { value: val, pos: pos }
    },

    // 乘方：底数是原子，指数交给 unary（这样 2^-3 合法，且 2^3^2 右结合）
    parsePower(tokens, pos, x) {
      var result = this.parseAtom(tokens, pos, x)
      if (result.err) return result
      pos = result.pos
      var val = result.value
      if (
        pos < tokens.length &&
        tokens[pos].type === 'op' &&
        tokens[pos].value === '^'
      ) {
        pos++
        var right = this.parseUnary(tokens, pos, x)
        if (right.err) return right
        return { value: Math.pow(val, right.value), pos: right.pos }
      }
      return { value: val, pos: pos }
    },

    // 一元负号：优先级低于乘方（-x^2 = -(x^2)，与数学写法一致），高于 * 和 /
    parseUnary(tokens, pos, x) {
      if (
        pos < tokens.length &&
        tokens[pos].type === 'op' &&
        tokens[pos].value === '-'
      ) {
        var result = this.parseUnary(tokens, pos + 1, x)
        if (result.err) return result
        return { value: -result.value, pos: result.pos }
      }
      return this.parsePower(tokens, pos, x)
    },

    parseAtom(tokens, pos, x) {
      if (pos >= tokens.length) return { err: true, pos: pos }
      var t = tokens[pos]
      if (t.type === 'num') return { value: t.value, pos: pos + 1 }
      if (t.type === 'var') return { value: x, pos: pos + 1 }
      if (t.type === 'func') {
        var name = t.name
        pos++
        if (
          pos >= tokens.length ||
          tokens[pos].type !== 'op' ||
          tokens[pos].value !== '('
        ) {
          return { err: true, pos: pos }
        }
        pos++
        var result = this.parseExpr(tokens, pos, x)
        if (result.err) return result
        pos = result.pos
        if (
          pos >= tokens.length ||
          tokens[pos].type !== 'op' ||
          tokens[pos].value !== ')'
        ) {
          return { err: true, pos: pos }
        }
        pos++
        var arg = result.value
        var val
        if (name === 'sin') val = Math.sin(arg)
        else if (name === 'cos') val = Math.cos(arg)
        else if (name === 'tan') val = Math.tan(arg)
        else if (name === 'sqrt') val = Math.sqrt(arg)
        else if (name === 'log') val = Math.log(arg) / Math.log(10)
        else if (name === 'ln') val = Math.log(arg)
        else if (name === 'exp') val = Math.exp(arg)
        else if (name === 'abs') val = Math.abs(arg)
        else return { err: true, pos: pos }
        return { value: val, pos: pos }
      }
      if (t.type === 'op' && t.value === '(') {
        pos++
        var result = this.parseExpr(tokens, pos, x)
        if (result.err) return result
        pos = result.pos
        if (
          pos >= tokens.length ||
          tokens[pos].type !== 'op' ||
          tokens[pos].value !== ')'
        ) {
          return { err: true, pos: pos }
        }
        return { value: result.value, pos: pos + 1 }
      }
      return { err: true, pos: pos }
    },

    preprocessExpression(expr) {
      var result = ''
      var functions = ['sin', 'cos', 'tan', 'sqrt', 'log', 'ln', 'exp', 'abs']

      for (var i = 0; i < expr.length; i++) {
        var curr = expr[i]

        if (i > 0) {
          var prev = expr[i - 1]

          var prevIsNum = (prev >= '0' && prev <= '9') || prev === '.'
          var prevIsClose = prev === ')'
          var prevIsLetter =
            (prev >= 'a' && prev <= 'z') || (prev >= 'A' && prev <= 'Z')

          var currIsLetter =
            (curr >= 'a' && curr <= 'z') || (curr >= 'A' && curr <= 'Z')
          var currIsNum = (curr >= '0' && curr <= '9') || curr === '.'
          var currIsOpen = curr === '('

          // 1e6 / 2.5E-3 是科学计数法，不能插乘号（交给 tokenize 处理）
          var isExponent = false
          if (prevIsNum && (curr === 'e' || curr === 'E')) {
            var n1 = expr[i + 1] || ''
            var n2 = expr[i + 2] || ''
            if (n1 >= '0' && n1 <= '9') isExponent = true
            else if ((n1 === '+' || n1 === '-') && n2 >= '0' && n2 <= '9') {
              isExponent = true
            }
          }

          if (prevIsNum && !isExponent && (currIsLetter || currIsOpen)) {
            result += '*'
          } else if (prevIsClose && (currIsNum || currIsLetter || currIsOpen)) {
            result += '*'
          } else if (prevIsLetter && currIsNum) {
            // x2 / pi2 这类"值后面跟值"也要补乘号，
            // 否则尾部的数字会被解析器静默丢掉（以前 x2 画出来是 y=x）。
            // 但 1e6 里的 e 是科学计数法的一部分，不能拆成 1*e*6
            var prevRun = ''
            var j2 = i - 1
            while (
              j2 >= 0 &&
              ((expr[j2] >= 'a' && expr[j2] <= 'z') ||
                (expr[j2] >= 'A' && expr[j2] <= 'Z'))
            ) {
              prevRun = expr[j2] + prevRun
              j2--
            }
            var numPrefix =
              j2 >= 0 && ((expr[j2] >= '0' && expr[j2] <= '9') || expr[j2] === '.')
            if (!(numPrefix && (prevRun === 'e' || prevRun === 'E'))) {
              result += '*'
            }
          } else if (prevIsLetter && currIsOpen) {
            var funcName = ''
            var j = i - 1
            while (
              j >= 0 &&
              ((expr[j] >= 'a' && expr[j] <= 'z') ||
                (expr[j] >= 'A' && expr[j] <= 'Z'))
            ) {
              funcName = expr[j] + funcName
              j--
            }
            if (functions.indexOf(funcName) === -1) {
              result += '*'
            }
          }
        }

        result += curr
      }
      return result
    },

    // 预编译：把表达式解析为求值闭包，后续每像素只跑一次函数调用
    compileExpr(expr) {
      if (!expr) return null
      var processed = this.preprocessExpression(expr)
      var tokens = this.tokenize(processed)
      if (tokens.length === 0) return null
      // 整体校验一次：解析必须恰好走完所有 token。以前尾部残留会被
      // 静默忽略（x2 画成 y=x），现在按非法表达式处理，由调用方给提示
      var check = this.parseExpr(tokens, 0, 0)
      if (check.err || check.pos !== tokens.length) return null
      var self = this
      return function (x) {
        var result = self.parseExpr(tokens, 0, x)
        if (result.err) return 0 / 0
        return result.value
      }
    },

    compileAll() {
      for (var i = 0; i < this.expressions.length; i++) {
        this.compiledFns[i] = this.compileExpr(this.expressions[i])
      }
    },

    drawGraph() {
      var hasExpr = false
      for (var i = 0; i < this.expressions.length; i++) {
        if (this.expressions[i]) hasExpr = true
      }
      // 空输入点"绘制"以前毫无反应，这里给一句提示
      if (!hasExpr) {
        this.errorHint = this.$t('graph.empty_expr')
        return
      }

      // 预编译所有表达式，避免每帧重复词法/语法分析
      this.compileAll()

      // 找出解析失败的曲线：全失败就不进结果页（进去也只有一块空白画布）
      var labels = ['f₁', 'f₂', 'f₃']
      var names = ''
      var validCount = 0
      for (var k = 0; k < this.expressions.length; k++) {
        if (!this.expressions[k]) continue
        if (this.compiledFns[k]) {
          validCount++
        } else {
          names += (names ? ', ' : '') + labels[k]
        }
      }
      this.errorHint = names ? names + ' ' + this.$t('graph.invalid_expr') : ''
      if (validCount === 0) return

      this.clearTimer()
      this.isLoading = true
      this.retryCount = 0
      this.currentStep = 'result'
      this.scheduleDraw()
    },

    scheduleDraw() {
      this.clearTimer()
      var self = this
      this.drawTimerId = setTimeout(function () {
        self.drawTimerId = 0
        self.doDrawGraph()
      }, 100)
    },

    doDrawGraph() {
      var canvas = this.$element('graphCanvas')
      // 画布可能还没渲染出来（慢设备首帧可能超过 100ms）。以前直接 return
      // 会让 isLoading 永远为 true：遮罩不消失、整页 disabled 卡死
      if (!canvas || !canvas.getContext) {
        this.isLoading = false
        if (this.currentStep === 'result' && this.retryCount < 5) {
          this.retryCount++
          this.scheduleDraw()
        }
        return
      }

      // 使用 1x 物理像素，避免快应用 webview 高 DPI canvas 不稳定 / 性能差
      canvas.width = this.canvasWidth
      canvas.height = this.canvasHeight

      var ctx = canvas.getContext('2d')
      if (!ctx) {
        this.isLoading = false
        return
      }

      var width = this.canvasWidth
      var height = this.canvasHeight
      var centerX = width / 2 + this.offsetX
      var centerY = height / 2 + this.offsetY
      var scale = this.scale

      ctx.clearRect(0, 0, width, height)

      this.drawGridAndAxes(ctx, width, height, centerX, centerY, scale)
      this.drawCurves(ctx, width, height, centerX, centerY, scale)

      this.isLoading = false
      this.retryCount = 0
    },

    // 绘制网格、坐标轴、刻度文字（纯静态，可独立刷新区分）
    drawGridAndAxes(ctx, width, height, centerX, centerY, scale) {
      var targetStep = 80 / scale
      var pow10 = Math.pow(10, Math.floor(Math.log(targetStep) / Math.log(10)))
      var raw = targetStep / pow10
      var step
      if (raw < 1.5) step = 1 * pow10
      else if (raw < 3.5) step = 2 * pow10
      else if (raw < 7.5) step = 5 * pow10
      else step = 10 * pow10
      var decimals = Math.max(0, -Math.floor(Math.log(step) / Math.log(10)))
      var stepRound = Math.pow(10, -decimals)
      var labelFormat = function (n) {
        if (decimals === 0) return n.toString()
        var rounded = Math.round(n / stepRound) * stepRound
        var pow = Math.pow(10, decimals)
        var absR = Math.abs(rounded)
        var intPart = Math.floor(absR)
        var fracPart = Math.round((absR - intPart) * pow)
        if (fracPart === pow) {
          intPart += 1
          fracPart = 0
        }
        var sign = rounded < 0 ? '-' : ''
        var fracStr = String(fracPart)
        while (fracStr.length < decimals) fracStr = '0' + fracStr
        return sign + String(intPart) + '.' + fracStr
      }

      ctx.strokeStyle = 'rgba(255, 255, 255, 0.1)'
      ctx.lineWidth = 1

      var xLeft = -centerX / scale
      var xRight = (width - centerX) / scale
      var yBottom = -(height - centerY) / scale
      var yTop = centerY / scale

      var xStart = Math.ceil(xLeft / step) * step
      for (var i = xStart; i <= xRight + 1e-9; i += step) {
        var xv = centerX + i * scale
        ctx.beginPath()
        ctx.moveTo(xv, 0)
        ctx.lineTo(xv, height)
        ctx.stroke()
      }
      var yStart = Math.ceil(yBottom / step) * step
      for (var i = yStart; i <= yTop + 1e-9; i += step) {
        var yv = centerY - i * scale
        ctx.beginPath()
        ctx.moveTo(0, yv)
        ctx.lineTo(width, yv)
        ctx.stroke()
      }

      ctx.strokeStyle = 'rgba(255, 255, 255, 0.6)'
      ctx.lineWidth = 2
      ctx.beginPath()
      ctx.moveTo(0, centerY)
      ctx.lineTo(width, centerY)
      ctx.stroke()
      ctx.beginPath()
      ctx.moveTo(centerX, 0)
      ctx.lineTo(centerX, height)
      ctx.stroke()

      ctx.fillStyle = 'rgba(255, 255, 255, 0.8)'
      ctx.font = '12px sans-serif'
      ctx.textAlign = 'center'
      ctx.textBaseline = 'top'
      for (var i = xStart; i <= xRight + 1e-9; i += step) {
        if (Math.abs(i) > 1e-9) {
          var xv = centerX + i * scale
          ctx.fillText(labelFormat(i), xv, centerY + 4)
        }
      }

      ctx.textAlign = 'right'
      ctx.textBaseline = 'middle'
      for (var i = yStart; i <= yTop + 1e-9; i += step) {
        if (Math.abs(i) > 1e-9) {
          var yv = centerY - i * scale
          ctx.fillText(labelFormat(i), centerX - 4, yv)
        }
      }
    },

    // 绘制函数曲线：使用预编译闭包，加入极点检测与自适应降采样
    drawCurves(ctx, width, height, centerX, centerY, scale) {
      var colors = ['#00ff99', '#ff6b6b', '#4dabf7']
      var fns = this.compiledFns

      // 统计活动函数数量，决定采样步长：3 个函数时减半采样，避免主线程卡死
      var activeCount = 0
      for (var i = 0; i < fns.length; i++) {
        if (fns[i]) activeCount++
      }
      var sampleStep = activeCount >= 3 ? 2 : 1

      // 单条曲线失败不影响其他曲线与整体渲染
      for (var ei = 0; ei < fns.length; ei++) {
        var fn = fns[ei]
        if (!fn) continue
        try {
          this.drawSingleCurve(
            ctx,
            width,
            height,
            centerX,
            centerY,
            scale,
            fn,
            colors[ei],
            sampleStep
          )
        } catch (e) {
          // 静默跳过出错曲线
        }
      }
    },

    // 逐列采样 + 线段裁剪：陡峭连续函数靠裁剪保留，
    // 真极点（垂直渐近线）靠"二分后跳变是否收敛"探测抬笔
    drawSingleCurve(
      ctx,
      width,
      height,
      centerX,
      centerY,
      scale,
      fn,
      color,
      sampleStep
    ) {
      ctx.strokeStyle = color
      ctx.lineWidth = 2
      ctx.beginPath()

      var self = this
      var xmin = -CLIP_MARGIN
      var ymin = -CLIP_MARGIN
      var xmax = width + CLIP_MARGIN
      var ymax = height + CLIP_MARGIN
      // 屏幕纵向跳变超过半屏才值得怀疑极点（与 scale 解耦）
      var jumpPx = height * 0.5
      // 可视区纵向半高（数学单位）：两端都超出它才可能夹住渐近线
      var halfH = height / (2 * scale)

      var penDown = false
      var hasPrev = false
      var prevX = 0
      var prevY = 0
      var prevPx = 0
      var prevSy = 0
      var prevWild = false

      // 落一段线段：先裁剪到画布矩形，只把框内坐标交给 canvas
      var emit = function (fx, fy, tx, ty) {
        var seg = self.clipSegment(fx, fy, tx, ty, xmin, ymin, xmax, ymax)
        if (!seg) {
          penDown = false
          return
        }
        if (!penDown || seg[4]) ctx.moveTo(seg[0], seg[1])
        ctx.lineTo(seg[2], seg[3])
        penDown = !seg[4]
      }

      for (var px = 0; px < width; px += sampleStep) {
        var cx = (px - centerX) / scale
        var y = fn(cx)

        // 无定义：1/x 的 0、ln/log 的非正数、sqrt 的负数
        if (y !== y || y === 1 / 0 || y === -1 / 0) {
          penDown = false
          hasPrev = false
          continue
        }

        var sy = centerY - y * scale
        // 数值保底：先钳制再裁剪，canvas 只会收到框内坐标。
        // 被钳制的采样点等于"落在极点附近"，wild 参与后面的判定
        var wild = sy > COORD_LIMIT || sy < -COORD_LIMIT
        if (sy > COORD_LIMIT) sy = COORD_LIMIT
        else if (sy < -COORD_LIMIT) sy = -COORD_LIMIT

        if (!hasPrev) {
          prevX = cx
          prevY = y
          prevPx = px
          prevSy = sy
          prevWild = wild
          hasPrev = true
          continue
        }

        var isBreak = false
        if (prevWild !== wild) {
          // 一端贴在极点、另一端还在可视区：跨越画布中心上下两侧说明中间
          // 是垂直渐近线（如 tan(pi*x) 采样正好打在极点上），不能连
          var syIn = wild ? prevSy : sy
          var syFar = wild ? sy : prevSy
          if (Math.abs(syIn - centerY) <= height * 0.5) {
            isBreak = (syIn - centerY) * (syFar - centerY) < 0
          }
        } else if (Math.abs(sy - prevSy) > jumpPx) {
          // 只有两端都跑出可视纵向范围时才可能是渐近线；
          // 视图内的陡峭段直接连线（y=300x 之类以前整条画不出的原因）
          if (Math.abs(y) > halfH && Math.abs(prevY) > halfH) {
            isBreak = this.isPoleJump(fn, prevX, prevY, cx, y)
          }
        }

        if (isBreak) {
          penDown = false
        } else {
          emit(prevPx, prevSy, px, sy)
        }

        prevX = cx
        prevY = y
        prevPx = px
        prevSy = sy
        prevWild = wild
      }

      ctx.stroke()
    },

    // 可疑的一对采样是否跨越极点：连续函数二分后跳变至少减半，
    // 跨极点时跳变不收敛（甚至变大）。比"内部极值"判据更稳，
    // 也能认出极点贴着采样点的情形（如 tan(x) 的部分极点）
    isPoleJump(fn, x1, y1, x2, y2) {
      var d1 = Math.abs(y2 - y1)
      if (d1 === 0) return false
      var xm = (x1 + x2) * 0.5
      var ym = fn(xm)
      var ya = fn((x1 + xm) * 0.5)
      var yb = fn((xm + x2) * 0.5)
      if (!this.isFiniteNum(ym)) return true
      if (!this.isFiniteNum(ya)) return true
      if (!this.isFiniteNum(yb)) return true
      var sub = Math.abs(ym - ya)
      if (Math.abs(ya - y1) > sub) sub = Math.abs(ya - y1)
      if (Math.abs(yb - ym) > sub) sub = Math.abs(yb - ym)
      if (Math.abs(y2 - yb) > sub) sub = Math.abs(y2 - yb)
      return sub > d1 * 0.5
    },

    isFiniteNum(v) {
      return v === v && v !== 1 / 0 && v !== -1 / 0
    },

    // Liang–Barsky：整段在框外返回 null，否则 [x0,y0,x1,y1,是否被裁]
    clipSegment(x0, y0, x1, y1, xmin, ymin, xmax, ymax) {
      var dx = x1 - x0
      var dy = y1 - y0
      var t0 = 0
      var t1 = 1
      var p
      var q
      var r
      for (var i = 0; i < 4; i++) {
        if (i === 0) {
          p = -dx
          q = x0 - xmin
        } else if (i === 1) {
          p = dx
          q = xmax - x0
        } else if (i === 2) {
          p = -dy
          q = y0 - ymin
        } else {
          p = dy
          q = ymax - y0
        }
        if (p === 0) {
          if (q < 0) return null
        } else {
          r = q / p
          if (p < 0) {
            if (r > t1) return null
            if (r > t0) t0 = r
          } else {
            if (r < t0) return null
            if (r < t1) t1 = r
          }
        }
      }
      return [
        x0 + t0 * dx,
        y0 + t0 * dy,
        x0 + t1 * dx,
        y0 + t1 * dy,
        t0 > 0 || t1 < 1,
      ]
    },

    zoomIn() {
      this.isLoading = true
      var newScale = this.scale * 1.5
      // 记录当前屏幕中心对应的数学坐标，缩放后保持中心不变
      var cx = -this.offsetX / this.scale
      var cy = this.offsetY / this.scale
      this.scale = newScale
      this.offsetX = -cx * newScale
      this.offsetY = cy * newScale
      this.scheduleDraw()
    },

    zoomOut() {
      this.isLoading = true
      var newScale = this.scale / 1.5
      var cx = -this.offsetX / this.scale
      var cy = this.offsetY / this.scale
      this.scale = newScale
      this.offsetX = -cx * newScale
      this.offsetY = cy * newScale
      this.scheduleDraw()
    },

    resetView() {
      this.isLoading = true
      this.scale = 20
      this.offsetX = 0
      this.offsetY = 0
      this.scheduleDraw()
    },

    moveLeft() {
      this.isLoading = true
      this.offsetX += this.canvasWidth * 0.25
      this.scheduleDraw()
    },

    moveRight() {
      this.isLoading = true
      this.offsetX -= this.canvasWidth * 0.25
      this.scheduleDraw()
    },

    moveUp() {
      this.isLoading = true
      this.offsetY += this.canvasHeight * 0.25
      this.scheduleDraw()
    },

    moveDown() {
      this.isLoading = true
      this.offsetY -= this.canvasHeight * 0.25
      this.scheduleDraw()
    },
  }
</script>

<style lang="scss">
  @import './../../../assets/styles/style.scss';

  .wrapper {
    width: 100%;
  }

  .content {
    width: 100%;
    flex-direction: column;
    padding: 0 2 * $size-factor 4 * $size-factor 2 * $size-factor;
    margin-top: 6px;
    margin-bottom: 30px;

    @media (device: watch-round) {
      margin-bottom: 50px;
    }
  }

  .loading-mask {
    position: fixed;
    width: 100%;
    top: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0.8);
    @include flex-box-mixins(column, center, center);
  }

  .input-container {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .input-display {
    width: 100%;
    padding: 3 * $size-factor;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 8 * $size-factor;
    margin-bottom: 3 * $size-factor;
    display: flex;
    align-items: center;

    .y-label {
      font-size: 8 * $size-factor;
      color: $success;
      font-family: monospace;
      margin-left: 10px;
      margin-right: 4 * $size-factor;
    }

    .expression-text {
      flex: 1;
      font-size: 8 * $size-factor;
      color: $white;
      font-family: monospace;
    }

    .expression-static {
      // 静态显示：JS 已截取末尾 N 个字符 + 前导省略号
      // 这里用 text-align: left 让省略号在左、完整内容在右
      flex: 1;
      font-size: 8 * $size-factor;
      color: $white;
      font-family: monospace;
      text-align: left;
    }
  }

  // 绘制失败提示（空输入 / 表达式无效）：红色小字，右对齐贴在输入框下方
  .error-hint {
    width: 100%;
    font-size: 6.5 * $size-factor;
    color: #ff6b6b;
    text-align: right;
    margin-top: -4 * $size-factor;
    margin-bottom: 4 * $size-factor;
  }

  .buttons-container {
    width: 100%;
    display: flex;
    @include flex-box-mixins(column, space-between, space-between);

    @media (device: watch-round) {
      justify-content: flex-start;
    }
  }

  .button-row {
    width: 100%;
    display: flex;
    // 不使用 gap：部分设备（如 watch6）对无 display:flex 的 flex 容器不支持 gap，
    // 会导致整行按键塌陷为 0 高度、键盘区域显示为空白（与主页键盘保持一致的做法）
    @include flex-box-mixins(row, space-between, center);
  }

  .btn {
    flex: 1;
    height: 72px;
    background-color: $card-bg;
    border-radius: 8 * $size-factor;
    @include flex-box-mixins(row, center, center);

    text {
      font-size: 7 * $size-factor;
      color: $white;
    }

    &:active {
      opacity: 0.4;
    }

    @media (device: watch-round) {
      height: 60px;
      border-radius: 30px;

      text {
        font-size: 32px;
      }
    }
  }

  .btn-number {
    background-color: $input-bg;
  }

  .btn-operator {
    background-color: $brand;
  }

  .btn-function {
    background-color: $light-brand;

    text {
      color: $brand;
      font-weight: 600;
    }
  }

  .btn-scientific {
    background-color: rgba(25, 118, 210, 0.2);

    text {
      color: #1976d2;
      font-weight: 500;
    }
  }

  .btn-x {
    background-color: rgba(255, 193, 7, 0.25);

    text {
      color: #ffc107;
      font-weight: 700;
      font-size: 8 * $size-factor;
    }
  }

  .btn-draw {
    background-color: rgba(233, 30, 99, 0.3);

    text {
      color: #e91e63;
      font-size: 7 * $size-factor;
      font-weight: 700;
    }
  }

  .result-container {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .expr-tabs {
    width: 100%;
    margin-left: 10px;
    margin-bottom: 12px;
  }

  .expr-tab {
    padding: 8px 26px;
    background-color: $card-bg;
    border-radius: 8 * $size-factor;
    margin-right: 12px;

    text {
      font-size: 7 * $size-factor;
      font-weight: 700;
    }

    &:active {
      opacity: 0.4;
    }
  }

  .expr-tab-active {
    background-color: $success-active;

    text {
      color: $success;
    }
  }

  .expr-tab-add {
    padding: 8px 18px;
    background-color: rgba(0, 255, 153, 0.2);
    border-radius: 6 * $size-factor;
    margin-right: 8px;

    text {
      font-size: 6 * $size-factor;
      font-weight: 700;
      color: $success;
    }

    &:active {
      opacity: 0.4;
    }
  }

  .equation-display {
    width: 100%;
    padding: 20px 36px;
    background-color: $success-bg;
    border-radius: 8 * $size-factor;
    margin-bottom: 20px;
    flex-direction: column;

    .equation-text {
      font-size: 8 * $size-factor;
    }
  }

  .canvas-container {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 4 * $size-factor;
  }

  .graph-canvas {
    width: 400px;
    height: 400px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 8 * $size-factor;
  }

  .action-buttons {
    width: 100%;
    justify-content: space-between;
    margin-top: 8px;

    .action-btn {
      padding: 3 * $size-factor 0;
      background-color: $card-bg;
      border-radius: 8 * $size-factor;
      align-items: center;
      justify-content: center;
      height: 70px;
      width: 106px;

      &:active {
        opacity: 0.4;
      }

      text {
        font-size: 7 * $size-factor;
        color: $white;
      }
    }
  }
</style>

<script>
  export default {
    data: {
      currentCategory: 'math',
      showDetail: false,
      detailName: '',
      detailFormula: '',
      detailDesc: '',
      detailExample: ''
    },

    onInit() {
    },

    switchCategory(categoryId) {
      this.currentCategory = categoryId;
    },

    showFormulaDetail1() {
      this.showDetail = true;
      this.detailName = '圆面积';
      this.detailFormula = 'S = πr²';
      this.detailDesc = '计算圆的面积，r为半径';
      this.detailExample = 'r = 5时，S = 78.54';
    },

    showFormulaDetail2() {
      this.showDetail = true;
      this.detailName = '圆周长';
      this.detailFormula = 'C = 2πr';
      this.detailDesc = '计算圆的周长，r为半径';
      this.detailExample = 'r = 5时，C = 31.42';
    },

    showFormulaDetail3() {
      this.showDetail = true;
      this.detailName = '长方形面积';
      this.detailFormula = 'S = ab';
      this.detailDesc = '计算长方形面积，a、b为边长';
      this.detailExample = 'a=3, b=5时，S=15';
    },

    showFormulaDetail4() {
      this.showDetail = true;
      this.detailName = '三角形面积';
      this.detailFormula = 'S = ½ah';
      this.detailDesc = '计算三角形面积，a为底，h为高';
      this.detailExample = 'a=4, h=5时，S=10';
    },

    showFormulaDetail5() {
      this.showDetail = true;
      this.detailName = '平方根';
      this.detailFormula = '√x';
      this.detailDesc = '求x的平方根';
      this.detailExample = '√16 = 4';
    },

    showFormulaDetail6() {
      this.showDetail = true;
      this.detailName = '速度公式';
      this.detailFormula = 'v = s/t';
      this.detailDesc = '计算速度，s为路程，t为时间';
      this.detailExample = 's=100m, t=10s时，v=10m/s';
    },

    showFormulaDetail7() {
      this.showDetail = true;
      this.detailName = '密度公式';
      this.detailFormula = 'ρ = m/V';
      this.detailDesc = '计算密度，m为质量，V为体积';
      this.detailExample = 'm=10kg, V=2m³时，ρ=5kg/m³';
    },

    showFormulaDetail8() {
      this.showDetail = true;
      this.detailName = '欧姆定律';
      this.detailFormula = 'I = U/R';
      this.detailDesc = '欧姆定律，U为电压，R为电阻';
      this.detailExample = 'U=12V, R=6Ω时，I=2A';
    },

    showFormulaDetail9() {
      this.showDetail = true;
      this.detailName = '重力公式';
      this.detailFormula = 'G = mg';
      this.detailDesc = '重力计算，g≈9.8m/s²';
      this.detailExample = 'm=10kg时，G=98N';
    },

    showFormulaDetail10() {
      this.showDetail = true;
      this.detailName = '功的公式';
      this.detailFormula = 'W = Fs';
      this.detailDesc = '功的计算，F为力，s为距离';
      this.detailExample = 'F=10N, s=5m时，W=50J';
    },

    showFormulaDetail11() {
      this.showDetail = true;
      this.detailName = '摩尔质量';
      this.detailFormula = 'n = m/M';
      this.detailDesc = '物质的量计算，m为质量，M为摩尔质量';
      this.detailExample = 'm=18g, M=18g/mol时，n=1mol';
    },

    showFormulaDetail12() {
      this.showDetail = true;
      this.detailName = '物质的量浓度';
      this.detailFormula = 'c = n/V';
      this.detailDesc = '浓度计算，n为物质的量，V为体积';
      this.detailExample = 'n=2mol, V=1L时，c=2mol/L';
    },

    showFormulaDetail13() {
      this.showDetail = true;
      this.detailName = 'pH值';
      this.detailFormula = 'pH = -lg[H+]';
      this.detailDesc = '酸碱度计算';
      this.detailExample = '[H+]=10^-7时，pH=7';
    },

    showFormulaDetail14() {
      this.showDetail = true;
      this.detailName = '正方形面积';
      this.detailFormula = 'S = a²';
      this.detailDesc = '正方形面积，a为边长';
      this.detailExample = 'a=5时，S=25';
    },

    showFormulaDetail15() {
      this.showDetail = true;
      this.detailName = '正方体体积';
      this.detailFormula = 'V = a³';
      this.detailDesc = '正方体体积，a为边长';
      this.detailExample = 'a=5时，V=125';
    },

    showFormulaDetail16() {
      this.showDetail = true;
      this.detailName = '勾股定理';
      this.detailFormula = 'a²+b²=c²';
      this.detailDesc = '直角三角形三边关系，c为斜边';
      this.detailExample = 'a=3, b=4时，c=5';
    },

    showFormulaDetail17() {
      this.showDetail = true;
      this.detailName = '球体积';
      this.detailFormula = 'V = ⁴⁄₃πr³';
      this.detailDesc = '球体体积，r为半径';
      this.detailExample = 'r=3时，V≈113.1';
    },

    hideFormulaDetail() {
      this.showDetail = false;
    }
  }
</script>


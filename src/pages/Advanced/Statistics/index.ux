    @media (device: watch-round) {
      text-align: center;
      margin-left: 0;
    }
  }

  .input-row {
    width: 100%;
    @include flex-box-mixins(row, space-between, center);
    margin-top: 20px;
  }

  .input-label {
    font-size: 7 * $size-factor;
    color: white;
    width: 80px;
    margin: 0 2 * $size-factor;
  }

  .btn-row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 20px;
  }

  .add-btn {
    flex: 1;
    padding: 3 * $size-factor 0;
    background-color: $brand;
    margin-right: 4 * $size-factor;
    border-radius: 8 * $size-factor;
    flex-direction: row;
    justify-content: center;
    align-items: center;

    &:active {
      opacity: 0.4;
    }

    .add-btn-text {
      font-size: 8 * $size-factor;
      color: $white;
      font-weight: bold;
    }
  }

  .clear-btn {
    flex: 1;
    padding: 3 * $size-factor 0;
    border-radius: 8 * $size-factor;
    flex-direction: row;
    justify-content: center;
    align-items: center;

    &:active {
      opacity: 0.4;
    }

    .clear-btn-text {
      font-size: 8 * $size-factor;
      color: #ff6464;
      font-weight: bold;
    }
  }

  .data-list {
    width: 100%;
    flex-direction: column;
    margin-top: 30px;
    margin-left: 12px;
  }

  .data-title {
    font-size: 6.4 * $size-factor;
    color: $light-gray;
    margin-bottom: 2 * $size-factor;
  }

  .data-items {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 3 * $size-factor;
  }

  .data-item {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 4 * $size-factor;
    padding: 2 * $size-factor 3 * $size-factor;
    font-size: 5.4 * $size-factor;
    margin-right: 2 * $size-factor;
    margin-bottom: 10px;
    color: $white;

    &:active {
      opacity: 0.4;
    }
  }

  .result-list {
    width: 100%;
    flex-direction: column;
    margin-top: 10px;
  }

  .result-item {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 8 * $size-factor;
    padding: 24px 30px;
    margin-bottom: 12px;
    justify-content: space-between;
    align-items: center;
  }

  .result-label {
    font-size: 7 * $size-factor;
    color: $light-gray;
  }

  .result-value {
    font-size: 7 * $size-factor;
    color: $brand;
    font-weight: bold;
    text-align: right;
    width: 270px;
  }

  .empty-hint {
    width: 100%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 40px 0;

    .empty-text {
      font-size: 6 * $size-factor;
      color: $light-gray;
    }
  }
</style>

<import name="d-back" src="./../../../components/d-back"></import>
<import
  name="d-number-input"
  src="./../../../components/d-number-input"></import>

<template>
  <list class="wrapper" title="true">
    <list-item>
      <d-back value="统计分析"></d-back>
    </list-item>
    <list-item type="card" class="content">
      <text class="section-title">数据输入</text>
      <div class="input-row">
        <text class="input-label">数据:</text>
        <d-number-input
          value="{{ currentValue }}"
          label="输入数据"
          placeholder="点击输入"
          @change="handleInputChange"></d-number-input>
      </div>
      <div class="btn-row">
        <div class="add-btn" onclick="addData">
          <text class="add-btn-text">添加</text>
        </div>
        <div
          class="clear-btn"
          onclick="clearAll"
          style="background-color: rgba(255, 100, 100, 0.2)">
          <text class="clear-btn-text">清空</text>
        </div>
      </div>
      <div class="data-list" show="{{ dataList.length > 0 }}">
        <text class="data-title">已输入数据：</text>
        <div class="data-items">
          <text
            for="(index, item) in dataList"
            class="data-item"
            onclick="removeData(index)">
            {{ item }} ×
          </text>
        </div>
      </div>
    </list-item>
    <list-item type="card" class="content">
      <text class="section-title">统计结果</text>
      <div class="result-list" show="{{ dataList.length > 0 }}">
        <div class="result-item">
          <text class="result-label">数据个数</text>
          <marquee
            class="result-value"
            double-ended-shadow-color="#191919"
            style="width: 240px">
            {{ results.count }}
          </marquee>
        </div>
        <div class="result-item">
          <text class="result-label">求和</text>
          <marquee class="result-value" double-ended-shadow-color="#191919">
            {{ results.sum }}
          </marquee>
        </div>
        <div class="result-item">
          <text class="result-label">平均数</text>
          <marquee class="result-value" double-ended-shadow-color="#191919">
            {{ results.mean }}
          </marquee>
        </div>
        <div class="result-item">
          <text class="result-label">中位数</text>
          <marquee class="result-value" double-ended-shadow-color="#191919">
            {{ results.median }}
          </marquee>
        </div>
        <div class="result-item">
          <text class="result-label">众数</text>
          <marquee class="result-value" double-ended-shadow-color="#191919">
            {{ results.mode }}
          </marquee>
        </div>
        <div class="result-item">
          <text class="result-label">最大值</text>
          <marquee class="result-value" double-ended-shadow-color="#191919">
            {{ results.max }}
          </marquee>
        </div>
        <div class="result-item">
          <text class="result-label">最小值</text>
          <marquee class="result-value" double-ended-shadow-color="#191919">
            {{ results.min }}
          </marquee>
        </div>
        <div class="result-item">
          <text class="result-label">极差</text>
          <marquee class="result-value" double-ended-shadow-color="#191919">
            {{ results.range }}
          </marquee>
        </div>
        <div class="result-item">
          <text class="result-label">方差</text>
          <marquee class="result-value" double-ended-shadow-color="#191919">
            {{ results.variance }}
          </marquee>
        </div>
        <div class="result-item" style="margin-bottom: 50px;">
          <text class="result-label">标准差</text>
          <marquee class="result-value" double-ended-shadow-color="#191919">
            {{ results.stdDev }}
          </marquee>
        </div>
      </div>
      <div class="empty-hint" show="{{ dataList.length === 0 }}">
        <text class="empty-text">请先输入数据</text>
      </div>
    </list-item>
  </list>
</template>

<script>
  function round(num, decimals = 4) {
    const factor = Math.pow(10, decimals)
    return Math.round(num * factor) / factor
  }

  export default {
    data: {
      currentValue: '0',
      dataList: [],
      results: {
        count: 0,
        sum: 0,
        mean: 0,
        mode: '-',
        max: 0,
        min: 0,
        range: 0,
        variance: 0,
        stdDev: 0,
      },
    },

    onInit() {},

    handleInputChange(e) {
      this.currentValue = e.value
    },

    addData() {
      const value = parseFloat(this.currentValue)
      if (isNaN(value)) {
        return
      }

      this.dataList = [...this.dataList, this.currentValue]
      this.calculate()
    },

    removeData(index) {
      this.dataList.splice(index, 1)
      this.calculate()
    },

    clearAll() {
      this.dataList = []
      this.currentValue = '0'
      this.calculate()
    },

    calculate() {
      if (this.dataList.length === 0) {
        this.results = {
          count: 0,
          sum: 0,
          mean: 0,
          mode: '-',
          max: 0,
          min: 0,
          range: 0,
          variance: 0,
          stdDev: 0,
        }
        return
      }

      const data = this.dataList.map((x) => parseFloat(x)).sort((a, b) => a - b)
      const n = data.length

      const sum = data.reduce((acc, val) => acc + val, 0)
      const mean = sum / n
      const max = data[n - 1]
      const min = data[0]
      const range = max - min

      let median
      if (n % 2 === 0) {
        median = (data[n / 2 - 1] + data[n / 2]) / 2
      } else {
        median = data[Math.floor(n / 2)]
      }

      const frequency = {}
      let maxFreq = 0
      let modes = []
      data.forEach((num) => {
        frequency[num] = (frequency[num] || 0) + 1
        if (frequency[num] > maxFreq) {
          maxFreq = frequency[num]
          modes = [num]
        } else if (frequency[num] === maxFreq && !modes.includes(num)) {
          modes.push(num)
        }
      })
      const mode = modes.length === n ? '-' : modes.join(', ')

      const variance =
        data.reduce((acc, val) => acc + Math.pow(val - mean, 2), 0) / n
      const stdDev = Math.sqrt(variance)

      this.results = {
        count: n,
        sum: round(sum),
        mean: round(mean),
        median: round(median),
        mode: mode,
        max: round(max),
        min: round(min),
        range: round(range),
        variance: round(variance),
        stdDev: round(stdDev),
      }
    },
  }
</script>

<style lang="scss">

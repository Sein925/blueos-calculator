<import name="d-back" src="./../../../components/d-back"></import>
<import
  name="d-number-input"
  src="./../../../components/d-number-input"></import>

<template>
  <list class="wrapper" title="true">
    <list-item>
      <d-back value="{{ $t('statistics.title') }}"></d-back>
    </list-item>
    <list-item type="card" class="content">
      <text class="section-title">{{ $t('statistics.input') }}</text>
      <div class="input-row">
        <text class="input-label">{{ $t('statistics.data') }}</text>
        <d-number-input
          value="{{ currentValue }}"
          label="输入数据"
          placeholder="点击输入"
          @change="handleInputChange"></d-number-input>
      </div>
      <div class="btn-row">
        <div class="add-btn" onclick="addData">
          <text class="add-btn-text">{{ $t('statistics.add') }}</text>
        </div>
        <div
          class="clear-btn"
          onclick="clearAll"
          style="background-color: rgba(255, 100, 100, 0.2)">
          <text class="clear-btn-text">{{ $t('statistics.clear') }}</text>
        </div>
      </div>
      <div class="data-list" show="{{ dataList.length > 0 }}">
        <text class="data-title">{{ $t('statistics.data_list') }}</text>
        <div class="data-items">
          <text
            for="(index, item) in dataList"
            class="data-item"
            onclick="removeData(index)">
            {{ item.display }} ×
          </text>
        </div>
      </div>
    </list-item>
    <list-item type="card" class="content">
      <text class="section-title">{{ $t('statistics.result') }}</text>
      <div class="result-list" show="{{ dataList.length > 0 }}" style="margin-bottom: 50px;">
        <div class="result-item">
          <text class="result-label">{{ $t('statistics.count') }}</text>
          <marquee
            class="result-value"
            double-ended-shadow-color="#191919"
            style="width: 240px">
            {{ results.count }}
          </marquee>
        </div>
        <div class="result-item">
          <text class="result-label">{{ $t('statistics.sum') }}</text>
          <marquee class="result-value" double-ended-shadow-color="#191919">
            {{ results.sum }}
          </marquee>
        </div>
        <div class="result-item">
          <text class="result-label">{{ $t('statistics.mean') }}</text>
          <marquee class="result-value" double-ended-shadow-color="#191919">
            {{ results.mean }}
          </marquee>
        </div>
        <div class="result-item">
          <text class="result-label">{{ $t('statistics.median') }}</text>
          <marquee class="result-value" double-ended-shadow-color="#191919">
            {{ results.median }}
          </marquee>
        </div>
        <div class="result-item">
          <text class="result-label">{{ $t('statistics.mode') }}</text>
          <marquee class="result-value" double-ended-shadow-color="#191919">
            {{ results.mode }}
          </marquee>
        </div>
        <div class="result-item">
          <text class="result-label">{{ $t('statistics.max') }}</text>
          <marquee class="result-value" double-ended-shadow-color="#191919">
            {{ results.max }}
          </marquee>
        </div>
        <div class="result-item">
          <text class="result-label">{{ $t('statistics.min') }}</text>
          <marquee class="result-value" double-ended-shadow-color="#191919">
            {{ results.min }}
          </marquee>
        </div>
        <div class="result-item">
          <text class="result-label">{{ $t('statistics.range') }}</text>
          <marquee class="result-value" double-ended-shadow-color="#191919">
            {{ results.range }}
          </marquee>
        </div>
        <div class="result-item">
          <text class="result-label">{{ $t('statistics.variance') }}</text>
          <marquee class="result-value" double-ended-shadow-color="#191919">
            {{ results.variance }}
          </marquee>
        </div>
        <div class="result-item">
          <text class="result-label">{{ $t('statistics.std_dev') }}</text>
          <marquee class="result-value" double-ended-shadow-color="#191919">
            {{ results.stdDev }}
          </marquee>
        </div>
        <div class="result-item percentile-item">
          <div class="percentile-input">
            <text class="result-label" style="margin-right: 5px">P</text>
            <d-number-input
              value="{{ percentileValue }}"
              label="{{ $t('statistics.percentile') }}"
              placeholder="50"
              width="90%"
              @change="handlePercentileChange"></d-number-input>
            <text class="result-label" style="margin-left: 5px">{{ $t('statistics.percentile') }}</text>
          </div>
          <div class="percentile-result">
            <text class="result-value">{{ results.percentile }}</text>
          </div>
        </div>
      </div>
      <div class="empty-hint" show="{{ dataList.length === 0 }}">
        <text class="empty-text">{{ $t('statistics.empty') }}</text>
      </div>
    </list-item>
  </list>
</template>

<script>
  // ===== 精确分数工具（与 Equation 共用同一套）=====
  function gcd(a, b) {
    a = Math.abs(a)
    b = Math.abs(b)
    while (b !== 0) {
      const t = b
      b = a % b
      a = t
    }
    return a || 1
  }

  function makeFrac(num, den) {
    if (!den || isNaN(num) || isNaN(den)) return { num: 0, den: 1 }
    if (den < 0) {
      num = -num
      den = -den
    }
    const g = gcd(num, den)
    return { num: num / g, den: den / g }
  }

  function addF(a, b) {
    return makeFrac(a.num * b.den + b.num * a.den, a.den * b.den)
  }

  function subF(a, b) {
    return makeFrac(a.num * b.den - b.num * a.den, a.den * b.den)
  }

  function mulF(a, b) {
    return makeFrac(a.num * b.num, a.den * b.den)
  }

  function divF(a, b) {
    if (b.num === 0) return { num: 0, den: 1 }
    return makeFrac(a.num * b.den, a.den * b.num)
  }

  // 分数转显示字符串（den=1 → 整数；den<=100 → 分数；否则浮点 4 位）
  function fracToDisplay(f) {
    if (!f || f.den === 0) return '0'
    if (f.den === 1) return f.num.toString()
    if (Math.abs(f.den) <= 100 && Math.abs(f.num) <= 100000) {
      return f.num + '/' + f.den
    }
    return String(Math.round((f.num / f.den) * 10000) / 10000)
  }

  // 浮点转分数（限制 12 位精度，避免浮点垃圾）
  function floatToFrac(v) {
    if (!isFinite(v)) return { num: 0, den: 1 }
    if (Math.floor(v) === v) return { num: v, den: 1 }
    // 尝试简单浮点：1e-12 范围内
    const s = v.toFixed(12).replace(/\.?0+$/, '')
    const [intPart, decPart = ''] = s.split('.')
    if (!decPart) return { num: parseInt(intPart), den: 1 }
    const den = Math.pow(10, decPart.length)
    const num = parseInt(intPart + decPart)
    return makeFrac(num, den)
  }

  export default {
    data: {
      currentValue: '0',
      currentFrac: { num: 0, den: 1 },
      dataList: [],
      percentileValue: '50',
      percentileFrac: { num: 50, den: 1 },
      results: {
        count: 0,
        sum: '0',
        mean: '-',
        median: '-',
        mode: '-',
        max: '-',
        min: '-',
        range: '-',
        variance: '-',
        stdDev: '-',
        percentile: '-',
      },
    },

    onInit() {},

    handleInputChange(e) {
      this.currentValue = e.value
      if (e.isFraction) {
        this.currentFrac = { num: e.num, den: e.den }
      } else {
        this.currentFrac = floatToFrac(parseFloat(e.value))
      }
    },

    handlePercentileChange(e) {
      this.percentileValue = e.value
      if (e.isFraction) {
        this.percentileFrac = { num: e.num, den: e.den }
      } else {
        this.percentileFrac = floatToFrac(parseFloat(e.value))
      }
      this.calculatePercentile()
    },

    calculatePercentile() {
      if (this.dataList.length === 0) return
      const p = this.percentileFrac.num / this.percentileFrac.den
      if (p < 0 || p > 100) {
        this.results.percentile = this.$t('statistics.percentile_range')
        return
      }
      const sorted = [...this.dataList].sort(
        (a, b) => a.frac.num / a.frac.den - b.frac.num / b.frac.den
      )
      const n = sorted.length
      const pos = (p / 100) * (n - 1)
      const lower = Math.floor(pos)
      const upper = Math.min(lower + 1, n - 1)
      const frac = pos - lower
      let result
      if (lower === upper) {
        result = sorted[lower].frac
      } else {
        const lowerVal = sorted[lower].frac
        const upperVal = sorted[upper].frac
        const diff = subF(upperVal, lowerVal)
        const fracPart = mulF(diff, makeFrac(frac, 1))
        result = addF(lowerVal, fracPart)
      }
      this.results.percentile = fracToDisplay(result)
    },

    addData() {
      if (!this.currentFrac || this.currentFrac.den === 0) return
      this.dataList = [
        ...this.dataList,
        {
          display: fracToDisplay(this.currentFrac),
          frac: { num: this.currentFrac.num, den: this.currentFrac.den },
        },
      ]
      this.calculate()
    },

    removeData(index) {
      this.dataList.splice(index, 1)
      this.calculate()
    },

    clearAll() {
      this.dataList = []
      this.currentValue = '0'
      this.currentFrac = { num: 0, den: 1 }
      this.calculate()
    },

    calculate() {
      if (this.dataList.length === 0) {
        this.results = {
          count: 0,
          sum: '0',
          mean: '-',
          median: '-',
          mode: '-',
          max: '-',
          min: '-',
          range: '-',
          variance: '-',
          stdDev: '-',
        }
        return
      }

      // 排序（按分数数值升序）
      const sorted = [...this.dataList].sort(
        (a, b) => a.frac.num / a.frac.den - b.frac.num / b.frac.den
      )
      const n = sorted.length

      // 求和（Fraction 累加）
      let sum = sorted[0].frac
      for (let i = 1; i < n; i++) {
        sum = addF(sum, sorted[i].frac)
      }

      // 平均数
      const mean = divF(sum, { num: n, den: 1 })

      // 最大值 / 最小值 / 极差
      const max = sorted[n - 1]
      const min = sorted[0]
      const range = subF(max.frac, min.frac)

      // 中位数
      let median
      if (n % 2 === 0) {
        median = divF(
          addF(sorted[n / 2 - 1].frac, sorted[n / 2].frac),
          { num: 2, den: 1 }
        )
      } else {
        median = sorted[Math.floor(n / 2)].frac
      }

      // 众数（按分数值去重，显示分数形式）
      const frequency = {}
      const fracToKey = (f) => `${f.num}/${f.den}`
      let maxFreq = 0
      let modes = []
      sorted.forEach((item) => {
        const key = fracToKey(item.frac)
        frequency[key] = (frequency[key] || 0) + 1
        if (frequency[key] > maxFreq) {
          maxFreq = frequency[key]
          modes = [item.display]
        } else if (frequency[key] === maxFreq && modes.indexOf(item.display) === -1) {
          modes.push(item.display)
        }
      })
      const mode = modes.length === n ? '-' : modes.join(', ')

      // 方差 = Σ(x - mean)² / n（精确 Fraction 算）
      let varianceSum = { num: 0, den: 1 }
      for (let i = 0; i < n; i++) {
        const diff = subF(sorted[i].frac, mean)
        const diffSq = mulF(diff, diff)
        varianceSum = addF(varianceSum, diffSq)
      }
      const variance = divF(varianceSum, { num: n, den: 1 })

      // 标准差 = sqrt(方差) —— Fraction 不能精确开方，转浮点 + 4 位
      const varianceFloat = variance.num / variance.den
      const stdDev = String(Math.round(Math.sqrt(Math.abs(varianceFloat)) * 10000) / 10000)

      this.results = {
        count: n,
        sum: fracToDisplay(sum),
        mean: fracToDisplay(mean),
        median: fracToDisplay(median),
        mode: mode,
        max: max.display,
        min: min.display,
        range: fracToDisplay(range),
        variance: fracToDisplay(variance),
        stdDev: stdDev,
        percentile: '-',
      }
      this.calculatePercentile()
    },
  }
</script>

<style lang="scss">
  @import './../../../assets/styles/style.scss';

  .wrapper {
    width: 100%;
  }

  .content {
    width: 100%;
    padding: 10px 10px;
    flex-direction: column;
  }

  .section-title {
    font-size: 8 * $size-factor;
    color: $white;
    font-weight: bold;
    margin-left: 12px;

    @media (device: watch-round) {
      text-align: center;
      margin-left: 0;
    }
  }

  .input-row {
    width: 100%;
    @include flex-box-mixins(row, space-between, center);
    margin-top: 20px;
  }

  .input-label {
    font-size: 7 * $size-factor;
    color: white;
    width: 80px;
    margin: 0 2 * $size-factor;
  }

  .btn-row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 20px;
  }

  .add-btn {
    flex: 1;
    padding: 3 * $size-factor 0;
    background-color: $brand;
    margin-right: 4 * $size-factor;
    border-radius: 8 * $size-factor;
    flex-direction: row;
    justify-content: center;
    align-items: center;

    &:active {
      opacity: 0.4;
    }

    .add-btn-text {
      font-size: 8 * $size-factor;
      color: $white;
      font-weight: bold;
    }
  }

  .clear-btn {
    flex: 1;
    padding: 3 * $size-factor 0;
    border-radius: 8 * $size-factor;
    flex-direction: row;
    justify-content: center;
    align-items: center;

    &:active {
      opacity: 0.4;
    }

    .clear-btn-text {
      font-size: 8 * $size-factor;
      color: #ff6464;
      font-weight: bold;
    }
  }

  .data-list {
    width: 100%;
    flex-direction: column;
    margin-top: 30px;
    margin-left: 12px;
  }

  .data-title {
    font-size: 6.4 * $size-factor;
    color: $light-gray;
    margin-bottom: 2 * $size-factor;
  }

  .data-items {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 3 * $size-factor;
  }

  .data-item {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 4 * $size-factor;
    padding: 2 * $size-factor 3 * $size-factor;
    font-size: 5.4 * $size-factor;
    margin-right: 2 * $size-factor;
    margin-bottom: 10px;
    color: $white;

    &:active {
      opacity: 0.4;
    }
  }

  .result-list {
    width: 100%;
    flex-direction: column;
    margin-top: 10px;
  }

  .result-item {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 8 * $size-factor;
    padding: 24px 30px;
    margin-bottom: 12px;
    justify-content: space-between;
    align-items: center;
  }

  .result-label {
    font-size: 7 * $size-factor;
    color: $light-gray;
  }

  .result-value {
    font-size: 7 * $size-factor;
    color: $brand;
    font-weight: bold;
    text-align: right;
    width: 270px;
  }

  .empty-hint {
    width: 100%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 40px 0;

    .empty-text {
      font-size: 6 * $size-factor;
      color: $light-gray;
    }
  }

  .percentile-item {
    flex-direction: column;
    padding: 10px 30px;
  }

  .percentile-input {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
  }

  .percentile-result {
    width: 100%;
    display: flex;
    justify-content: flex-end;
    margin-top: 15px;
  }

  .percentile-result .result-value {
    width: 100%;
    text-align: right;
  }
</style>

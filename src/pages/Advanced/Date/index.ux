<import name="d-back" src="./../../../components/d-back"></import>
<import name="d-number-input" src="./../../../components/d-number-input"></import>

<template>
  <list class="wrapper" title="true">
    <list-item>
      <d-back value="日期计算"></d-back>
    </list-item>

    <list-item class="content">
      <text class="section-title" style="margin-top: 10px">计算类型</text>
      <div class="btn-row">
        <div
          class="btn-card"
          style="background-color: {{ currentTab === 'diff' ? 'rgba(0, 255, 153, 0.3)' : 'rgba(0, 255, 153, 0.15)' }}; margin-right: 20px;"
          onclick="switchTab('diff')">
          <text style="color: {{ currentTab === 'diff' ? '#00ff99' : '#ffffff' }};">日期差</text>
        </div>
        <div
          class="btn-card"
          style="background-color: {{ currentTab === 'add' ? 'rgba(0, 255, 153, 0.3)' : 'rgba(0, 255, 153, 0.15)' }};"
          onclick="switchTab('add')">
          <text style="color: {{ currentTab === 'add' ? '#00ff99' : '#ffffff' }};">日期推算</text>
        </div>
      </div>

      <text if="{{ currentTab === 'diff' }}" class="section-title">日期选择</text>
      <div if="{{ currentTab === 'diff' }}" class="input-card" onclick="openDatePicker('start')">
        <text class="input-label">开始日期</text>
        <text class="input-value {{ !startDateText ? 'placeholder' : '' }}">{{ startDateText || '选择日期' }}</text>
      </div>
      <div if="{{ currentTab === 'diff' }}" class="input-card" onclick="openDatePicker('end')">
        <text class="input-label">结束日期</text>
        <text class="input-value {{ !endDateText ? 'placeholder' : '' }}">{{ endDateText || '选择日期' }}</text>
      </div>
      <div if="{{ currentTab === 'diff' }}" class="calc-btn" onclick="calculateDiff">
        <text class="calc-btn-text">计算</text>
      </div>

      <text if="{{ currentTab === 'diff' && diffResult.days !== null }}" class="section-title" style="margin-top: 32px; margin-bottom: 12px;">计算结果</text>
      <div if="{{ currentTab === 'diff' && diffResult.days !== null }}" class="result-item">
        <text class="result-label">相差天数</text>
        <text class="result-value">{{ diffResult.days }} 天</text>
      </div>
      <div if="{{ currentTab === 'diff' && diffResult.days !== null }}" class="result-item">
        <text class="result-label">相差周数</text>
        <text class="result-value">{{ diffResult.weeks }} 周 {{ diffResult.remainDays }} 天</text>
      </div>
      <div if="{{ currentTab === 'diff' && diffResult.days !== null }}" class="result-item">
        <text class="result-label">相差月数</text>
        <text class="result-value">{{ diffResult.months }} 月 {{ diffResult.remainDaysAfterMonths }} 天</text>
      </div>

      <text if="{{ currentTab === 'add' }}" class="section-title">日期推算</text>
      <div if="{{ currentTab === 'add' }}" class="input-card" onclick="openDatePicker('base')">
        <text class="input-label">基准日期</text>
        <text class="input-value {{ !baseDateText ? 'placeholder' : '' }}">{{ baseDateText || '选择日期' }}</text>
      </div>
      <div if="{{ currentTab === 'add' }}" class="btn-row">
        <div
          class="btn-card opacity"
          style="background-color: {{ addType === 'add' ? 'rgba(0, 255, 153, 0.3)' : 'rgba(0, 255, 153, 0.15)' }}; margin-right: 20px;"
          onclick="setAddType('add')">
          <text style="color: {{ addType === 'add' ? '#00ff99' : '#ffffff' }};">往后</text>
        </div>
        <div
          class="btn-card opacity"
          style="background-color: {{ addType === 'sub' ? 'rgba(0, 255, 153, 0.3)' : 'rgba(0, 255, 153, 0.15)' }};"
          onclick="setAddType('sub')">
          <text style="color: {{ addType === 'sub' ? '#00ff99' : '#ffffff' }};">往前</text>
        </div>
      </div>
      <div if="{{ currentTab === 'add' }}" class="input-card">
        <text class="input-label">天数</text>
        <d-number-input
          label="输入天数"
          placeholder="点击输入"
          value="{{ addDays }}"
          onchange="onAddDaysChange"
          integer-only="true" />
      </div>
      <div if="{{ currentTab === 'add' }}" class="input-card">
        <text class="input-label">周数</text>
        <d-number-input
          label="输入周数"
          placeholder="点击输入"
          value="{{ addWeeks }}"
          onchange="onAddWeeksChange"
          integer-only="true" />
      </div>
      <div if="{{ currentTab === 'add' }}" class="input-card">
        <text class="input-label">月数</text>
        <d-number-input
          label="输入月数"
          placeholder="点击输入"
          value="{{ addMonths }}"
          onchange="onAddMonthsChange"
          integer-only="true" />
      </div>
      <div if="{{ currentTab === 'add' }}" class="calc-btn" onclick="calculateDate">
        <text class="calc-btn-text">计算</text>
      </div>

      <text if="{{ currentTab === 'add' && addResult.dateText }}" class="section-title" style="margin-top: 32px; margin-bottom: 12px;">计算结果</text>
      <div if="{{ currentTab === 'add' && addResult.dateText }}" class="result-item">
        <text class="result-label">目标日期</text>
        <text class="result-value">{{ addResult.dateText }}</text>
      </div>
      <div if="{{ currentTab === 'add' && addResult.dateText }}" class="result-item">
        <text class="result-label">星期</text>
        <text class="result-value">{{ addResult.weekDay }}</text>
      </div>
    </list-item>
  </list>
</template>

<script>
  export default {
    data: {
      currentTab: 'diff',

      startDateText: '',
      endDateText: '',
      baseDateText: '',
      pendingDateField: '',

      addType: 'add',
      addDays: '',
      addWeeks: '',
      addMonths: '',

      diffResult: {
        days: null,
        weeks: null,
        remainDays: null,
        months: null,
        remainDaysAfterMonths: null,
      },

      addResult: {
        dateText: '',
        weekDay: '',
      },
    },

    onInit() {
      this.initDates()
    },

    onShow() {
      if (global.pendingDateValue) {
        if (this.pendingDateField === 'start') {
          this.startDateText = global.pendingDateValue
        } else if (this.pendingDateField === 'end') {
          this.endDateText = global.pendingDateValue
        } else if (this.pendingDateField === 'base') {
          this.baseDateText = global.pendingDateValue
        }
        global.pendingDateValue = ''
        this.pendingDateField = ''
      }
    },

    initDates() {
      const today = new Date()
      const todayStr = this.formatDate(today)
      this.startDateText = todayStr
      this.endDateText = todayStr
      this.baseDateText = todayStr
    },

    switchTab(tab) {
      this.currentTab = tab
    },

    openDatePicker(field) {
      this.pendingDateField = field
      if (field === 'start') {
        global.pendingDateValue = this.startDateText
      } else if (field === 'end') {
        global.pendingDateValue = this.endDateText
      } else if (field === 'base') {
        global.pendingDateValue = this.baseDateText
      }
      global.router.push({
        uri: 'pages/Advanced/Date/DatePicker',
      })
    },

    formatDate(date) {
      const d = new Date(date)
      const year = d.getFullYear()
      const month = String(d.getMonth() + 1).padStart(2, '0')
      const day = String(d.getDate()).padStart(2, '0')
      return `${year}-${month}-${day}`
    },

    validateDate(dateStr) {
      const regex = /^\d{4}-\d{2}-\d{2}$/
      if (!regex.test(dateStr)) return false
      const date = new Date(dateStr)
      const [year, month, day] = dateStr.split('-').map(Number)
      return (
        date.getFullYear() === year &&
        date.getMonth() + 1 === month &&
        date.getDate() === day
      )
    },

    calculateDiff() {
      if (!this.validateDate(this.startDateText) || !this.validateDate(this.endDateText)) {
        return
      }

      const start = new Date(this.startDateText)
      const end = new Date(this.endDateText)

      const timeDiff = end.getTime() - start.getTime()
      const daysDiff = Math.abs(Math.floor(timeDiff / (1000 * 60 * 60 * 24)))

      const weeks = Math.floor(daysDiff / 7)
      const remainDays = daysDiff % 7

      const yearsDiff = end.getFullYear() - start.getFullYear()
      const monthsDiff = end.getMonth() - start.getMonth()
      const totalMonths = Math.abs(yearsDiff * 12 + monthsDiff)

      const tempDate = new Date(start)
      tempDate.setMonth(tempDate.getMonth() + totalMonths)
      const remainDaysAfterMonths = Math.abs(
        Math.floor((end.getTime() - tempDate.getTime()) / (1000 * 60 * 60 * 24))
      )

      this.diffResult = {
        days: daysDiff,
        weeks: weeks,
        remainDays: remainDays,
        months: totalMonths,
        remainDaysAfterMonths: remainDaysAfterMonths,
      }
    },

    setAddType(type) {
      this.addType = type
    },

    onAddDaysChange(evt) {
      this.addDays = evt.value
    },

    onAddWeeksChange(evt) {
      this.addWeeks = evt.value
    },

    onAddMonthsChange(evt) {
      this.addMonths = evt.value
    },

    calculateDate() {
      if (!this.validateDate(this.baseDateText)) {
        return
      }

      const base = new Date(this.baseDateText)
      const result = new Date(base)

      const days = parseInt(this.addDays) || 0
      const weeks = parseInt(this.addWeeks) || 0
      const months = parseInt(this.addMonths) || 0
      const totalDays = days + weeks * 7

      if (this.addType === 'add') {
        result.setMonth(result.getMonth() + months)
        result.setDate(result.getDate() + totalDays)
      } else {
        result.setMonth(result.getMonth() - months)
        result.setDate(result.getDate() - totalDays)
      }

      const weekDays = [
        '星期日',
        '星期一',
        '星期二',
        '星期三',
        '星期四',
        '星期五',
        '星期六',
      ]

      this.addResult = {
        dateText: this.formatDate(result),
        weekDay: weekDays[result.getDay()],
      }
    },
  }
</script>

<style lang="scss">
  @import './../../../assets/styles/style.scss';

  .wrapper {
    width: 100%;
  }

  .content {
    width: 100%;
    padding: 6px 10px 30px 10px;
    flex-direction: column;
  }

  .section-title {
    font-size: 8 * $size-factor;
    color: $white;
    font-weight: bold;
    margin-left: 12px;
    margin-top: 24px;

    @media (device: watch-round) {
      text-align: center;
      margin-left: 0;
    }
  }

  .btn-row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 20px;
    margin-bottom: 6px;
  }

  .btn-card {
    flex: 1;
    padding: 15px 0;
    border-radius: 8 * $size-factor;
    flex-direction: row;
    justify-content: center;
    background-color: rgba(0, 255, 153, 0.15);

    text {
      font-size: 8 * $size-factor;
      font-weight: 700;
    }
  }

  .opacity:active {
    opacity: 0.4;
  }

  .input-card {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 8 * $size-factor;
    padding: 24px 30px;
    margin-top: 14px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;

    &:active {
      opacity: 0.4;
    }
  }

  .input-label {
    font-size: 7 * $size-factor;
    color: $light-gray;
    margin-right: 16px;
  }

  .input-value {
    font-size: 7 * $size-factor;
    color: $brand;
    font-weight: bold;
  }

  .input-value.placeholder {
    color: rgba(255, 255, 255, 0.4);
    font-weight: normal;
  }

  .calc-btn {
    width: 100%;
    padding: 3 * $size-factor 0;
    background-color: $brand;
    border-radius: 8 * $size-factor;
    margin-top: 20px;
    flex-direction: row;
    justify-content: center;
    align-items: center;

    &:active {
      opacity: 0.4;
    }
  }

  .calc-btn-text {
    font-size: 8 * $size-factor;
    color: $white;
    font-weight: bold;
  }

  .result-item {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 8 * $size-factor;
    padding: 24px 30px;
    margin-bottom: 12px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .result-label {
    font-size: 7 * $size-factor;
    color: $light-gray;
  }

  .result-value {
    font-size: 7 * $size-factor;
    color: $brand;
    font-weight: bold;
  }
</style>
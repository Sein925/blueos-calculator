<import name="d-back" src="./../../../components/d-back"></import>

<template>
  <list class="wrapper" title="true">
    <list-item>
      <d-back value="日期计算器"></d-back>
    </list-item>
    
    <list-item class="content">
      <div class="tab-container">
        <div class="tab {{ currentTab === 'diff' ? 'active' : '' }}" onclick="switchTab('diff')">
          <text class="tab-text">日期差</text>
        </div>
        <div class="tab {{ currentTab === 'add' ? 'active' : '' }}" onclick="switchTab('add')">
          <text class="tab-text">日期推算</text>
        </div>
      </div>
    </list-item>
    
    <list-item if="{{ currentTab === 'diff' }}">
      <text class="label">开始日期: {{ startDateText }}</text>
    </list-item>
    
    <list-item if="{{ currentTab === 'diff' }}">
      <picker class="picker-full" type="date" start="1901-01-01" end="2100-12-31" selected="{{ startDateText }}" onchange="onStartDateChange"></picker>
    </list-item>
    
    <list-item if="{{ currentTab === 'diff' }}">
      <text class="label">结束日期: {{ endDateText }}</text>
    </list-item>
    
    <list-item if="{{ currentTab === 'diff' }}">
      <picker class="picker-full" type="date" start="1901-01-01" end="2100-12-31" selected="{{ endDateText }}" onchange="onEndDateChange"></picker>
    </list-item>
    
    <list-item if="{{ currentTab === 'diff' }}" class="content">
      <div class="calc-btn" onclick="calculateDiff">
        <text class="calc-btn-text">计算</text>
      </div>
    </list-item>
    
    <list-item if="{{ currentTab === 'diff' && diffResult.days !== null }}" class="content">
      <div class="result-section">
        <text class="result-title">计算结果</text>
        <div class="result-item">
          <text class="result-label">相差天数</text>
          <text class="result-value">{{ diffResult.days }} 天</text>
        </div>
        <div class="result-item">
          <text class="result-label">相差周数</text>
          <text class="result-value">{{ diffResult.weeks }} 周 {{ diffResult.remainDays }} 天</text>
        </div>
        <div class="result-item">
          <text class="result-label">相差月数</text>
          <text class="result-value">{{ diffResult.months }} 月 {{ diffResult.remainDaysAfterMonths }} 天</text>
        </div>
      </div>
    </list-item>
    
    <list-item if="{{ currentTab === 'add' }}">
      <text class="label">基准日期: {{ baseDateText }}</text>
    </list-item>
    
    <list-item if="{{ currentTab === 'add' }}">
      <picker class="picker-full" type="date" start="1901-01-01" end="2100-12-31" selected="{{ baseDateText }}" onchange="onBaseDateChange"></picker>
    </list-item>
    
    <list-item if="{{ currentTab === 'add' }}" class="content">
      <div class="add-type-row">
        <div class="add-type-btn {{ addType === 'add' ? 'active' : '' }}" onclick="setAddType('add')">
          <text class="add-type-text">往后</text>
        </div>
        <div class="add-type-btn {{ addType === 'sub' ? 'active' : '' }}" onclick="setAddType('sub')">
          <text class="add-type-text">往前</text>
        </div>
      </div>
    </list-item>
    
    <list-item if="{{ currentTab === 'add' }}" class="content">
      <div class="input-row">
        <text class="label">天数</text>
        <input class="number-input" type="number" value="{{ addDays }}" onchange="onAddDaysChange" />
      </div>
    </list-item>
    
    <list-item if="{{ currentTab === 'add' }}" class="content">
      <div class="input-row">
        <text class="label">周数</text>
        <input class="number-input" type="number" value="{{ addWeeks }}" onchange="onAddWeeksChange" />
      </div>
    </list-item>
    
    <list-item if="{{ currentTab === 'add' }}" class="content">
      <div class="input-row">
        <text class="label">月数</text>
        <input class="number-input" type="number" value="{{ addMonths }}" onchange="onAddMonthsChange" />
      </div>
    </list-item>
    
    <list-item if="{{ currentTab === 'add' }}" class="content">
      <div class="calc-btn" onclick="calculateDate">
        <text class="calc-btn-text">计算</text>
      </div>
    </list-item>
    
    <list-item if="{{ currentTab === 'add' && addResult.date }}" class="content">
      <div class="result-section">
        <text class="result-title">计算结果</text>
        <div class="result-item">
          <text class="result-label">目标日期</text>
          <text class="result-value">{{ addResult.dateText }}</text>
        </div>
        <div class="result-item">
          <text class="result-label">星期</text>
          <text class="result-value">{{ addResult.weekDay }}</text>
        </div>
      </div>
    </list-item>
  </list>
</template>

<script>
  export default {
    data: {
      currentTab: 'diff',
      
      startDateText: '',
      endDateText: '',
      baseDateText: '',
      
      addType: 'add',
      addDays: 0,
      addWeeks: 0,
      addMonths: 0,
      
      showPickerType: '',
      
      diffResult: {
        days: null,
        weeks: null,
        remainDays: null,
        months: null,
        remainDaysAfterMonths: null
      },
      
      addResult: {
        date: null,
        dateText: '',
        weekDay: ''
      }
    },

    onInit() {
      this.initDates()
    },

    initDates() {
      const today = new Date()
      const todayStr = this.formatDate(today)
      this.startDateText = todayStr
      this.endDateText = todayStr
      this.baseDateText = todayStr
    },

    switchTab(tab) {
      this.currentTab = tab
    },

    formatDate(date) {
      const d = new Date(date)
      const year = d.getFullYear()
      const month = String(d.getMonth() + 1).padStart(2, '0')
      const day = String(d.getDate()).padStart(2, '0')
      return `${year}-${month}-${day}`
    },

    onStartDateChange(evt) {
      const { year, month, day } = evt
      this.startDateText = `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`
    },

    onEndDateChange(evt) {
      const { year, month, day } = evt
      this.endDateText = `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`
    },

    onBaseDateChange(evt) {
      const { year, month, day } = evt
      this.baseDateText = `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`
    },
    
    calculateDiff() {
      const start = new Date(this.startDateText)
      const end = new Date(this.endDateText)
      
      const timeDiff = end.getTime() - start.getTime()
      const daysDiff = Math.abs(Math.floor(timeDiff / (1000 * 60 * 60 * 24)))
      
      const weeks = Math.floor(daysDiff / 7)
      const remainDays = daysDiff % 7
      
      const yearsDiff = end.getFullYear() - start.getFullYear()
      const monthsDiff = end.getMonth() - start.getMonth()
      const totalMonths = Math.abs(yearsDiff * 12 + monthsDiff)
      
      const tempDate = new Date(start)
      tempDate.setMonth(tempDate.getMonth() + totalMonths)
      const remainDaysAfterMonths = Math.abs(Math.floor((end.getTime() - tempDate.getTime()) / (1000 * 60 * 60 * 24)))
      
      this.diffResult = {
        days: daysDiff,
        weeks: weeks,
        remainDays: remainDays,
        months: totalMonths,
        remainDaysAfterMonths: remainDaysAfterMonths
      }
      
      this.showPickerType = ''
    },

    setAddType(type) {
      this.addType = type
    },

    onAddDaysChange(evt) {
      this.addDays = parseInt(evt.value) || 0
    },

    onAddWeeksChange(evt) {
      this.addWeeks = parseInt(evt.value) || 0
    },

    onAddMonthsChange(evt) {
      this.addMonths = parseInt(evt.value) || 0
    },

    calculateDate() {
      const base = new Date(this.baseDateText)
      const result = new Date(base)
      
      const totalDays = this.addDays + (this.addWeeks * 7)
      
      if (this.addType === 'add') {
        result.setMonth(result.getMonth() + this.addMonths)
        result.setDate(result.getDate() + totalDays)
      } else {
        result.setMonth(result.getMonth() - this.addMonths)
        result.setDate(result.getDate() - totalDays)
      }
      
      const weekDays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六']
      
      this.addResult = {
        date: result,
        dateText: this.formatDate(result),
        weekDay: weekDays[result.getDay()]
      }
      
      this.showPickerType = ''
    }
  }
</script>

<style lang="scss">
  @import './../../../assets/styles/style.scss';
  
  .wrapper {
    width: 100%;
    height: 100%;
  }
  
  .content {
    width: 100%;
    padding: 0 5 * $size-factor;
  }
  
  .tab-container {
    width: 100%;
    @include flex-box-mixins(row, space-between, center);
    margin-bottom: 2 * $size-factor;
  }
  
  .tab {
    flex: 1;
    padding: 3 * $size-factor 0;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 6 * $size-factor;
    margin: 0 1 * $size-factor;
    @include flex-box-mixins(row, center, center);
  }
  
  .tab.active {
    background-color: $brand;
  }
  
  .tab-text {
    font-size: 5 * $size-factor;
    color: $white;
  }
  
  .picker-full {
    width: 100%;
    height: 180px;
  }

  .label {
    font-size: 5 * $size-factor;
    color: $white;
    padding: 0 5 * $size-factor;
  }
  
  .add-type-row {
    width: 100%;
    @include flex-box-mixins(row, space-between, center);
    margin-bottom: 2 * $size-factor;
  }
  
  .add-type-btn {
    flex: 1;
    padding: 3 * $size-factor 0;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 6 * $size-factor;
    margin: 0 1 * $size-factor;
    @include flex-box-mixins(row, center, center);
  }
  
  .add-type-btn.active {
    background-color: $brand;
  }
  
  .add-type-text {
    font-size: 5 * $size-factor;
    color: $white;
  }
  
  .input-row {
    width: 100%;
    @include flex-box-mixins(row, space-between, center);
    margin-bottom: 2 * $size-factor;
  }
  
  .number-input {
    width: 40%;
    padding: 3 * $size-factor;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 6 * $size-factor;
    color: $white;
    font-size: 5 * $size-factor;
  }
  
  .calc-btn {
    width: 100%;
    padding: 4 * $size-factor 0;
    background-color: $brand;
    border-radius: 8 * $size-factor;
    margin: 2 * $size-factor 0;
    @include flex-box-mixins(row, center, center);
  }
  
  .calc-btn-text {
    font-size: 6 * $size-factor;
    font-weight: 600;
    color: $white;
  }
  
  .result-section {
    width: 100%;
    padding: 4 * $size-factor;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 8 * $size-factor;
  }
  
  .result-title {
    font-size: 6 * $size-factor;
    font-weight: 600;
    color: $white;
    margin-bottom: 3 * $size-factor;
  }
  
  .result-item {
    width: 100%;
    @include flex-box-mixins(row, space-between, center);
    padding: 2 * $size-factor 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  
  .result-item:last-child {
    border-bottom: none;
  }
  
  .result-label {
    font-size: 5 * $size-factor;
    color: $gray;
  }
  
  .result-value {
    font-size: 5 * $size-factor;
    font-weight: 600;
    color: $brand;
  }
</style>

<import name="d-back" src="./../../components/d-back"></import>

<template>
  <list class="wrapper" title="true">
    <list-item>
      <d-back value="{{ $t('settings.title') }}"></d-back>
    </list-item>
    <list-item class="content">
      <div style="flex-direction: column">
        <div class="option-card" onclick="toggleAngleMode">
          <text class="card-label">{{ $t('settings.angle_mode') }}</text>
          <text class="card-value">
            {{ angleMode === 'deg' ? $t('settings.deg') : $t('settings.rad') }}
          </text>
        </div>

        <div class="hr"></div>

        <text class="section-title">{{ $t('settings.equation') }}</text>
        <div class="option-card" onclick="toggleEquationOutputMode">
          <text class="card-label">{{ $t('settings.equation_output') }}</text>
          <text class="card-value">
            {{ equationOutputMode === 'exact' ? $t('settings.exact') : $t('settings.decimal') }}
          </text>
        </div>
        <text class="description">{{ $t('settings.equation_desc') }}</text>

        <div class="hr"></div>

        <text class="section-title">{{ $t('settings.graph') }}</text>
        <div class="option-card" onclick="toggleInputDisplayMode">
          <text class="card-label">{{ $t('settings.input_display') }}</text>
          <text class="card-value">
            {{ inputDisplayMode === 'marquee' ? $t('settings.marquee') : $t('settings.static') }}
          </text>
        </div>
        <text class="description">{{ $t('settings.graph_desc') }}</text>

        <div class="hr"></div>

        <text class="section-title">{{ $t('settings.haptic') }}</text>
        <div class="option-card">
          <text class="card-label">{{ $t('settings.vibration') }}</text>
          <switch
            class="switch"
            checked="{{ hapticEnabled }}"
            onchange="toggleHaptic"></switch>
        </div>
        <text class="description" style="margin-bottom: 30px">{{ $t('settings.haptic_desc') }}</text>
      </div>
    </list-item>
  </list>
</template>

<script>
  export default {
    data: {
      angleMode: 'deg',
      equationOutputMode: 'exact',
      inputDisplayMode: 'static',
      hapticEnabled: false,
    },

    onInit() {
      this.angleMode = global.angleMode || 'deg'
      this.equationOutputMode = global.equationOutputMode || 'exact'
      this.inputDisplayMode = global.inputDisplayMode || 'marquee'
      this.hapticEnabled = global.hapticEnabled === true
    },

    onShow() {
      this.angleMode = global.angleMode || 'deg'
      this.equationOutputMode = global.equationOutputMode || 'exact'
      this.inputDisplayMode = global.inputDisplayMode || 'marquee'
      this.hapticEnabled = global.hapticEnabled === true
    },

    toggleAngleMode() {
      this.angleMode = this.angleMode === 'deg' ? 'rad' : 'deg'
      global.angleMode = this.angleMode
      global.saveSettings()
    },

    toggleEquationOutputMode() {
      this.equationOutputMode =
        this.equationOutputMode === 'exact' ? 'decimal' : 'exact'
      global.equationOutputMode = this.equationOutputMode
      global.saveSettings()
    },

    toggleInputDisplayMode() {
      this.inputDisplayMode =
        this.inputDisplayMode === 'marquee' ? 'static' : 'marquee'
      global.inputDisplayMode = this.inputDisplayMode
      global.saveSettings()
    },

    toggleHaptic(e) {
      var checked = e && e.checked === true
      this.hapticEnabled = checked
      global.hapticEnabled = checked
      global.saveSettings()
      // 开启时立即给一次振动反馈
      if (checked) global.triggerHaptic()
    },
  }
</script>

<style lang="scss">
  @import './../../assets/styles/style.scss';

  .wrapper {
    width: 100%;
    height: 100%;
    @include flex-box-mixins(column, center, flex-start);

    .content {
      width: 100%;
      padding: 0 2 * $size-factor;
    }
  }

  .section-title {
    color: $light-gray;
    font-size: 7 * $size-factor;
    margin-top: 4 * $size-factor;
    margin-left: 4 * $size-factor;

    @media (device: watch-round) {
      width: 100%;
      margin-left: 10px;
      text-align: center;
      font-size: 40px;
    }
  }

  .description {
    color: $gray;
    font-size: 6 * $size-factor;
    margin-top: 3 * $size-factor;
    margin-left: 3 * $size-factor;
  }

  .option-card {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 8 * $size-factor;
    padding: 24px 30px;
    margin-top: 20px;
    @include flex-box-mixins(row, space-between, center);

    .card-label {
      font-size: 8 * $size-factor;
      color: $white;
    }

    .card-value {
      font-size: 7 * $size-factor;
      color: $brand;
      font-weight: bold;
    }

    &:active {
      opacity: 0.4;
    }
  }
</style>
